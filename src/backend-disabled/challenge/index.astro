---
// /challenge: the build-challenge vertical. Spec card + rules + countdown up
// top, a 60-second entry form, and an instant recency-ranked gallery — no
// "best" ranking to game, newest first, live counter. Flag-gated: 404s (and
// stays out of nav/sitemap) until CHALLENGE_LIVE is set.
import Base from '../../layouts/Base.astro';
import { challengeLive } from '../../lib/flags.js';
import { challengeEntries } from '../../lib/db.js';
import { ago } from '../../lib/builds.js';
import {
  challengeState,
  countdownParts,
  currentChallenge,
  twistRevealed,
} from '../../lib/challenge.js';

if (!challengeLive()) return new Response(null, { status: 404 });

const challenge = currentChallenge();
const state = challengeState(challenge);
const twistOut = twistRevealed(challenge);

const all = await challengeEntries(challenge.id, ['live']);
// The counter counts competitors: the host's demo entry shows but doesn't count.
const entryCount = all.filter((e) => e.kind !== 'demo').length;

// Badge clicks land here with ?e=<id>: that entry gets a highlight ring.
const q = Astro.url.searchParams;
const highlight = /^ce_[a-z2-9]{10}$/.test(q.get('e') ?? '') ? q.get('e') : null;

const PER_PAGE = 24;
const pageCount = Math.max(1, Math.ceil(all.length / PER_PAGE));
const pageNum = Math.min(pageCount, Math.max(1, parseInt(q.get('page') ?? '1', 10) || 1));
const rows = all.slice((pageNum - 1) * PER_PAGE, pageNum * PER_PAGE);

// Server-rendered countdown so the page is honest without JS; the script
// only keeps it ticking. Counts to open when upcoming, to close when open.
const target = state === 'upcoming' ? challenge.opensAt : challenge.closesAt;
const cd = countdownParts(target);
const cdLabel = state === 'upcoming' ? 'until kickoff' : state === 'open' ? 'until close' : 'closed';

const fmtUtc = (ms) =>
  new Date(ms).toLocaleString('en-US', {
    month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit',
    timeZone: 'UTC', hour12: false,
  }) + ' UTC';

const kindLabel = { seed: 'seed', demo: 'demo entry · host, not competing' };
const hostOf = (u) => {
  try {
    return new URL(u).hostname.replace(/^www\./, '');
  } catch {
    return u;
  }
};
---

<Base
  title={`${challenge.title} · vibecodeit`}
  description={`${challenge.headline} Enter with a live URL and an X handle — entries appear instantly.`}
>
  <main class="wrap ch-index">
    {/* One shared band: title and brief left, the live clock right. The
        clock is the page's pulse — big, top right, ticking seconds. */}
    <header class="ch-hero">
      <div class="ch-hero-text">
        <h1>{challenge.title}</h1>
        <p class="ch-sub">{challenge.headline}</p>
      </div>
      <div
        class="ch-clock"
        data-countdown
        data-target={String(target)}
        data-state={state}
      >
        {
          state === 'closed' ? (
            <span class="ch-clock-closed">closed</span>
          ) : (
            <span class="ch-clock-row">
              <span class="ch-cd-cell"><b class="ch-cd-num" data-cd-days>{cd.days}</b><span class="ch-cd-unit">d</span></span>
              <span class="ch-cd-cell"><b class="ch-cd-num" data-cd-hours>{cd.hours}</b><span class="ch-cd-unit">h</span></span>
              <span class="ch-cd-cell"><b class="ch-cd-num" data-cd-mins>{cd.minutes}</b><span class="ch-cd-unit">m</span></span>
              <span class="ch-cd-cell"><b class="ch-cd-num" data-cd-secs>{cd.seconds}</b><span class="ch-cd-unit">s</span></span>
            </span>
          )
        }
        <span class="ch-clock-meta">{cdLabel} · {fmtUtc(state === 'upcoming' ? challenge.opensAt : challenge.closesAt)}</span>
        <span class="ch-counter"><b data-entry-count>{entryCount}</b> {entryCount === 1 ? 'entry' : 'entries'}</span>
      </div>
    </header>

    <section class="ch-spec">
      <div class="ch-spec-card">
        <h2>the spec</h2>
        {challenge.method && <p class="ch-method">{challenge.method}</p>}
        <p class="ch-spec-note">your build must, demonstrably:</p>
        <ol class="ch-behaviors">
          {challenge.behaviors.map((b) => <li>{b}</li>)}
        </ol>
        <div class:list={['ch-twist', { out: twistOut }]}>
          {
            twistOut ? (
              <>
                <span class="ch-twist-tag">the twist · revealed</span>
                <p>{challenge.twist}</p>
              </>
            ) : (
              <>
                <span class="ch-twist-tag">the twist · sealed until kickoff</span>
                <p>{challenge.twistExplainer}</p>
              </>
            )
          }
        </div>
      </div>

      <aside class="ch-rules">
        <h2>rules</h2>
        <ol>
          {challenge.rules.map((r) => <li>{r}</li>)}
        </ol>
        {
          challenge.partner && (
            <div class="ch-partner">
              <span class="microlabel">
                {challenge.partner.kind === 'wave' ? 'wave partner' : 'sponsored by'}
              </span>
              <a href={challenge.partner.url} rel="sponsored noopener" target="_blank">
                {challenge.partner.logo && (
                  <img src={challenge.partner.logo} alt="" width="20" height="20" loading="lazy" />
                )}
                {challenge.partner.name}
              </a>
            </div>
          )
        }
      </aside>
    </section>

    {
      state === 'open' && (
        <section class="ch-enter" id="enter">
          <h2>enter · takes a minute</h2>
          <form class="ch-form" method="post" action="/api/challenge/enter" data-challenge-form>
            <label class="hp" aria-hidden="true">
              Leave this field empty
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
            <div class="ch-form-row">
              <label>
                <span>your build's live URL</span>
                <input type="url" name="url" required placeholder="https://…" maxlength="300" />
              </label>
              <label>
                <span>your X handle</span>
                <span class="ch-at-wrap">
                  <span class="ch-at" aria-hidden="true">@</span>
                  <input type="text" name="x_handle" required placeholder="you" maxlength="15" />
                </span>
              </label>
            </div>
            <label class="ch-email">
              <input type="checkbox" data-email-toggle />
              <span>email me the results + the next challenge</span>
            </label>
            <input
              class="ch-email-input"
              type="email"
              name="email"
              aria-label="email address"
              placeholder="you@wherever.dev"
              maxlength="254"
            />
            <div class="ch-form-actions">
              <button class="btn primary" type="submit">enter the challenge</button>
            </div>
            <p class="ch-form-err" data-form-err hidden></p>
          </form>
        </section>
      )
    }
    {
      state !== 'open' && (
        <section class="ch-enter">
          <h2>{state === 'upcoming' ? 'entries open at kickoff' : 'this one is closed'}</h2>
          <p class="ch-closed-note">
            {state === 'upcoming'
              ? 'get the kickoff (and the twist) in your inbox:'
              : 'results soon. get them (and the next challenge) in your inbox:'}
          </p>
          <form class="ch-wl" method="post" action="/api/waitlist" data-digest>
            <label class="hp" aria-hidden="true">
              Leave this field empty
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
            <input type="hidden" name="source" value="challenge" />
            <input type="email" name="email" required placeholder="you@wherever.dev" maxlength="254" />
            <button class="btn primary" type="submit">count me in</button>
          </form>
        </section>
      )
    }

    <section class="ch-gallery">
      <div class="list-head">
        <h2>the gallery</h2>
        <span class="note">newest first · no ranking to game</span>
      </div>
      <div class="ch-grid">
        {
          rows.map((e) => (
            <div class:list={['ch-card', { hot: e.id === highlight }]} id={e.id}>
              <a class="ch-shot" href={`/challenge/e/${e.id}`} aria-label={e.page_title ?? 'entry'}>
                {e.og_image ? (
                  <img src={e.og_image} alt="" loading="lazy" referrerpolicy="no-referrer" />
                ) : (
                  <span class="ch-shot-fallback">{hostOf(e.url)}</span>
                )}
              </a>
              <div class="ch-card-body">
                <a class="ch-title" href={`/challenge/e/${e.id}`}>{e.page_title ?? hostOf(e.url)}</a>
                <div class="ch-meta">
                  <a
                    class="ch-handle"
                    href={`https://x.com/${e.x_handle}`}
                    rel="ugc nofollow noopener"
                    target="_blank"
                  >@{e.x_handle}</a>
                  <a class="ch-visit" href={e.url} rel="ugc nofollow noopener" target="_blank">
                    {hostOf(e.url)} ↗
                  </a>
                </div>
                <div class="ch-foot">
                  {e.kind !== 'entry' && <span class="microlabel ch-kind">{kindLabel[e.kind]}</span>}
                  <span class="ch-ago">{ago(e.created_at)}</span>
                  <button class="ch-report" type="button" data-report={e.id} title="report this entry">
                    report
                  </button>
                </div>
              </div>
            </div>
          ))
        }
        {
          rows.length === 0 && (
            <p class="ch-empty">
              {state === 'open'
                ? 'nothing here yet. yours could be first ↑'
                : 'the gallery fills the moment entries open.'}
            </p>
          )
        }
      </div>
      {
        pageCount > 1 && (
          <nav class="ch-pages" aria-label="Pages">
            {pageNum > 1 && <a class="chip" href={`/challenge?page=${pageNum - 1}`}>← newer</a>}
            <span>page {pageNum} of {pageCount}</span>
            {pageNum < pageCount && <a class="chip" href={`/challenge?page=${pageNum + 1}`}>older →</a>}
          </nav>
        )
      }
    </section>

    <p class="ch-honesty">every entry here is what its maker told us.</p>
  </main>
</Base>

<script is:inline src={`/js/challenge.js?v=${__BUILD_ID__}`} defer></script>

<style>
  .ch-index {
    padding-top: 48px;
    /* Room for the fixed digest bar (and the mobile sponsor tape below it):
       without this, bottom-edge report buttons sit under the bar and the
       click lands on the newsletter form instead. */
    padding-bottom: 120px;
  }

  @media (max-width: 760px) {
    .ch-index {
      padding-bottom: 170px;
    }
  }

  /* Title left, clock right — one band, no container. */
  .ch-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px 48px;
    align-items: start;
  }

  @media (max-width: 760px) {
    .ch-hero {
      grid-template-columns: 1fr;
    }
  }

  .ch-index h1 {
    font-size: clamp(32px, 5vw, 44px);
  }

  .ch-sub {
    padding-top: 12px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 52ch;
    text-wrap: pretty;
  }

  .ch-clock {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    padding-top: 8px;
  }

  @media (max-width: 760px) {
    .ch-clock {
      align-items: flex-start;
      padding-top: 0;
    }
  }

  /* The clock is the biggest thing on the page — it carries the hierarchy. */
  .ch-clock-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .ch-cd-cell {
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
  }

  .ch-cd-num {
    font-size: clamp(40px, 5vw, 58px);
    font-weight: 700;
    color: var(--primary);
    /* tabular figures + a fixed two-digit cell: 10 → 9 never shifts the row. */
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
    min-width: 2ch;
    text-align: right;
    line-height: 1;
  }

  /* Units demoted to tiny uppercase so the numerals carry it. */
  .ch-cd-unit {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .ch-clock-closed {
    font: 700 clamp(40px, 5vw, 58px) var(--font-mono);
    color: var(--muted);
    line-height: 1;
  }

  /* Meta is the smallest, quietest layer — dates + label read only on a
     second look. --faint falls back to --muted where the token isn't set. */
  .ch-clock-meta {
    font: 11px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--faint, var(--muted));
    opacity: 0.85;
  }

  .ch-counter {
    font-size: 12px;
    color: var(--faint, var(--muted));
    opacity: 0.85;
  }

  .ch-counter b {
    display: inline-block;
    font-size: 14px;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }

  /* Movement only, per the interactivity rules: the pulse is a transform on
     a value change, never a hover decoration. */
  .ch-counter b.tick {
    animation: ch-tick 0.45s ease-out;
  }

  @keyframes ch-tick {
    0% { transform: scale(1); }
    35% { transform: scale(1.18); }
    100% { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ch-counter b.tick {
      animation: none;
    }
  }

  .ch-counter span {
    font-size: 13px;
    color: var(--muted);
  }

  /* Open composition, no card chrome: the two columns are separated by
     whitespace and their headings, not boxes. The twist keeps its border
     because a sealed box SHOULD look like one. */
  .ch-spec {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: 20px 56px;
    padding-top: 40px;
  }

  @media (max-width: 760px) {
    .ch-spec {
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }

  .ch-spec h2,
  .ch-rules h2 {
    font-size: 15px;
    text-transform: lowercase;
  }

  .ch-method {
    margin-top: 12px;
    padding: 2px 0 2px 14px;
    border-left: 3px solid var(--primary);
    font-size: 14px;
    line-height: 1.55;
  }

  .ch-spec-note {
    padding-top: 10px;
    font-size: 13px;
    color: var(--muted);
  }

  .ch-behaviors {
    padding-top: 10px;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    line-height: 1.5;
  }

  .ch-behaviors li::marker {
    color: var(--primary);
    font-family: var(--font-mono);
  }

  .ch-twist {
    margin-top: 18px;
    padding: 14px 16px;
    border: 1px dashed var(--border);
    border-radius: 6px;
  }

  .ch-twist.out {
    border-style: solid;
    border-color: var(--primary);
  }

  .ch-twist-tag {
    font: 700 11px var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .ch-twist p {
    padding-top: 8px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--muted);
  }

  .ch-twist.out p {
    color: var(--fg);
  }

  .ch-rules ol {
    padding-top: 12px;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--fg);
  }

  .ch-rules li::marker {
    color: var(--muted);
    font-family: var(--font-mono);
  }

  .ch-partner {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ch-partner a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--primary);
  }

  .ch-partner img {
    border-radius: 4px;
  }

  .ch-enter {
    margin-top: 44px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .ch-enter h2 {
    font-size: 15px;
  }

  .ch-form {
    padding-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ch-form-row {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 12px;
  }

  @media (max-width: 640px) {
    .ch-form-row {
      grid-template-columns: 1fr;
    }
  }

  /* First child only: the caption. The @-prefix wrap is also a span inside
     the label and must keep its flex layout. */
  .ch-form label > span:first-child {
    display: block;
    padding-bottom: 6px;
    font: 12px var(--font-mono);
    color: var(--muted);
  }

  .ch-form input[type='url'],
  .ch-form .ch-email-input {
    width: 100%;
    padding: 10px 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--fg);
    font: 14px var(--font-mono);
  }

  /* The @ is furniture, not something you type: fixed prefix inside the
     field, input itself borderless so the pair reads as one control. */
  .ch-at-wrap {
    display: flex;
    align-items: center;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  .ch-at-wrap:focus-within {
    outline: 2px solid var(--primary);
    outline-offset: -1px;
  }

  .ch-at {
    padding: 10px 0 10px 12px;
    font: 700 14px var(--font-mono);
    color: var(--muted);
    user-select: none;
  }

  .ch-at-wrap input {
    flex: 1;
    min-width: 0;
    padding: 10px 12px 10px 4px;
    background: none;
    border: none;
    outline: none;
    color: var(--fg);
    font: 14px var(--font-mono);
  }

  /* Sub-16px inputs make iOS zoom the page on focus: mobile gets 16px,
     desktop keeps the site's 14px mono. */
  @media (max-width: 640px) {
    .ch-form input[type='url'],
    .ch-form .ch-email-input,
    .ch-at-wrap input {
      font-size: 16px;
    }

    .ch-at {
      font-size: 16px;
    }
  }

  .ch-email {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
    cursor: pointer;
  }

  /* CSS state, not JS: the email field exists only while the box is checked. */
  .ch-email-input {
    display: none;
  }

  .ch-email:has(input:checked) + .ch-email-input {
    display: block;
  }

  .ch-form-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .ch-form-err {
    font-size: 13px;
    color: var(--no-bg);
  }

  .ch-closed-note {
    padding-top: 10px;
    font-size: 14px;
    color: var(--muted);
  }

  .ch-wl {
    display: flex;
    gap: 10px;
    padding-top: 14px;
    flex-wrap: wrap;
  }

  .ch-wl input[type='email'] {
    flex: 1;
    min-width: 220px;
    padding: 10px 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--fg);
    font: 14px var(--font-mono);
  }

  .ch-gallery {
    padding-top: 36px;
  }

  /* Narrow screens: the heading and its note stack instead of colliding. */
  @media (max-width: 480px) {
    .ch-gallery :global(.list-head) {
      flex-wrap: wrap;
      row-gap: 2px;
    }
  }

  .ch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
    padding-top: 16px;
  }

  .ch-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .ch-card.hot {
    border-color: var(--primary);
    box-shadow: 0 0 0 1px var(--primary);
  }

  .ch-shot {
    display: block;
    aspect-ratio: 1200 / 630;
    background: var(--bg);
    overflow: hidden;
  }

  .ch-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ch-shot-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    font: 700 15px var(--font-mono);
    color: var(--primary);
    overflow-wrap: anywhere;
    padding: 0 14px;
    text-align: center;
  }

  .ch-card-body {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 12px 14px 12px;
  }

  .ch-title {
    font-weight: 600;
    font-size: 14px;
    line-height: 1.4;
    color: var(--fg);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ch-title:hover {
    color: var(--primary);
  }

  .ch-meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 12.5px;
  }

  .ch-handle {
    color: var(--primary);
    font-family: var(--font-mono);
  }

  .ch-visit {
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .ch-visit:hover {
    color: var(--fg);
  }

  .ch-foot {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 10px;
    font-size: 11.5px;
    color: var(--muted);
  }

  /* The long demo/seed label takes its own line instead of crushing the
     timestamp and report button into slivers. */
  .ch-kind {
    flex-basis: 100%;
    color: var(--kinda, #d7b944);
  }

  .ch-ago {
    margin-left: auto;
    white-space: nowrap;
  }

  .ch-report {
    white-space: nowrap;
  }

  .ch-report {
    background: none;
    border: none;
    padding: 0;
    font: 11.5px var(--font-mono);
    color: var(--muted);
    opacity: 0.6;
    cursor: pointer;
  }

  .ch-report:hover {
    opacity: 1;
    color: var(--no-bg);
  }

  .ch-report[disabled] {
    opacity: 0.5;
    cursor: default;
  }

  .ch-empty {
    grid-column: 1 / -1;
    padding: 28px 0;
    font-size: 14px;
    color: var(--muted);
  }

  .ch-pages {
    display: flex;
    align-items: center;
