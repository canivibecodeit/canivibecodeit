---
// A challenge entry's permalink: the shareable page. Carries a generated OG
// card (satori, runtime) so a pasted link unfurls properly, links out to the
// build and the maker, and hands the entrant their badge embed snippet.
// Held/unlisted entries 404 — a permalink never outs a moderation decision.
import Base from '../../../layouts/Base.astro';
import { challengeLive } from '../../../lib/flags.js';
import { challengeEntryById } from '../../../lib/db.js';
import { ago } from '../../../lib/builds.js';
import { CHALLENGES, ENTRY_ID_RE } from '../../../lib/challenge.js';

if (!challengeLive()) return new Response(null, { status: 404 });

const id = Astro.params.id ?? '';
if (!ENTRY_ID_RE.test(id)) return new Response(null, { status: 404 });

const entry = await challengeEntryById(id);
if (!entry || entry.status !== 'live') return new Response(null, { status: 404 });

const challenge = CHALLENGES.find((c) => c.id === entry.challenge_id) ?? CHALLENGES[0];
const title = entry.page_title ?? entry.url;
const hostOf = (u) => {
  try {
    return new URL(u).hostname.replace(/^www\./, '');
  } catch {
    return u;
  }
};

const embed = `<script src="https://vibecodeit.com/challenge/badge.js" data-entry="${entry.id}" defer><\/script>`;
---

<Base
  title={`${title} · ${challenge.title} · vibecodeit`}
  socialTitle={`${title} — vibecoded by @${entry.x_handle}`}
  description={`An entry in ${challenge.title} on vibecodeit — built during the window by @${entry.x_handle}.`}
  ogImage={`/api/challenge/og/${entry.id}.png`}
>
  <main class="wrap ce-page">
    <p class="ce-crumb">
      <a href="/challenge">← {challenge.title.toLowerCase()}</a>
    </p>

    <h1>{title}</h1>
    <p class="ce-sub">
      vibecoded by{' '}
      <a href={`https://x.com/${entry.x_handle}`} rel="ugc nofollow noopener" target="_blank">@{entry.x_handle}</a>
      <span class="ce-unverified" title="Handle as submitted — ownership is not verified">unverified</span>
      · {ago(entry.created_at)}
      {entry.kind === 'demo' && <span class="microlabel ce-kind">demo entry · host, not competing</span>}
      {entry.kind === 'seed' && <span class="microlabel ce-kind">seed</span>}
    </p>

    <a class="ce-visit btn primary" href={entry.url} rel="ugc nofollow noopener" target="_blank">
      open the build · {hostOf(entry.url)} ↗
    </a>

    {
      entry.og_image && (
        <a class="ce-shot" href={entry.url} rel="ugc nofollow noopener" target="_blank">
          <img src={entry.og_image} alt={`Preview of ${title}`} loading="lazy" referrerpolicy="no-referrer" />
        </a>
      )
    }

    <section class="ce-badge">
      <h2>wear the badge</h2>
      <div class="ce-embed">
        <code data-embed>{embed}</code>
        <button class="btn ghost" type="button" data-copy-embed>copy</button>
      </div>
      {entry.badge_hits > 0 && (
        <p class="ce-hits">seen <b>{entry.badge_hits}</b> {entry.badge_hits === 1 ? 'time' : 'times'} in the wild.</p>
      )}
    </section>

    <p class="ce-honesty">
      what its maker told us ·
      <button class="ce-report" type="button" data-report={entry.id}>report this entry</button>
    </p>
  </main>
</Base>

<script is:inline src={`/js/challenge.js?v=${__BUILD_ID__}`} defer></script>

<style>
  .ce-page {
    padding-top: 48px;
    max-width: 760px;
  }

  .ce-crumb {
    font-size: 13px;
  }

  .ce-crumb a {
    color: var(--muted);
  }

  .ce-crumb a:hover {
    color: var(--primary);
  }

  .ce-page h1 {
    padding-top: 14px;
    font-size: clamp(26px, 4.5vw, 38px);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .ce-sub {
    padding-top: 10px;
    font-size: 14px;
    color: var(--muted);
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ce-sub a {
    color: var(--primary);
    font-family: var(--font-mono);
  }

  .ce-kind {
    color: var(--kinda, #d7b944);
  }

  .ce-unverified {
    font: 11px var(--font-mono);
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1px 5px;
  }

  .ce-visit {
    margin-top: 20px;
    display: inline-block;
  }

  .ce-shot {
    display: block;
    margin-top: 22px;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .ce-shot img {
    width: 100%;
    display: block;
  }

  .ce-badge {
    margin-top: 34px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }

  .ce-badge h2 {
    font-size: 15px;
  }

  .ce-badge p {
    padding-top: 8px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--muted);
  }

  .ce-embed {
    display: flex;
    align-items: stretch;
    gap: 10px;
    margin-top: 12px;
  }

  .ce-embed code {
    flex: 1;
    min-width: 0;
    padding: 10px 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    font: 12px var(--font-mono);
    overflow-x: auto;
    white-space: nowrap;
  }

  .ce-hits {
    padding-top: 10px;
  }

  .ce-hits b {
    color: var(--primary);
  }

  .ce-honesty {
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted);
  }

  .ce-report {
    background: none;
    border: none;
    padding: 0;
    font: 12px var(--font-mono);
    color: var(--muted);
    text-decoration: underline;
    cursor: pointer;
  }

  .ce-report:hover {
    color: var(--no-bg);
  }
</style>
