---
// The newsletter's front door: what sunday's email is, one form, no tricks.
// Signups post to /api/waitlist like every other placement (source=newsletter);
// the form is wired by app.js's shared form[data-digest] handler.
import Base from '../layouts/Base.astro';
import { VERDICTS } from '../lib/apps.js';

// Same build-time feed DigestCard uses: chips prove the cadence is real.
const generated = import.meta.glob('../generated/recent*.json', { eager: true, import: 'default' });
const recent = Object.values(generated)[0] ?? [];
const known = recent.filter((r) => Object.hasOwn(VERDICTS, r.verdict));
const chips = known.slice(0, 4);
const more = known.length - chips.length;
---

<Base
  title="The newsletter · vibecodeit"
  description="A new guide to technology every Sunday, with the prompts and receipts behind it, plus which subscriptions died. Free, unsubscribe in one click, and you can submit your own guide to be published."
  ogImage="/og/newsletter.png"
>
  <main class="wrap nl-wrap">
    <span class="microlabel">the newsletter</span>
    <h1>A new guide, every sunday. With receipts.</h1>
    <p class="nl-sub">
      Every sunday: one guide to technology worth the read, the exact prompts and receipts
      behind it, and which verdicts flipped since last week. Written from what actually
      happened on the death list, not from vibes about vibes.
    </p>
    <p class="nl-sub">
      Written something worth publishing? <a href="/write">Send us the draft</a> and it goes out
      with your byline. Same bar as everything else here · real, tested, and honest about what
      does not work.
    </p>

    <form method="post" action="/api/waitlist" data-digest class="nl-form">
      <label class="hp" aria-hidden="true">
        Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
      <input type="hidden" name="source" value="newsletter" />
      <input
        type="email"
        name="email"
        required
        placeholder="you@wherever.com"
        aria-label="Email address"
      />
      <button class="btn primary" type="submit">get sunday's</button>
    </form>
    <p class="nl-fine">free forever · one email a week · unsubscribe in one click</p>

    <section class="nl-inside">
      <span class="microlabel">in every issue</span>
      <ul>
        <li><i>$</i>one guide to technology, start to finish, with the prompts behind it</li>
        <li><i>$</i>new verdicts, and the flips: what just became one-shottable</li>
        <li><i>$</i>the week's most-doomed apps, by community vote</li>
        <li><i>$</i>a reader's guide when one lands, published with their byline</li>
      </ul>
    </section>

    {
      chips.length > 0 && (
        <section class="nl-recent">
          <span class="microlabel">last week on the list:</span>
          <div class="chip-row">
            {chips.map((c) => (
              <span class={`verdict-chip ${c.verdict}`}>
                <i />
                {c.name} · {VERDICTS[c.verdict].label}
              </span>
            ))}
            {more > 0 && <span class="more">+{more} more</span>}
          </div>
        </section>
      )
    }
  </main>
</Base>

<style>
  .nl-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding-top: 56px;
    padding-bottom: 72px;
  }

  h1 {
    font-size: clamp(28px, 5vw, 40px);
    letter-spacing: -0.02em;
    line-height: 1.15;
    padding-top: 14px;
  }

  .nl-sub {
    padding-top: 16px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 62ch;
  }

  .nl-form {
    display: flex;
    gap: 10px;
    margin-top: 28px;
    width: min(480px, 100%);
  }

  .nl-form input[type='email'] {
    flex: 1;
    min-width: 0;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 12px 16px;
    color: var(--fg);
    font: inherit;
    font-size: 13.5px;
    transition: border-color 0.15s ease;
  }

  .nl-form input[type='email']:focus {
    outline: none;
    border-color: var(--primary);
  }

  .nl-form .btn.primary {
    white-space: nowrap;
  }

  .nl-fine {
    padding-top: 10px;
    font: 11.5px/1.6 var(--font-mono);
    color: var(--muted);
  }

  .nl-inside {
    padding-top: 44px;
  }

  .nl-inside ul {
    list-style: none;
    padding-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .nl-inside li {
    font: 13px/1.6 var(--font-mono);
    color: var(--fg);
  }

  .nl-inside li i {
    color: var(--primary);
    font-style: normal;
    padding-right: 10px;
  }

  .nl-recent {
    padding-top: 40px;
  }

  .nl-recent .chip-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding-top: 14px;
  }

  .nl-recent .more {
    font: 12px var(--font-mono);
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .nl-form {
      flex-direction: column;
    }

    /* iOS zooms into any focused input with font-size below 16px */
    .nl-form input[type='email'] {
      font-size: 16px;
    }
  }
</style>
