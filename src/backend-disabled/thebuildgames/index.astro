---
// The Build Games — the public sponsor/hype surface. Flag-gated: 404s until
// BUILDGAMES_LIVE is set, so it merges dark and goes live the moment the
// launch video posts. Phase A renders seed data; Phase B swaps in the DB.
import Base from '../../layouts/Base.astro';
import BuildGamesLogo from '../../components/BuildGamesLogo.astro';
import BuildGamesNewsletter from '../../components/BuildGamesNewsletter.astro';
import { buildGamesLive } from '../../lib/flags.js';
import { bgEntryCount, bgLeaderboard, bgPotCents } from '../../lib/db.js';
import {
  ANNOUNCE_BY,
  BLURB_MAX,
  CATEGORIES,
  JUDGES,
  JUDGES_NOTE,
  MAX_BID_CENTS,
  MIN_ENTRY_CENTS,
  MIN_TOPUP_CENTS,
  MONEY_SENTENCE,
  NAME_MAX,
  TAGLINE_MAX,
  THEME_ONE_LINER,
  THEME_SUB,
  biddingOpen,
  countdownParts,
  displayName,
  entriesOpen,
  fillLevel,
  gamesEndAt,
  gamesStartAt,
  gamesStarted,
  monogram,
  rankSponsors,
  timeAgo,
  usd,
} from '../../lib/buildgames.js';
import { dashboardStats } from '../../lib/analytics.js';
import { faviconUrl, withUtm } from '../../lib/sponsors.js';
import { onlineCount } from '../../lib/presence.js';

if (!buildGamesLive()) return new Response(null, { status: 404 });

/* THE MIDNIGHT FLIP. Before the start moment this page is the sponsor hype
   surface (countdown, claim bar first). From the moment BUILDGAMES_START_AT
   passes it becomes the game surface: hackathon clarity block, the entry
   form front and centre, categories, judges, then sponsors as a podium with
   bidding demoted to secondary. Server-side time check per request — no
   cron, no manual flip; the client countdown reloads open tabs at zero. */
const started = gamesStarted();
const canEnter = entriesOpen();

// Live board + pot from the DB (+ the entry counter once the games run).
const [potCents, board, entryCount] = await Promise.all([
  bgPotCents(),
  bgLeaderboard(),
  started ? bgEntryCount().catch(() => 0) : 0,
]);
const ranked = rankSponsors(board);
const fill = fillLevel(potCents); // 0..MAX_FILL, uncapped/asymptotic
const bidsOpen = biddingOpen();

// In game phase the top 3 sponsors render as a podium; the list starts at #4.
const podium = started ? ranked.slice(0, 3) : [];
const listBase = started ? Math.min(3, ranked.length) : 0;
const listRanked = ranked.slice(listBase);

// Pre-game: proper pagination past 50 sponsors (?page=N), rank numbering
// continuous across pages so #51 is #51, not a fresh #1. Game phase: simple
// continuous rows below the podium (operator punch list — volume is modest,
// pagination is a pre-game concern).
const PAGE_SIZE = 50;
const totalPages = started ? 1 : Math.max(1, Math.ceil(listRanked.length / PAGE_SIZE));
const page = Math.min(totalPages, Math.max(1, Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1));
const pageRows = started ? listRanked : listRanked.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const rankOf = (i) => listBase + (page - 1) * PAGE_SIZE + i + 1;

// Newsletter placement (Faizan's rule): 6+ rows on page 1 -> inline between row
// #5 and #6; otherwise directly below the sponsors section. Repeated at the
// bottom of the page either way. Page 1 only, no pagination-aware logic.
const nlInline = page === 1 && pageRows.length >= 6;

// Cable is a live toggle so Faizan can compare with/without: ?cable=off hides it.
const cableOn = (Astro.url.searchParams.get('cable') ?? 'on') !== 'off';

// The clock counts to the start until the flip, then to the window close.
const startAt = gamesStartAt();
const endAt = gamesEndAt();
const cdTarget = started ? endAt : startAt;
const cd = countdownParts(cdTarget);

/* The game-ends clock: zero-padded two-digit segments in fixed-width cells
   so a tick never reflows anything, and no seconds until the final 24 hours
   (a month-long clock ticking seconds reads anxious; the endgame earns it).
   The client tick mirrors both rules via data-cd-pad / [data-cd-sec-cell]. */
const pad2 = (n) => String(n).padStart(2, '0');
const showSeconds = cdTarget - Date.now() < 24 * 60 * 60 * 1000;

// Social proof for buyers: live presence (own in-process counter) + the real
// all-time PostHog totals (2-min stale-safe cache; null hides the stat rather
// than showing a made-up number).
const online = onlineCount();
let allTime = null;
let weekVisitors = null;
try {
  const stats = await dashboardStats();
  allTime = stats?.allTime ?? null;
  weekVisitors = stats?.tiles?.visitors7d ?? null;
} catch {
  /* strip renders without the totals */
}
const compact = (n) =>
  n >= 1_000_000 ? `${(n / 1_000_000).toFixed(1).replace(/\.0$/, '')}M` : n >= 1000 ? `${Math.round(n / 1000)}k` : String(n);

// Floors render from the same config the API enforces — an env change moves
// the copy, the input bounds and the validation together. The form's min is
// the LOWER floor (a top-up can be less than an entry); the API applies the
// exact one once it knows which this is.
const minEntryUsd = Math.ceil(MIN_ENTRY_CENTS / 100);
const minFormUsd = Math.ceil(Math.min(MIN_ENTRY_CENTS, MIN_TOPUP_CENTS) / 100);
const maxUsd = Math.floor(MAX_BID_CENTS / 100);

/* Top claim bar. Picking a spot prices itself off the LIVE board: to hold
   spot N your cumulative total has to sit above whoever holds it now, so the
   ask is that sponsor's cleared total plus one increment, floored at the entry
   minimum the API enforces for a link's first appearance. Spots past the end
   of the board are unclaimed, so they cost exactly that minimum. This is a
   CALCULATOR, never a promise — the server re-derives every floor, and the
   board re-ranks on cleared totals, so a spot can move between here and
   checkout. The copy under the bar says so. */
const CLAIM_STEP_CENTS = MIN_TOPUP_CENTS;
const claimTotals = ranked.slice(0, 100).map((r) => r.cleared_total);
const claimCost = (rank) => {
  const heldBy = claimTotals[rank - 1];
  return heldBy == null ? MIN_ENTRY_CENTS : Math.max(MIN_ENTRY_CENTS, heldBy + CLAIM_STEP_CENTS);
};
// The first unclaimed spot is the cheapest honest ask; below it every spot is
// someone else's to beat.
const openRank = claimTotals.length + 1;

const hostOf = (u) => {
  try {
    return new URL(u).hostname.replace(/^www\./, '');
  } catch {
    return null;
  }
};
---

<Base
  title="The Build Games · vibecodeit"
  description={
    started
      ? `A month-long vibecoding hackathon. Free to enter. ${MONEY_SENTENCE}`
      : `Sponsors bid for the top spot. ${MONEY_SENTENCE} The games begin September 1.`
  }
  ogImage="/og-buildgames.png"
  hideSponsors={true}
  hideDigest={true}
>
  <main class:list={['wrap', 'bg-wrap', { 'bg-game': started }]}>
    <!-- Logo lockup: the ○△□ mark above the wordmark (V5) -->
    <header class="bg-hero">
      <!-- The proof a placement is worth $500 — above everything else -->
      <p class="bg-stats" aria-label="Site traffic">
        <span class="bg-stat bg-stat-live"><span class="bg-live-dot" aria-hidden="true"></span><b data-bg-online>{online}</b> online now</span>
        {weekVisitors ? <span class="bg-stat"><b>{compact(weekVisitors)}</b> visitors this week</span> : null}
        {allTime?.visitors ? <span class="bg-stat"><b>{compact(allTime.visitors)}</b> visitors all-time</span> : null}
        <a class="bg-stat bg-stat-link" href="/stats">see stats →</a>
      </p>
      <p class="bg-eyebrow">vibecodeit presents</p>
      <BuildGamesLogo class="bg-logo" />
      {started ? (
        <>
          {/* Tight hero (design round 3): lockup → theme → idea pill, no
              prose. The money story lives in the framed card below the
              entry form; the caption under the stat strip carries the three
              trust facts. */}
          <p class="bg-theme">{THEME_ONE_LINER}</p>
          <a class="bg-theme-pill" href="/">{THEME_SUB}</a>
        </>
      ) : (
        <>
          <p class="bg-tagline">
            Sponsors bid for the top spot. {MONEY_SENTENCE}
          </p>
          {/* The builder path, front and centre: sponsors get the claim bar
              below, builders get an unmissable button here instead of a
              footer link. */}
          <a class="bg-builders-cta" href="/thebuildgames/builders">
            building? how it works <span aria-hidden="true">→</span>
          </a>
        </>
      )}
    </header>

    {/* THE ORB: pre-game only (operator, design round 2) — in game phase
        the stat strip carries the pool number and the orb is gone. */}
    {!started && (
    <section class="bg-pot" aria-label="Sponsorship pool">
      <div class:list={['bg-orb-stage', { 'no-cable': !cableOn }]} data-pot data-fill={fill.toFixed(4)} data-pot-cents={potCents}>
        <svg class="bg-orb" viewBox="0 108 300 292" role="img" aria-label={`Sponsorship pool ${usd(potCents)}`}>
          <defs>
            <clipPath id="bg-orb-clip">
              <circle cx="150" cy="270" r="118" />
            </clipPath>
            {/* Subtle cash gradient: premium, not photorealistic bills. */}
            <linearGradient id="bg-cash" x1="0" y1="1" x2="0" y2="0">
              <stop offset="0%" stop-color="var(--primary-dim)" />
              <stop offset="55%" stop-color="var(--primary)" />
              <stop offset="100%" stop-color="var(--primary)" />
            </linearGradient>
            {/* a faint stacked-note hint: one soft line every 22px, low contrast */}
            <pattern id="bg-bills" width="300" height="22" patternUnits="userSpaceOnUse" patternTransform="rotate(-3)">
              <rect width="300" height="22" fill="url(#bg-cash)" />
              <rect y="21" width="300" height="1" fill="rgba(0,0,0,0.10)" />
            </pattern>
            <radialGradient id="bg-glass-grad" cx="0.38" cy="0.30" r="0.8">
              <stop offset="0%" stop-color="rgba(255,255,255,0.10)" />
              <stop offset="55%" stop-color="rgba(255,255,255,0.02)" />
              <stop offset="100%" stop-color="rgba(255,255,255,0)" />
            </radialGradient>
          </defs>

          {/* ceiling cable + hook (fixed) — toggled off via ?cable=off */}
          {cableOn && (
            <g class="bg-cable-group">
              <line x1="150" y1="108" x2="150" y2="120" class="bg-cable" />
              <path d="M150 120 q -11 9 0 20 q 11 11 0 20" class="bg-hook" />
            </g>
          )}

          {/* the swinging orb: everything below the cable sways as one */}
          <g class="bg-orb-swing">
            {/* money fill, clipped to the sphere, scaled from the bottom */}
            <g clip-path="url(#bg-orb-clip)">
              <rect class="bg-fill" x="32" y="152" width="236" height="236" fill="url(#bg-bills)" />
              <rect class="bg-fill-top" x="32" width="236" height="2" fill="var(--primary)" />
              <g class="bg-drops" aria-hidden="true"></g>
            </g>
            {/* glass sphere: body tint, reflection, rim */}
            <circle cx="150" cy="270" r="118" fill="url(#bg-glass-grad)" class="bg-glass" />
            <ellipse cx="112" cy="222" rx="44" ry="28" class="bg-glass-shine" />
            <circle cx="150" cy="270" r="118" class="bg-glass-rim" />
          </g>
        </svg>
      </div>

      {/* RULE 2 naming: this gross number is the SPONSORSHIP POOL; the prize
          fund (what winners split) is defined by the canonical sentence. */}
      <div class="bg-pot-readout">
        <span class="bg-pot-label">sponsorship pool · funded by sponsor bids</span>
        <span class="bg-pot-amount" data-pot-amount>{usd(potCents)}</span>
      </div>
    </section>
    )}

    {/* Game phase: the headline stat strip — pool, clock, entries as one row
        of big numerals styled on the pot treatment. It carries the countdown
        data attrs (client tick + reload-at-zero work unchanged) and the pot
        poll updates [data-pot-amount] here. Pre-game keeps the countdown. */}
    {started ? (
      <section class="bg-statgrid" data-countdown data-cd-pad data-target={String(cdTarget)} aria-label="Sponsorship pool, time remaining and entries">
        <div class="bg-sg-cell">
          <span class="bg-sg-label">sponsorship pool</span>
          <span class="bg-sg-num bg-sg-money" data-pot-amount data-pot-cents={potCents}>{usd(potCents)}</span>
          <span class="bg-sg-sub">funded by sponsor bids</span>
        </div>
        <div class="bg-sg-cell">
          <span class="bg-sg-label">the game ends in</span>
          <span class="bg-sg-num bg-sg-cd">
            <b data-cd-days>{pad2(cd.days)}</b><i>d</i>
            <b data-cd-hours>{pad2(cd.hours)}</b><i>h</i>
            <b data-cd-mins>{pad2(cd.minutes)}</b><i>m</i>
            <span class="bg-sg-sec" data-cd-sec-cell hidden={!showSeconds}><b data-cd-secs>{pad2(cd.seconds)}</b><i>s</i></span>
          </span>
          <span class="bg-sg-sub">september 30 · midnight new york</span>
        </div>
        <div class="bg-sg-cell">
          <span class="bg-sg-label">entries</span>
          <span class="bg-sg-num">{entryCount}</span>
          <span class="bg-sg-sub">free · one per person or team</span>
        </div>
        {/* one caption row under the strip: the three trust facts, in the
            strip's own small-caps mono voice (operator wording) */}
        <p class="bg-strip-caption">free entry · judged by a panel · sponsors can’t win prizes</p>
      </section>
    ) : (
      <section class="bg-countdown" data-countdown data-target={String(cdTarget)} aria-label="Countdown to the first game">
        <span class="bg-cd-lead">the first game opens</span>
        <span class="bg-cd-row">
          <span class="bg-cd-cell"><b class="bg-cd-num" data-cd-days>{cd.days}</b><span class="bg-cd-unit">d</span></span>
          <span class="bg-cd-cell"><b class="bg-cd-num" data-cd-hours>{cd.hours}</b><span class="bg-cd-unit">h</span></span>
          <span class="bg-cd-cell"><b class="bg-cd-num" data-cd-mins>{cd.minutes}</b><span class="bg-cd-unit">m</span></span>
          <span class="bg-cd-cell"><b class="bg-cd-num" data-cd-secs>{cd.seconds}</b><span class="bg-cd-unit">s</span></span>
        </span>
        <span class="bg-cd-when">september 1 · midnight new york</span>
      </section>
    )}

    {/* ---------- GAME PHASE: the entry form, front and centre ---------- */}
    {started && (<>
      <section class="bg-enter" id="enter" aria-label="Enter the games">
        {/* The entry count lives in the stat strip above — one number, one place. */}
        <div class="list-head bg-list-head">
          <h2>enter the games</h2>
        </div>
        {canEnter ? (
          <form class="bg-enter-form" method="post" action="/api/thebuildgames/enter" data-entry-form>
            <label class="hp" aria-hidden="true">
              Leave this field empty
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
            <div class="bg-enter-row">
              <label>
                <span>your name</span>
                <input type="text" name="name" required maxlength={NAME_MAX} placeholder="ada lovelace" />
              </label>
              <label>
                <span>handle · optional</span>
                {/* fixed @ adornment: always visible, never typed — the
                    server strips a pasted leading @ anyway (cleanHandle) */}
                <span class="bg-handle-wrap">
                  <span class="bg-handle-at" aria-hidden="true">@</span>
                  <input type="text" name="handle" maxlength="41" placeholder="you" />
                </span>
              </label>
            </div>
            <label>
              <span>demo url</span>
              <input type="text" inputmode="url" autocomplete="url" spellcheck="false" name="demo_url" required maxlength="300" placeholder="your-build.app" />
              <span class="bg-enter-hint">a public URL anyone can open</span>
            </label>
            <label>
              <span>github repo</span>
              <input type="text" inputmode="url" autocomplete="url" spellcheck="false" name="repo_url" required maxlength="300" placeholder="github.com/you/your-build" />
              <span class="bg-enter-hint">public repo · the commit history has to show the work happened inside the window</span>
            </label>
            <label>
              <span>what you built · optional, up to {BLURB_MAX} characters</span>
              <textarea name="blurb" maxlength={BLURB_MAX} rows="2" placeholder="one or two lines"></textarea>
            </label>
            <label>
              <span>email</span>
              <input type="email" name="email" required maxlength="254" placeholder="you@wherever.dev" />
            </label>
            <label class="bg-enter-optin">
              <input type="checkbox" name="newsletter_optin" value="1" />
              <span>email me the results and winners</span>
            </label>
            {/* REQUIRED acceptance (operator rule 3): unchecked by default,
                must tick to submit, enforced server-side too. Separate from
                the optional newsletter box above. */}
            <label class="bg-enter-optin bg-enter-accept">
              <input type="checkbox" name="accept_terms" value="1" required />
              <span>
                {/* _blank: a same-tab hop to the terms ate a half-filled
                    entry (operator report) — reference links inside the
                    form never navigate this tab */}
                I accept <a href="/thebuildgames/terms" target="_blank" rel="noopener">the Build Games terms</a>, including how
                the prize fund works: 100% of the sponsorship money, less third-party payment
                processing fees, and none of it goes to the operator.
              </span>
            </label>
            <div class="bg-enter-actions">
              <button class="btn primary" type="submit">submit your entry</button>
              <span class="bg-enter-note">free · no account · one entry per person or team</span>
            </div>
            <p class="bg-bid-err" data-entry-err hidden></p>
          </form>
        ) : (
          <p class="bg-enter-closed">the build window has closed · entries are locked for judging.</p>
        )}
      </section>

      {/* THE MONEY, PLAINLY (operator's final call): a clean quiet card in
          the site's normal card language — the two sentences, nothing else.
          No accent streak, no ledger, no receipt rules. */}
      <section class="bg-money" aria-label="How the money works">
        <p class="bg-money-line">{MONEY_SENTENCE}</p>
        <p class="bg-money-line">Sponsors buy visibility, not victory: a sponsorship can never win a prize.</p>
      </section>

      <section class="bg-cats" aria-label="Prize categories">
        <div class="list-head bg-list-head">
          <h2>three categories</h2>
          <span class="note">each takes a third of the prize fund · one winner each</span>
        </div>
        {/* A dl, not a ul: this is a feature list (titles + descriptions).
            The share is stated in WORDS, never as fund÷3 dollars: the big
            number is the gross sponsorship pool, so a computed per-category
            figure would overstate what a winner receives. Each tile carries
            its published judging basis (operator directive). */}
        <dl class="bg-cat-tiles">
          {CATEGORIES.map((c, i) => (
            <div class="bg-cat">
              <dt class="bg-cat-head">
                <span class="bg-cat-n">{i + 1}</span>
                <b class="bg-cat-name">{c.name}</b>
              </dt>
              <dd class="bg-cat-line">{c.line}</dd>
              <dd class="bg-cat-judged"><b>judged on:</b> {c.judged}</dd>
              <dd class="bg-cat-share">a third of the prize fund</dd>
            </div>
          ))}
        </dl>
        <p class="bg-cats-note">Judges score every category against these criteria. Their decision is final.</p>
      </section>

      <section class="bg-judges" aria-label="The judges">
        <div class="list-head bg-list-head">
          <h2>the judges</h2>
          <span class="note">{JUDGES_NOTE}</span>
        </div>
        <ul class="bg-judge-row" role="list">
          {/* Name first, @handle secondary beneath in muted small type
              (operator punch list, Aug 31). The name carries the link. */}
          {JUDGES.map((j) => (
            <li class="bg-judge">
              <img class="bg-judge-img" src={j.img} alt="" width="96" height="96" loading="lazy" />
              <a class="bg-judge-name" href={j.url} target="_blank" rel="noopener">{j.name}</a>
              <span class="bg-judge-handle">@{j.handle}</span>
              <p class="bg-judge-bio">{j.bio}</p>
            </li>
          ))}
        </ul>
      </section>

      {/* The rules join the comprehension cluster (design round 2): hero →
          form → categories → judges → rules → who-gets-what, then the
          sponsor surfaces. Ten numbered single-sentence lines, each
          answering a real confusion (operator's wording). */}
      <section class="bg-rules" aria-label="The rules">
        <div class="list-head bg-list-head bg-rules-head">
          <h2>the rules</h2>
        </div>
        <ol class="bg-rules-list">
          <li>Sponsors cannot win prizes.</li>
          <li>Winners are picked by judges, not by sponsor rank.</li>
          <li>3 winners, one per category.</li>
          <li>Entry is free. This is a judged competition, not a raffle.</li>
          <li>Build within the window; AI tools expected.</li>
          <li>Public demo + public repo required.</li>
          <li>One entry per person or team.</li>
          <li>You keep full ownership of what you build.</li>
          <li>Winners are verified before payout.</li>
          <li><a href="/thebuildgames/terms">The terms</a> are the contract.</li>
        </ol>
        <p class="bg-rules-fine">
          winners are announced on this page by {ANNOUNCE_BY} · judges may name runners-up,
          no money attached · plain-english version for builders:{' '}
          <a href="/thebuildgames/builders">how it works</a>
        </p>
      </section>

      {/* Who gets what — the two sides of the money, side by side. The fee
          line is phrased as TIMING (fees come off at payout): the pot number
          on this page is gross and must never read as already-net. */}
      <section class="bg-split" aria-label="What sponsors get and what builders get">
        <div class="bg-split-col">
          <h3>what builders get</h3>
          <p>
            the prize fund: the sponsorship pool less payment processing fees, split
            evenly across the three categories, one winner each.
          </p>
        </div>
        <div class="bg-split-col">
          <h3>what sponsors get</h3>
          <p>
            visibility. a row on the board, the podium for the top three, and the
            link. sponsors never judge and can never win a prize.
          </p>
        </div>
      </section>
    </>)}

    <!-- The buy button, where a buyer actually is: straight under the clock,
         above the board. Scrolling to the bottom to find out how to sponsor
         was costing us the impulse. -->
    {
      bidsOpen && (
        <section
          class="bg-claim"
          data-claim
          data-totals={JSON.stringify(claimTotals)}
          data-step={String(CLAIM_STEP_CENTS)}
          data-min={String(MIN_ENTRY_CENTS)}
          data-max={String(MAX_BID_CENTS)}
          data-open-rank={String(openRank)}
          aria-label="Take a spot on the board"
        >
          {started && <p class="bg-claim-eyebrow">sponsors · you buy visibility, not victory</p>}
          <p class="bg-claim-head">
            <span class="bg-claim-word">take spot</span>
            <span class="bg-stepper">
              <button class="bg-step" type="button" data-rank-dn aria-label="a higher spot">−</button>
              <b class="bg-claim-rank" data-claim-rank>#1</b>
              <button class="bg-step" type="button" data-rank-up aria-label="a lower spot">+</button>
            </span>
            <span class="bg-claim-buy">
              <span class="bg-claim-word">for</span>
              <span class="bg-stepper">
                <button class="bg-step" type="button" data-amt-dn aria-label="bid less">−</button>
                <b class="bg-claim-amt" data-claim-amt>{usd(claimCost(1))}</b>
                <button class="bg-step" type="button" data-amt-up aria-label="bid more">+</button>
              </span>
            </span>
          </p>

          <form class="bg-claim-form" method="post" action="/api/thebuildgames/bid" data-bid-form>
            <label class="hp" aria-hidden="true">
              Leave this field empty
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
            {/* text, not url: a pasted bare domain must reach the server, which
                normalizes it. Same reasoning as the full form below. */}
            <input
              class="bg-claim-link"
              type="text"
              inputmode="url"
              autocomplete="url"
              spellcheck="false"
              name="link"
              required
              maxlength="300"
              placeholder="your product url"
              aria-label="your product url"
            />
            <input type="hidden" name="amount_dollars" data-claim-amount value={String(Math.ceil(claimCost(1) / 100))} />
            <button class="btn primary bg-claim-go" type="submit">take the spot</button>
            <p class="bg-bid-err bg-claim-err" data-bid-err hidden />
          </form>
        </section>
      )
    }

    <!-- Leaderboard: in game phase the top 3 stand on a podium and the list
         continues from #4; before the flip it's the flat ranked list. -->
    <section class="bg-board">
      <div class="list-head bg-list-head">
        <h2>the sponsors</h2>
        {started && <span class="note">they fund the pool · they don't judge</span>}
      </div>

      {started && podium.length > 0 && (
        <ol class="bg-podium" role="list">
          {podium.map((s, i) => (
            <li class:list={['bg-pod', `bg-pod-${i + 1}`]}>
              <span class="bg-pod-rank">{i + 1}</span>
              <span class="bg-pod-logo">
                {s.icon_url ? (
                  <img src={s.icon_url} alt="" width="56" height="56" loading="lazy" referrerpolicy="no-referrer" />
                ) : faviconUrl(s.link) ? (
                  <img src={faviconUrl(s.link)} alt="" width="56" height="56" loading="lazy" referrerpolicy="no-referrer" />
                ) : (
                  <span class="bg-monogram">{monogram(s.name ?? hostOf(s.link) ?? displayName(s))}</span>
                )}
              </span>
              <span class="bg-pod-name">
                <a href={withUtm(s.link, 'build_games')} rel="sponsored nofollow noopener" target="_blank" data-bg-out={s.id}>
                  {s.name ?? hostOf(s.link) ?? displayName(s)}
                </a>
              </span>
              {s.tagline && <span class="bg-pod-tagline">{s.tagline}</span>}
              <span class="bg-pod-amount">{usd(s.cleared_total)}</span>
            </li>
          ))}
        </ol>
      )}

      {
        pageRows.length > 0 ? (
          <ol class="bg-rows">
            {pageRows.map((s, i) => (<>
              <li class:list={['bg-row', { lead: rankOf(i) === 1, p2: rankOf(i) === 2, p3: rankOf(i) === 3 }]}>
                <span class="bg-rank">{rankOf(i)}</span>
                <span class="bg-logo">
                  {s.icon_url ? (
                    <img src={s.icon_url} alt="" width="40" height="40" loading="lazy" referrerpolicy="no-referrer" />
                  ) : faviconUrl(s.link) ? (
                    <img src={faviconUrl(s.link)} alt="" width="40" height="40" loading="lazy" referrerpolicy="no-referrer" />
                  ) : (
                    <span class="bg-monogram">{monogram(s.name ?? hostOf(s.link) ?? displayName(s))}</span>
                  )}
                </span>
                <span class="bg-name">
                  <a href={withUtm(s.link, 'build_games')} rel="sponsored nofollow noopener" target="_blank" data-bg-out={s.id}>{s.name ?? hostOf(s.link) ?? displayName(s)}</a>
                  {s.tagline && <span class="bg-row-tagline">{s.tagline}</span>}
                  <span class="bg-host">
                    added {timeAgo(s.first_cleared_at)}{s.click_count > 0 ? ` · ${s.click_count.toLocaleString('en-US')} click${s.click_count === 1 ? '' : 's'}` : ''}
                  </span>
                </span>
                <span class="bg-amount-cell">
                  <span class="bg-amount">{usd(s.cleared_total)}</span>
                </span>
              </li>
              {nlInline && i === 4 && (
                <li class="bg-nl-li">
                  <BuildGamesNewsletter variant="inline" />
                </li>
              )}
            </>))}
          </ol>
        ) : ranked.length === 0 ? (
          <p class="bg-empty">no sponsors yet · the first bid starts the pool.</p>
        ) : null
      }

      {totalPages > 1 && (
        <nav class="bg-pager" aria-label="Sponsor pages">
          {page > 1 ? <a href={`/thebuildgames?page=${page - 1}`} rel="prev">← previous</a> : <span />}
          <span class="bg-pager-at">page {page} of {totalPages}</span>
          {page < totalPages ? <a href={`/thebuildgames?page=${page + 1}`} rel="next">next →</a> : <span />}
        </nav>
      )}

      {!nlInline && (
        <div class="bg-nl-below">
          <BuildGamesNewsletter variant="inline" />
        </div>
      )}

      <div class="bg-cta">
        {bidsOpen ? (
          <>
            <button class="btn primary" type="button" data-top-open>take the top spot · {usd(claimCost(1))}</button>
            {/* One field between the button and Stripe: the checkout needs a
                product URL, nothing else. Amount is pre-locked to the cost of
                #1 — the SAME claimCost math as the top bar, rendered server-
                side; the API re-derives every floor regardless. Posts through
                the shared [data-bid-form] handler. */}
            <form class="bg-top-form" method="post" action="/api/thebuildgames/bid" data-bid-form data-top-form hidden>
              <label class="hp" aria-hidden="true">
                Leave this field empty
                <input type="text" name="website" tabindex="-1" autocomplete="off" />
              </label>
              <input type="hidden" name="amount_dollars" value={Math.ceil(claimCost(1) / 100)} />
              <input
                type="text"
                inputmode="url"
                autocomplete="url"
                spellcheck="false"
                name="link"
                required
                maxlength="300"
                placeholder="your product url"
                aria-label="your product url"
              />
              <button class="btn primary" type="submit">pay {usd(claimCost(1))} →</button>
              <p class="bg-bid-err" data-bid-err hidden></p>
            </form>
            <span class="bg-cta-note">or <a href="#" data-bid-open>add a tagline, icon or email</a> · enter from ${minEntryUsd.toLocaleString('en-US')} · you keep your spot until someone's total is higher</span>
          </>
        ) : (
          <span class="bg-cta-note bg-soon">bidding opens with the games · get notified below</span>
        )}
      </div>

      {
        bidsOpen && (
          <form class="bg-bid-form" method="post" action="/api/thebuildgames/bid" data-bid-form data-collapsible hidden>
            <label class="hp" aria-hidden="true">
              Leave this field empty
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
            <div class="bg-bid-row">
              <label>
                <span>your link</span>
                <!-- type=text, not url: a pasted bare domain must not be
                     rejected by browser validation — the server normalizes
                     (https:// added, http upgraded, www/trailing-slash folded). -->
                <input type="text" inputmode="url" autocomplete="url" spellcheck="false" name="link" required placeholder="your-tool.com" maxlength="300" />
              </label>
              <label>
                <span>amount (usd)</span>
                <input type="number" name="amount_dollars" required min={minFormUsd} max={maxUsd} step="1" placeholder={String(minEntryUsd)} />
              </label>
            </div>
            <label class="bg-bid-tag">
              <span>tagline · optional</span>
              <input type="text" name="tagline" maxlength={TAGLINE_MAX} placeholder="what you're about, in a few words" />
            </label>
            <label class="bg-bid-tag">
              <span>email · optional</span>
              <input type="email" name="email" maxlength="254" placeholder="so we can tell you if you're outbid or held" />
            </label>
            <label class="bg-bid-tag">
              <span>icon · optional</span>
              <input type="file" name="icon" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" />
              <span class="bg-bid-hint">png/jpg/webp up to 1MB · otherwise we use your site's favicon</span>
            </label>
            <label class="bg-bid-optin">
              <input type="checkbox" name="email_optin" value="1" />
              <span>email me Build Games updates too</span>
            </label>
            <div class="bg-bid-actions">
              <button class="btn primary" type="submit">place bid</button>
              <span class="bg-bid-note">
                it lists once payment clears · by bidding you agree to the{' '}
                <a href="/thebuildgames/terms">terms</a>
              </span>
            </div>
            <p class="bg-bid-err" data-bid-err hidden></p>
          </form>
        )
      }
    </section>

    <BuildGamesNewsletter variant="section" />

    <!-- The per-row report buttons are gone (they were visual noise on the
         product itself), but a way to flag a listing has to survive: a paid
         placement can still point somewhere it shouldn't, and "no route to
         tell us" is not a defensible position. One quiet line, out of the
         way of the board. -->
    {/* Astro collapses the whitespace between a text line and an <a> on the
        next line — the explicit {' '} separators are load-bearing. */}
    <p class="bg-terms-foot">
      <a href="/thebuildgames/builders">for the builders</a> · free skill-judged entry · independent judging ·{' '}
      <a href="/thebuildgames/terms">the Build Games terms</a> ·{' '}
      <a href="mailto:hello@vibecodeit.com?subject=Build%20Games%20listing%20report">report a listing</a>
    </p>
  </main>
</Base>

<script is:inline src={`/js/buildgames.js?v=${__BUILD_ID__}`} defer></script>

<style>
  .bg-wrap {
