  }

  .bg-claim-rank {
    min-width: 2.4ch;
  }

  .bg-claim-amt {
    color: var(--primary);
    min-width: 5ch;
  }

  .bg-claim-form {
    display: flex;
    align-items: stretch;
    gap: 8px;
    width: min(680px, 100%);
    position: relative;
  }

  .bg-claim-link {
    flex: 1 1 auto;
    min-width: 0;
    padding: 13px 18px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--fg);
    font-size: 15px;
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
  }

  .bg-claim-link::placeholder {
    color: var(--muted);
  }

  .bg-claim-link:hover {
    border-color: color-mix(in srgb, var(--primary) 40%, var(--border));
  }

  .bg-claim-link:focus-visible {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 20%, transparent);
  }

  .bg-claim-go {
    flex: none;
    border-radius: 999px;
    padding-inline: 24px;
    white-space: nowrap;
  }

  .bg-claim-err {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-step,
    .bg-step:hover:not(:disabled),
    .bg-step:active:not(:disabled) {
      transition: none;
      transform: none;
    }
  }

  /* ---------- bid form ---------- */
  .bg-bid-form {
    max-width: 520px;
    margin: 20px auto 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
  }

  .bg-bid-form[hidden] {
    display: none;
  }

  .bg-bid-row {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 12px;
  }

  @media (max-width: 520px) {
    .bg-bid-row {
      grid-template-columns: 1fr;
    }
  }

  .bg-bid-form label > span {
    display: block;
    padding-bottom: 6px;
    font: 12px var(--font-mono);
    color: var(--muted);
  }

  .bg-bid-form input {
    width: 100%;
    padding: 10px 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--fg);
    font: 14px var(--font-mono);
  }

  @media (max-width: 640px) {
    .bg-bid-form input {
      font-size: 16px;
    }
  }

  .bg-bid-optin {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
    cursor: pointer;
  }

  .bg-bid-hint {
    font-size: 11px;
    color: var(--muted);
  }

  /* traffic strip ABOVE the lockup — the "why a placement is worth $500"
     numbers lead the page */
  .bg-stats {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0 0 12px;
    padding: 7px 14px;
    font-size: 12.5px;
    line-height: 1;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    width: fit-content;
    margin-inline: auto;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
  }

  /* The gap under the pill is set here, after the shorthand above, so it
     survives the `margin: 0 0 12px` and the `margin-inline: auto` both
     landing on the same rule. */
  .bg-stats {
    margin-bottom: 24px;
  }

  /* every stat is one centred inline-flex line — number and label share a
     vertical centre instead of fighting baselines of two font sizes */
  .bg-stat {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    line-height: 1;
  }

  .bg-stat b {
    color: var(--fg);
    font-size: 14px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }

  /* Hover reads as a soft lift, never an underline: the strip is a pill of
     quiet furniture and a rule through it looks like a broken link. */
  .bg-stat-link {
    color: var(--primary);
    text-decoration: none;
    padding: 3px 9px;
    margin: -3px -3px -3px 0;
    border-radius: 999px;
    transition: color 0.18s ease, background-color 0.18s ease;
  }

  .bg-stat-link:hover,
  .bg-stat-link:focus-visible {
    color: color-mix(in srgb, var(--primary) 78%, var(--fg));
    background: color-mix(in srgb, var(--primary) 12%, transparent);
  }

  .bg-stat-live {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .bg-live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--primary) 55%, transparent);
    animation: bg-live-pulse 2.4s ease-out infinite;
  }

  @keyframes bg-live-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--primary) 55%, transparent); }
    70% { box-shadow: 0 0 0 7px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-live-dot { animation: none; }
  }

  .bg-bid-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .bg-bid-note {
    font-size: 12px;
    color: var(--muted);
    max-width: 34ch;
    line-height: 1.5;
  }

  .bg-bid-err {
    font-size: 13px;
    color: var(--no-bg);
  }

  .bg-cta-note {
    font: 12px var(--font-mono);
    color: var(--muted);
    text-align: center;
    max-width: 48ch;
  }

  /* ---------- notify ---------- */
  .bg-notify {
    margin-top: 52px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .bg-notify h2 {
    font-size: 15px;
  }

  .bg-wl {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
    padding-top: 14px;
  }

  .bg-wl input[type='email'] {
    flex: 1;
    min-width: 220px;
    max-width: 320px;
    padding: 10px 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--fg);
    font: 14px var(--font-mono);
  }

  @media (max-width: 640px) {
    .bg-wl input[type='email'] {
      font-size: 16px;
    }
  }

  /* the one-field "take the top spot" mini-form under the board */
  .bg-top-form {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
    padding: 14px 0 4px;
  }

  .bg-top-form[hidden] {
    display: none;
  }

  .bg-top-form input[name='link'] {
    flex: 1;
    min-width: 220px;
    max-width: 360px;
    padding: 10px 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--fg);
    font: 14px var(--font-mono);
  }

  @media (max-width: 640px) {
    .bg-top-form input[name='link'] {
      font-size: 16px;
    }
  }

  .bg-top-form .bg-bid-err {
    width: 100%;
    text-align: center;
  }

  .bg-cta-note a {
    color: var(--primary);
  }

  .bg-terms-foot {
    padding-top: 40px;
    text-align: center;
    font: 12px var(--font-mono);
    color: var(--muted);
  }

  .bg-terms-foot a {
    color: var(--muted);
    text-decoration: underline;
  }

  .bg-terms-foot a:hover {
    color: var(--fg);
  }

  /* ---------- micro-interactions (page-scoped) ---------- */
  .bg-wrap :global(.btn) {
    transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
  }

  .bg-wrap :global(.btn:hover) {
    transform: translateY(-1px);
    filter: brightness(1.06);
  }

  .bg-wrap :global(.btn:active) {
    transform: translateY(0);
    filter: brightness(0.96);
  }

  .bg-wrap :global(.btn:focus-visible) {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .bg-wrap :global(.btn.primary:hover) {
    box-shadow: 0 6px 20px -8px color-mix(in srgb, var(--primary) 60%, transparent);
  }

  /* The orb invites a poke: soft glow on hover, and the client JS rains a few
     bills on click (reduced-motion users get neither). */
  .bg-orb-stage {
    cursor: pointer;
    transition: filter 0.25s ease;
  }

  .bg-orb-stage:hover {
    filter: drop-shadow(0 0 26px color-mix(in srgb, var(--primary) 22%, transparent));
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-row,
    .bg-logo img,
    .bg-monogram,
    .bg-orb-stage,
    .bg-wrap :global(.btn) {
      transition: none;
    }

    .bg-row:hover,
    .bg-row:focus-within,
    .bg-wrap :global(.btn:hover) {
      transform: none;
    }

    .bg-row:hover .bg-logo img,
    .bg-row:hover .bg-monogram {
      transform: none;
    }
  }

  /* ---------- small screens: the viral-tweet landing surface ---------- */
  @media (max-width: 640px) {
    .bg-wrap {
      padding-top: 24px;
    }

    .bg-stats {
      gap: 6px 14px;
      padding: 8px 14px;
      font-size: 12px;
      margin-bottom: 22px;
    }

    .bg-stat b {
      font-size: 13px;
    }

    .bg-row {
      grid-template-columns: 24px 34px minmax(0, 1fr) auto;
      gap: 6px 10px;
      padding: 10px 12px;
    }

    /* On a phone the middle column squeezes the tagline to ~150px (~21
       chars/line — half of a 100-char line was silently cut). Give the
       name/tagline block the FULL row width on its own line beneath
       rank/logo/amount; the amount stays the loudest thing in the row. */
    .bg-name {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .bg-claim {
      padding: 20px 0 4px;
      gap: 12px;
    }

    .bg-claim-head {
      gap: 6px 9px;
    }

    .bg-claim-buy {
      flex: 1 0 100%;
      justify-content: center;
    }

    /* Full-width tap targets beat a squeezed side-by-side row on a phone. */
    .bg-claim-form {
      flex-direction: column;
    }

    .bg-claim-go {
      width: 100%;
      padding-block: 13px;
    }

    .bg-claim-err {
      position: static;
      margin-top: 2px;
    }

    .bg-amount-cell {
      grid-column: 4;
      grid-row: 1;
    }

    .bg-logo img,
    .bg-monogram {
      width: 34px;
      height: 34px;
    }

    .bg-rank {
      font-size: 14px;
    }

    .bg-row.lead .bg-rank {
      font-size: 21px;
    }

    .bg-row.p2 .bg-rank {
      font-size: 17px;
    }

    .bg-row.p3 .bg-rank {
      font-size: 15px;
    }

    .bg-amount {
      font-size: 21px;
    }

    .bg-meta {
      font-size: 10px;
    }

    /* A one-line ellipsis leaves ~10 chars of tagline next to the amount;
       two clamped lines keeps rows tight AND readable. */
    .bg-name a {
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      font-size: 14px;
      line-height: 1.25;
    }
  }

  /* ═══════════ GAME PHASE (post-midnight layout) ═══════════ */

  /* The theme takes the stage (orb gone): display treatment under the
     lockup, then the quiet idea pill, then the clarity paragraphs. */
  .bg-theme {
    margin-top: 16px;
    margin-inline: auto;
    max-width: 30ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(22px, 3vw, 30px);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--primary);
    text-wrap: balance;
  }

  .bg-theme-pill {
    display: inline-block;
    margin-top: 12px;
    padding: 7px 16px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font: 12px var(--font-mono);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .bg-theme-pill:hover {
    color: var(--fg);
    border-color: var(--muted);
  }

  /* ---------- headline stat strip (pool · clock · entries) ---------- */
  .bg-statgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 900px;
    margin-inline: auto;
    padding-top: 20px;
    text-align: center;
  }

  .bg-sg-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    padding: 4px 18px;
  }

  .bg-sg-cell + .bg-sg-cell {
    border-left: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
  }

  .bg-sg-label {
    font: 11px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .bg-sg-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }

  .bg-sg-money {
    color: var(--primary);
  }

  /* countdown numerals: tabular + reserved width so the tick never jitters */
  .bg-sg-cd {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
  }

  .bg-sg-cd b {
    font-weight: 700;
    min-width: 2ch;
    text-align: right;
  }

  .bg-sg-cd i {
    font: 400 12px var(--font-mono);
    font-style: normal;
    color: var(--muted);
    padding-right: 6px;
  }

  .bg-sg-cd i:last-child {
    padding-right: 0;
  }

  /* the seconds segment appears only inside the final 24 hours */
  .bg-sg-sec {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
  }

  .bg-sg-sec[hidden] {
    display: none;
  }

  /* the caption row under the strip: full grid row, the strip's own voice */
  .bg-strip-caption {
    grid-column: 1 / -1;
    padding-top: 18px;
    text-align: center;
    font: 11px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  /* ---------- the money, plainly: a clean quiet card ---------- */
  .bg-money {
    max-width: 640px;
    margin: 44px auto 0;
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
  }

  .bg-money-line {
    font-size: 15px;
    line-height: 1.65;
    color: var(--fg);
    text-wrap: pretty;
  }

  .bg-sg-sub {
    font: 11px var(--font-mono);
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .bg-statgrid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .bg-sg-cell {
      padding: 14px 0;
    }

    .bg-sg-cell + .bg-sg-cell {
      border-left: 0;
      border-top: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
    }
  }

  /* ---------- entry form (front and centre) ---------- */
  .bg-enter {
    padding-top: 44px;
  }

  .bg-enter-form {
    max-width: 640px;
    margin: 12px auto 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px;
    border: 1px solid var(--primary);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 8px 30px -18px color-mix(in srgb, var(--primary) 45%, transparent);
  }

  .bg-enter-row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 14px;
  }

  @media (max-width: 520px) {
    .bg-enter-row {
      grid-template-columns: 1fr;
    }
  }

  .bg-enter-form label > span:first-child {
    display: block;
    padding-bottom: 6px;
    font: 12px var(--font-mono);
    color: var(--muted);
  }

  .bg-enter-form input:not([type='checkbox']),
  .bg-enter-form textarea {
    width: 100%;
    padding: 11px 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--fg);
    font: 14px var(--font-mono);
    resize: vertical;
    /* JetBrains Mono's :// ligature visually fuses the slashes while typing
       a URL — the value is intact but reads like a slash was eaten. Inputs
       render glyph-per-character, always. */
    font-variant-ligatures: none;
    font-feature-settings: 'liga' 0, 'calt' 0;
  }

  @media (max-width: 640px) {
    .bg-enter-form input:not([type='checkbox']),
    .bg-enter-form textarea {
      font-size: 16px;
    }
  }

  .bg-enter-hint {
    display: block;
    padding-top: 6px;
    font: 11px var(--font-mono);
    color: var(--muted);
  }

  /* the handle field's fixed @ prefix: pinned, muted, never interactive */
  .bg-handle-wrap {
    position: relative;
    display: block;
  }

  .bg-handle-at {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    font: 14px var(--font-mono);
    color: var(--muted);
    pointer-events: none;
    line-height: 1;
  }

  /* outranks the form's own input padding rule */
  .bg-enter-form .bg-handle-wrap input:not([type='checkbox']) {
    padding-left: 27px;
  }

  @media (max-width: 640px) {
    .bg-handle-at {
      font-size: 16px;
    }

    .bg-enter-form .bg-handle-wrap input:not([type='checkbox']) {
      padding-left: 30px;
    }
  }

  .bg-enter-optin {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
    cursor: pointer;
  }

  /* the required acceptance box: multi-line label, checkbox pinned to top */
  .bg-enter-accept {
    align-items: flex-start;
    line-height: 1.55;
  }

  .bg-enter-accept input {
    margin-top: 3px;
    flex: none;
  }

  .bg-enter-accept a {
    color: var(--primary);
    text-decoration: underline;
  }

  .bg-enter-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .bg-enter-note {
    font: 12px var(--font-mono);
    color: var(--muted);
  }

  .bg-enter-closed {
    padding: 24px 0;
    text-align: center;
    font-size: 14px;
    color: var(--muted);
  }

  /* ---------- categories ---------- */
  .bg-cats {
    padding-top: 44px;
  }

  .bg-cat-tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    padding-top: 12px;
    margin: 0;
  }

  .bg-cat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
  }

  .bg-cat dd {
    margin: 0;
  }

  .bg-cat-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .bg-cat-n {
    font: 800 13px var(--font-mono);
    color: var(--primary);
  }

  .bg-cat-name {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
  }

  .bg-cat-line {
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }

  .bg-cat-judged {
    padding-top: 2px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--muted);
  }

  /* Brand kit: uppercase micro-labels carry WIDE tracking — same band as
     the other labels on this page (0.1–0.14em). */
  .bg-cat-judged b {
    font: 700 11px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--fg) 75%, var(--muted));
  }

  .bg-cat-share {
    margin-top: auto;
    padding-top: 8px;
    font: 12px var(--font-mono);
    color: var(--primary);
  }

  .bg-cats-note {
    padding-top: 10px;
    font: 12px var(--font-mono);
    color: var(--muted);
    text-align: center;
  }

  /* ---------- judges ---------- */
  .bg-judges {
    padding-top: 44px;
  }

  .bg-judge-row {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    padding-top: 12px;
  }

  .bg-judge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 20px 16px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    text-align: center;
  }

  .bg-judge-img {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    outline: 1px solid color-mix(in srgb, var(--fg) 10%, transparent);
    outline-offset: -1px;
    margin-bottom: 6px;
  }

  .bg-judge-name {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    color: var(--fg);
    text-decoration: none;
  }

  .bg-judge-name:hover {
    color: var(--primary);
  }

  .bg-judge-handle {
    font: 12px var(--font-mono);
    color: var(--muted);
  }

  .bg-judge-bio {
    padding-top: 4px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--muted);
  }

  /* ---------- claim bar demotion label ---------- */
  .bg-claim-eyebrow {
