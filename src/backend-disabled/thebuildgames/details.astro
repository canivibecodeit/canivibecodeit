---
/* Post-checkout details for a Build Games placement — the payer lands here
   from Stripe and writes the tagline their row shows. Clone of the
   /sponsor/details mechanic: the buyer is identified by TOKEN ONLY (?token=),
   and the redirect-vs-webhook race is settled by asking Stripe directly —
   clearPayment is atomic and idempotent, so whoever arrives second changes
   nothing. Editing is allowed only when THIS payment cleared AND won the
   sponsor's identity claim; a top-up or held payment can never publish. */
import Base from '../../layouts/Base.astro';
import {
  bgFirstClearedScreenedPayment,
  bgPaymentByDetailsToken,
  bgSponsorById,
  bgSponsorClearedTotal,
} from '../../lib/db.js';
import { buildGamesLive } from '../../lib/flags.js';
import { NAME_MAX, TAGLINE_MAX, monogram, usd } from '../../lib/buildgames.js';
import { faviconUrl } from '../../lib/sponsors.js';
import { hostedIconUrl } from '../../lib/sponsor-icon.js';
import IconUpload from '../../components/IconUpload.astro';
import { getSession } from '../../lib/stripe.js';
import { clearPayment } from '../../lib/buildgames-payments.js';
import { sendBgReceipt } from '../../lib/buildgames-mail.js';

if (!buildGamesLive()) return new Response(null, { status: 404 });

const TOKEN_TTL_MS = 30 * 24 * 60 * 60 * 1000; // a month to fill in details

const token = Astro.url.searchParams.get('token') || '';
const sessionId = Astro.url.searchParams.get('session_id') || '';
let payment = token ? await bgPaymentByDetailsToken(token) : null;
if (payment && Date.now() - Number(payment.created_at) > TOKEN_TTL_MS) payment = null;

/* The payer often lands here BEFORE the webhook delivery. Ask Stripe for the
   session and clear through the existing atomic interface — every guard the
   webhook applies is applied here too (metadata binding to THIS payment,
   paid, usd, sane amount), and a second clear from either side no-ops. */
if (payment && payment.status === 'pending' && sessionId) {
  try {
    const s = await getSession(sessionId);
    const captured = Math.round(Number(s?.amount_total));
    if (
      s?.metadata?.kind === 'buildgames' &&
      s?.metadata?.payment_id === payment.id &&
      s?.payment_status === 'paid' &&
      (!s.currency || s.currency === 'usd') &&
      Number.isInteger(captured) &&
      captured > 0
    ) {
      const clearedHere = await clearPayment(payment.id, { capturedCents: captured, processorRef: s.payment_intent || s.id });
      if (clearedHere) {
        // The payer beat the webhook (the common case — Stripe redirects
        // instantly, the delivery lags). This side won the atomic clear, so
        // THIS side sends the one receipt; the webhook's clear will return
        // false and send nothing. Exactly-once either way.
        sendBgReceipt({ to: s.customer_details?.email, capturedCents: captured, ref: s.payment_intent || s.id });
      }
      payment = await bgPaymentByDetailsToken(token);
    }
  } catch (err) {
    console.error(`bg details session lookup failed: ${err?.message || err}`);
  }
}

const sponsor = payment ? await bgSponsorById(payment.sponsor_id) : null;
// The ACTUAL claim winner is recorded at claim time (claimed_by); the
// earliest-cleared proxy remains only for rows claimed before the column
// existed. The two can diverge under razor-thin concurrent clears.
const winnerId =
  sponsor?.claimed_by ??
  (sponsor?.first_cleared_at != null ? (await bgFirstClearedScreenedPayment(sponsor.id))?.id : null);

/* One state string drives the whole page. */
let state = 'missing';
if (payment && sponsor) {
  if (payment.status === 'pending') state = 'processing';
  else if (payment.status !== 'cleared') state = 'missing';
  else if (sponsor.status !== 'active' || sponsor.first_cleared_at == null) state = 'held';
  else if (winnerId !== payment.id) state = 'topup';
  else state = 'editable';
}

const clearedTotal = sponsor ? await bgSponsorClearedTotal(sponsor.id) : 0;
// Uploaded = an icon we host under a VERSIONED key (the clear-time favicon
// re-host lives at buildgames/<id>.webp, unversioned, and is the default).
const iconUploaded =
  !!sponsor && hostedIconUrl(sponsor.icon_url, 'buildgames') && /-\d{10,}\.webp$/.test(sponsor.icon_url);
const hostName = (() => {
  try {
    return new URL(sponsor?.link ?? '').hostname.replace(/^www\./, '');
  } catch {
    return sponsor?.link ?? '';
  }
})();

const title = 'Your placement · The Build Games';
const description = 'Finish setting up your Build Games placement.';
---

<Base {title} {description} hideSponsors={true} hideDigest={true} noindex={true}>
  <main class="wrap bgd">
    {state === 'missing' && (
      <>
        <h1>that link doesn't work</h1>
        <p class="bgd-sub">
          The details link is invalid or has expired. If you just paid, use the link from
          your receipt email, or write to <a href="mailto:hello@vibecodeit.com">hello@vibecodeit.com</a>.
        </p>
      </>
    )}

    {state === 'processing' && (
      <>
        <h1>payment processing</h1>
        <p class="bgd-sub">
          Your payment is being confirmed. This usually takes a few seconds ·{' '}
          <a href={`/thebuildgames/details?token=${token}${sessionId ? `&session_id=${sessionId}` : ''}`}>refresh</a>.
        </p>
      </>
    )}

    {state === 'held' && (
      <>
        <h1>placement under review</h1>
        <p class="bgd-sub">
          Your payment cleared and your money is in the sponsorship pool, but the placement is
          being reviewed before it lists. We'll be in touch if anything's needed ·{' '}
          <a href="mailto:hello@vibecodeit.com">hello@vibecodeit.com</a>.
        </p>
      </>
    )}

    {state === 'topup' && (
      <>
        <h1>top-up received</h1>
        <p class="bgd-sub">
          This payment added {usd(payment.amount_cents)} to an existing placement — its
          name and tagline are managed by the placement's first payment.{' '}
          <a href="/thebuildgames">see the board →</a>
        </p>
      </>
    )}

    {state === 'editable' && (
      <>
        <h1>you're on the board</h1>
        <p class="bgd-sub">This is your row. Write the line it shows · it goes live the moment you save.</p>

        <div class="bgd-preview" aria-label="Your row as it appears on the board">
          <span class="bgd-logo">
            {sponsor.icon_url ? (
              <img src={sponsor.icon_url} alt="" width="40" height="40" referrerpolicy="no-referrer" />
            ) : faviconUrl(sponsor.link) ? (
              <img src={faviconUrl(sponsor.link)} alt="" width="40" height="40" referrerpolicy="no-referrer" />
            ) : (
              <span class="bgd-monogram">{monogram(hostName)}</span>
            )}
          </span>
          <span class="bgd-name">
            <b data-preview-name>{sponsor.name ?? hostName}</b>
            <span class="bgd-tagline" data-preview-tagline>{sponsor.tagline ?? 'your tagline appears here'}</span>
          </span>
          <span class="bgd-amount">{usd(clearedTotal)}</span>
        </div>

        <div class="bgd-icon">
          <IconUpload
            endpoint="/api/thebuildgames/icon"
            token={token}
            current={sponsor.icon_url ?? ''}
            fallback={faviconUrl(sponsor.link)}
            uploaded={iconUploaded}
            targets=".bgd-logo img"
          />
        </div>

        <form class="bgd-form" method="post" action="/api/thebuildgames/details" data-details-form>
          <input type="hidden" name="token" value={token} />
          <label>
            <span>name · up to {NAME_MAX} characters</span>
            <input
              type="text"
              name="name"
              maxlength={NAME_MAX}
              value={sponsor.name ?? ''}
              placeholder={hostName}
              data-name-input
            />
          </label>
          <label class="bgd-tagline-label">
            <span>tagline · up to {TAGLINE_MAX} characters, no links</span>
            <input
              type="text"
              name="tagline"
              maxlength={TAGLINE_MAX}
              required
              value={sponsor.tagline ?? ''}
              placeholder="what you're about, in a few words"
              data-tagline-input
            />
          </label>
          <div class="bgd-actions">
            <button class="btn primary" type="submit">save · goes live now</button>
            <a class="bgd-skip" href="/thebuildgames">skip for now →</a>
          </div>
          <p class="bgd-err" data-details-err hidden></p>
        </form>
      </>
    )}
  </main>
</Base>

<script is:inline src={`/js/icon-upload.js?v=${__BUILD_ID__}`} defer></script>

<script>
  // Live preview + save. External module (Astro-bundled), no inline script.
  const form = document.querySelector('[data-details-form]');
  if (form) {
    const input = document.querySelector('[data-tagline-input]');
    const preview = document.querySelector('[data-preview-tagline]');
    input?.addEventListener('input', () => {
      if (preview) preview.textContent = input.value.trim() || 'your tagline appears here';
    });
    const nameInput = document.querySelector('[data-name-input]');
    const namePreview = document.querySelector('[data-preview-name]');
    nameInput?.addEventListener('input', () => {
      if (namePreview) namePreview.textContent = nameInput.value.trim() || nameInput.placeholder;
    });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]');
      const err = document.querySelector('[data-details-err]');
      if (err) err.hidden = true;
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'saving…';
      }
      try {
        const data = Object.fromEntries(new FormData(form).entries());
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token: data.token, name: data.name, tagline: data.tagline }),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok) {
          if (err) {
            err.textContent = out.error || 'something broke · try again';
            err.hidden = false;
          }
          return;
        }
        window.location.href = '/thebuildgames?saved=1';
      } catch {
        if (err) {
          err.textContent = 'network hiccup · try again';
          err.hidden = false;
        }
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'save · goes live now';
        }
      }
    });
  }
</script>

<style>
  .bgd {
    max-width: 560px;
    padding-top: 56px;
    padding-bottom: 120px;
    text-align: center;
  }

  .bgd h1 {
    font-size: 26px;
  }

  .bgd-sub {
    padding-top: 10px;
    font-size: 14px;
    color: var(--muted);
    line-height: 1.7;
  }

  .bgd-sub a {
    color: var(--primary);
  }

  /* the row, exactly as the board draws it */
  .bgd-preview {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    margin-top: 26px;
    padding: 12px 14px;
    border: 1px solid var(--primary);
    border-radius: 10px;
    background: var(--surface);
    text-align: left;
  }

  .bgd-logo img {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    object-fit: cover;
    display: block;
  }

  .bgd-monogram {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    font: 700 14px var(--font-mono);
    color: var(--primary);
  }

  .bgd-name {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .bgd-name b {
    font-size: 15px;
  }

  .bgd-tagline {
    font-size: 13px;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bgd-amount {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    color: var(--primary);
    font-variant-numeric: tabular-nums;
  }

  .bgd-icon {
    margin-top: 22px;
    text-align: left;
  }

  .bgd-form {
    margin-top: 22px;
    text-align: left;
  }

  .bgd-tagline-label {
    display: block;
    padding-top: 12px;
  }

  .bgd-form label > span {
    display: block;
    padding-bottom: 6px;
    font: 12px var(--font-mono);
    color: var(--muted);
  }

  .bgd-form input[type='text'] {
    width: 100%;
    padding: 11px 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--fg);
    font: 14px var(--font-mono);
  }

  @media (max-width: 640px) {
    .bgd-form input[type='text'] {
      font-size: 16px;
    }
  }

  .bgd-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 14px;
  }

  .bgd-skip {
    font: 12px var(--font-mono);
    color: var(--muted);
  }

  .bgd-err {
    padding-top: 10px;
    font-size: 13px;
    color: var(--no-bg, #e5484d);
  }
</style>
