---
/* A builder's Build Games entry — the success screen after submitting, and
   the edit surface until the window closes. The entrant is identified by
   TOKEN ONLY (?token=, emailed at submission) — same mechanic as
   /thebuildgames/details. This path is on the Base.astro isPrivate list AND
   the analytics.js.js scrubber (token-bearing URLs stay out of analytics). */
import Base from '../../layouts/Base.astro';
import { bgEntryByEditToken } from '../../lib/db.js';
import { buildGamesLive } from '../../lib/flags.js';
import { BLURB_MAX, HOWTOAI_REC, NAME_MAX, gamesEndAt } from '../../lib/buildgames.js';

if (!buildGamesLive()) return new Response(null, { status: 404 });

const token = Astro.url.searchParams.get('token') || '';
const entry = token.length >= 20 && token.length <= 128 ? await bgEntryByEditToken(token) : null;
const justSubmitted = Astro.url.searchParams.get('submitted') === '1';
const windowOpen = Date.now() < gamesEndAt();

let state = 'missing';
if (entry) state = windowOpen ? 'editable' : 'locked';

const title = 'Your entry · The Build Games';
const description = 'Your Build Games entry.';
---

<Base {title} {description} hideSponsors={true} hideDigest={true} noindex={true}>
  <main class="wrap bge">
    {state === 'missing' && (
      <>
        <h1>that link doesn't work</h1>
        <p class="bge-sub">
          The edit link is invalid. Use the link from your confirmation email, or write to{' '}
          <a href="mailto:hello@vibecodeit.com">hello@vibecodeit.com</a>.
        </p>
      </>
    )}

    {state !== 'missing' && (
      <>
        {justSubmitted ? (
          <>
            <h1>you're in</h1>
            <p class="bge-sub">
              Entry submitted. We emailed this link to you · it works until the window closes.
              {entry.newsletter_optin ? ' The results and winners go to your inbox too.' : ''}
            </p>
          </>
        ) : (
          <>
            <h1>your entry</h1>
            <p class="bge-sub">
              {state === 'editable'
                ? 'Edit anything below. We emailed this link to you · it works until the window closes.'
                : 'The build window has closed. Entries are locked for judging.'}
            </p>
          </>
        )}

        <form class="bge-form" method="post" action="/api/thebuildgames/entry" data-entry-edit-form>
          <input type="hidden" name="token" value={token} />
          <div class="bge-row">
            <label>
              <span>name · up to {NAME_MAX} characters</span>
              <input type="text" name="name" required maxlength={NAME_MAX} value={entry.name} disabled={state === 'locked'} />
            </label>
            <label>
              <span>handle · optional</span>
              {/* fixed @ adornment — same treatment as the entry form */}
              <span class="bg-handle-wrap">
                <span class="bg-handle-at" aria-hidden="true">@</span>
                <input type="text" name="handle" maxlength="41" value={entry.handle ?? ''} placeholder="you" disabled={state === 'locked'} />
              </span>
            </label>
          </div>
          <label>
            <span>demo url</span>
            <input type="text" inputmode="url" autocomplete="url" spellcheck="false" name="demo_url" required maxlength="300" value={entry.demo_url} disabled={state === 'locked'} />
          </label>
          <label>
            <span>github repo</span>
            <input type="text" inputmode="url" autocomplete="url" spellcheck="false" name="repo_url" required maxlength="300" value={entry.repo_url} disabled={state === 'locked'} />
            <span class="bge-hint">public repo · the commit history has to show the work happened inside the window</span>
          </label>
          <label>
            <span>what you built · optional, up to {BLURB_MAX} characters</span>
            <textarea name="blurb" maxlength={BLURB_MAX} rows="3" disabled={state === 'locked'}>{entry.blurb ?? ''}</textarea>
          </label>
          {state === 'editable' && (
            <div class="bge-actions">
              <button class="btn primary" type="submit">save changes</button>
              <a class="bge-back" href="/thebuildgames" target="_blank" rel="noopener">back to the games →</a>
            </div>
          )}
          <p class="bge-err" data-entry-err hidden></p>
          <p class="bge-ok" data-entry-ok hidden>saved.</p>
        </form>

        {justSubmitted && (
          <aside class="bge-rec">
            <span class="bge-rec-label">while you build · a recommendation</span>
            {/* Reciprocal partner arrangement: sponsored+nofollow so no link
                equity passes through the 302. The whole card is the one
                click target; the grid preview is the newsletter itself. */}
            <a class="bge-rec-card" href={`/api/thebuildgames/rec?to=howtoai`} target="_blank" rel="sponsored nofollow noopener">
              <img class="bge-rec-img" src="/thebuildgames/howtoai-grid.webp" alt="How to AI post grid" width="640" height="490" loading="lazy" />
              <span class="bge-rec-body">
                <span class="bge-rec-name">{HOWTOAI_REC.name}</span>
                <span class="bge-rec-line">{HOWTOAI_REC.line}</span>
                <span class="bge-rec-go">take a look →</span>
              </span>
            </a>
          </aside>
        )}
      </>
    )}
  </main>
</Base>

<script>
  // Save via fetch so validation errors land inline. Plain form post still
  // works without JS (the API answers JSON).
  const form = document.querySelector('[data-entry-edit-form]');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]');
      const err = document.querySelector('[data-entry-err]');
      const ok = document.querySelector('[data-entry-ok]');
      if (err) err.hidden = true;
      if (ok) ok.hidden = true;
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'saving…';
      }
      try {
        const data = Object.fromEntries(new FormData(form).entries());
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok) {
          if (err) {
            err.textContent = out.error || 'something broke · try again';
            err.hidden = false;
          }
          return;
        }
        if (ok) ok.hidden = false;
      } catch {
        if (err) {
          err.textContent = 'network hiccup · try again';
          err.hidden = false;
        }
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'save changes';
        }
      }
    });
  }
</script>

<style>
  .bge {
    max-width: 560px;
    padding-top: 56px;
    padding-bottom: 120px;
  }

  .bge h1 {
    font-size: 26px;
  }

  .bge-sub {
    padding-top: 10px;
    font-size: 14px;
    color: var(--muted);
    line-height: 1.7;
  }

  .bge-sub a {
    color: var(--primary);
  }

  .bge-form {
    margin-top: 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .bge-row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 14px;
  }

  @media (max-width: 520px) {
    .bge-row {
      grid-template-columns: 1fr;
    }
  }

  .bge-form label > span {
    display: block;
    padding-bottom: 6px;
    font: 12px var(--font-mono);
    color: var(--muted);
  }

  .bge-form input,
  .bge-form textarea {
    width: 100%;
    padding: 11px 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--fg);
    font: 14px var(--font-mono);
    resize: vertical;
    /* no ligatures in inputs — the mono :// ligature reads like an eaten
       slash while typing a URL (see the entry form) */
    font-variant-ligatures: none;
    font-feature-settings: 'liga' 0, 'calt' 0;
  }

  .bge-form input:disabled,
  .bge-form textarea:disabled {
    opacity: 0.6;
  }

  @media (max-width: 640px) {
    .bge-form input,
    .bge-form textarea {
      font-size: 16px;
    }
  }

  .bge-hint {
    display: block;
    padding-top: 6px;
    font: 11px var(--font-mono);
    color: var(--muted);
  }

  /* the handle field's fixed @ prefix — same treatment as the entry form */
  .bg-handle-wrap {
    position: relative;
    display: block;
  }

  .bg-handle-at {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    font: 14px var(--font-mono);
    color: var(--muted);
    pointer-events: none;
    line-height: 1;
  }

  .bg-handle-wrap input {
    padding-left: 27px;
  }

  @media (max-width: 640px) {
    .bg-handle-at {
      font-size: 16px;
    }

    .bg-handle-wrap input {
      padding-left: 30px;
    }
  }

  .bge-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 4px;
  }

  .bge-back {
    font: 12px var(--font-mono);
    color: var(--muted);
  }

  .bge-err {
    font-size: 13px;
    color: var(--no-bg, #e5484d);
  }

  .bge-ok {
    font-size: 13px;
    color: var(--primary);
  }

  /* the one recommendation card — plainly labelled, plainly not an ad wall */
  .bge-rec {
    margin-top: 40px;
  }

  .bge-rec-label {
    display: block;
    padding-bottom: 8px;
    font: 11px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .bge-rec-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    text-decoration: none;
    color: var(--fg);
    overflow: hidden;
    transition: border-color 0.18s ease, background 0.18s ease;
  }

  .bge-rec-card:hover {
    border-color: color-mix(in srgb, var(--primary) 55%, var(--border));
    background: color-mix(in srgb, var(--primary) 4%, var(--surface));
  }

  /* the newsletter's own post grid, full-bleed on top of the card */
  .bge-rec-img {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 1px solid var(--border);
  }

  .bge-rec-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 18px 16px;
  }

  .bge-rec-name {
    font-weight: 700;
    font-size: 15px;
  }

  .bge-rec-line {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.5;
  }

  .bge-rec-go {
    padding-top: 4px;
    font: 12px var(--font-mono);
    color: var(--primary);
  }
</style>
