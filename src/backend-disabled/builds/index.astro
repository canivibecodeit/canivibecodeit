---
// /builds: every live community build, newest first, failures welcome.
// Flag-gated: 404s (and stays out of nav/sitemap) until BUILDS_LIVE is set.
import Base from '../../layouts/Base.astro';
import { buildsLive } from '../../lib/flags.js';
import { liveBuilds, buildUserNames } from '../../lib/db.js';
import { getApp } from '../../lib/apps.js';
import BuildRow from '../../components/BuildRow.astro';
import { GOES } from '../../lib/builds.js';
import { SHOWCASE_MODELS, modelSlug } from '../../lib/models.js';

if (!buildsLive()) return new Response(null, { status: 404 });

// liveBuilds comes back newest first; the feed is flat, no ranking to game.
const all = await liveBuilds();
const names = await buildUserNames(all.map((b) => b.user_id));

// Filters are plain query params so every state has a URL.
const q = Astro.url.searchParams;
const goesFilter = Object.hasOwn(GOES, q.get('goes') ?? '') ? q.get('goes') : null;
// Model filter: canonical slug, so 'Fable 5.1' / 'Claude Fable 5.1' /
// 'claude-fable-5.1' all land in the same bucket.
const modelFilter = modelSlug((q.get('model') ?? '').slice(0, 60)) || null;
const appFilter = q.get('app') && getApp(q.get('app')) ? q.get('app') : null;

const filtered = all.filter((b) => {
  if (goesFilter && b.goes !== goesFilter) return false;
  if (modelFilter && modelSlug(b.model_norm ?? b.model) !== modelFilter) return false;
  if (appFilter && b.app_slug !== appFilter) return false;
  return true;
});

// Pagination: the list must not grow without bound.
const PER_PAGE = 20;
const pageCount = Math.max(1, Math.ceil(filtered.length / PER_PAGE));
const pageNum = Math.min(pageCount, Math.max(1, parseInt(q.get('page') ?? '1', 10) || 1));
const rows = filtered.slice((pageNum - 1) * PER_PAGE, pageNum * PER_PAGE);

// Filter on the normalized key, display the name as the maker typed it
// (first spelling seen wins; the typeahead makes those consistent).
const modelLabels = new Map();
for (const b of all) {
  const key = modelSlug(b.model_norm ?? b.model);
  if (key && !modelLabels.has(key)) modelLabels.set(key, b.model);
}
const models = [...modelLabels.keys()].sort();

// Stat band: totals over everything live, not the filtered view.
const oneGo = all.filter((b) => b.goes === 'one').length;
const failures = all.filter((b) => b.goes === 'never').length;
const replacedSlugs = [...new Set(all.map((b) => b.app_slug).filter(Boolean))];
const replacedPerMo = Math.round(
  replacedSlugs.reduce((sum, slug) => sum + (getApp(slug)?.priceMonthly ?? 0), 0)
);

const rowApp = (b) => (b.app_slug ? getApp(b.app_slug) : null);

const href = (over = {}) => {
  const p = new URLSearchParams();
  const goes = 'goes' in over ? over.goes : goesFilter;
  const model = 'model' in over ? over.model : modelFilter;
  const page = over.page ?? null;
  if (goes) p.set('goes', goes);
  if (model) p.set('model', model);
  if (appFilter) p.set('app', appFilter);
  if (page && page > 1) p.set('page', String(page));
  const s = p.toString();
  return `/builds${s ? `?${s}` : ''}`;
};
---

<Base
  title="Builds · vibecodeit"
  description="What people actually built with AI coding agents, with the exact prompts that made it. Newest first, failures welcome."
>
  <main class="wrap bd-index">
    <h1>Builds</h1>
    <p class="bd-sub">
      what people vibe coded, with the prompts that made it. newest first, failures welcome.
    </p>
    {SHOWCASE_MODELS.length > 0 && (
      <p class="bd-showcase-link">
        {SHOWCASE_MODELS.map((m) => (
          <a href={`/built-with/${m.slug}`}>built with {m.name} →</a>
        ))}
      </p>
    )}

    <div class="bd-stats">
      <div class="bd-stat">
        <b>{all.length}</b>
        <span class="bd-label">builds</span>
      </div>
      <div class="bd-stat">
        <b>{oneGo}</b>
        <span class="bd-label">said one shot</span>
      </div>
      <div class="bd-stat">
        <b>{failures}</b>
        <span class="bd-label">never got there</span>
      </div>
      <div class="bd-stat">
        <b>${replacedPerMo}/mo</b>
        <span class="bd-label">saas replaced</span>
      </div>
    </div>

    <div class="bd-filter">
      <a class:list={['chip', 'bd-chip', { active: !goesFilter }]} href={href({ goes: null })}>all</a>
      {
        Object.entries(GOES).map(([key, label]) => (
          <a class:list={['chip', 'bd-chip', { active: goesFilter === key }]} href={href({ goes: key })}>{label}</a>
        ))
      }
      {
        models.length > 0 && (
          <div class="bd-model" data-bd-model>
            <button
              class:list={['chip', 'bd-chip', 'bd-model-btn', { active: !!modelFilter }]}
              type="button"
              aria-haspopup="listbox"
              aria-expanded="false"
            >
              {modelFilter ? `model: ${modelLabels.get(modelFilter) ?? modelFilter}` : 'model: any'}
              <svg width="8" height="5" viewBox="0 0 8 5" aria-hidden="true"><path d="M.5.5 4 4 7.5.5" fill="none" stroke="currentColor"></path></svg>
            </button>
            <div class="bd-model-pop" hidden>
              <div class="bd-model-search">
                <svg width="13" height="13" viewBox="0 0 14 14" aria-hidden="true"><circle cx="6" cy="6" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M9.5 9.5 L13 13" stroke="currentColor" stroke-width="1.5"></path></svg>
                <input type="text" placeholder="type to filter" aria-label="filter models" autocomplete="off" />
              </div>
              <div class="bd-model-list" role="listbox">
                <a class:list={['bd-model-opt', { on: !modelFilter }]} href={href({ model: null })} role="option" aria-selected={!modelFilter}>any model</a>
                {models.map((m) => (
                  <a class:list={['bd-model-opt', { on: m === modelFilter }]} href={href({ model: m })} role="option" aria-selected={m === modelFilter}>{modelLabels.get(m)}</a>
                ))}
              </div>
            </div>
          </div>
        )
      }
      <span class="bd-filter-gap"></span>
      <a class="btn primary bd-post-btn" href="/post-a-build">post your build</a>
    </div>

    {
      appFilter && (
        <p class="bd-appnote">
          builds taking on <a href={`/${appFilter}`}>{getApp(appFilter).name}</a> ·{' '}
          <a href="/builds">everything →</a>
        </p>
      )
    }

    <div class="bd-rows">
      {rows.map((b) => <BuildRow build={b} {names} app={rowApp(b)} />)}
      {
        rows.length === 0 && (
          <p class="bd-empty">
            {goesFilter || modelFilter || appFilter ? 'nothing here yet under that filter.' : 'nothing here yet.'}{' '}
            <a href="/post-a-build">yours could be first →</a>
          </p>
        )
      }
    </div>

    {
      pageCount > 1 && (
        <nav class="bd-pages" aria-label="Pages">
          {pageNum > 1 && <a class="chip bd-chip" href={href({ page: pageNum - 1 })}>← newer</a>}
          <span>page {pageNum} of {pageCount}</span>
          {pageNum < pageCount && <a class="chip bd-chip" href={href({ page: pageNum + 1 })}>older →</a>}
        </nav>
      )
    }

    <p class="bd-honesty">
      every build here is what its maker told us · we check that the links load, that's all.
    </p>
  </main>
</Base>

<script is:inline src={`/js/builds.js?v=${__BUILD_ID__}`} defer></script>

<style>
  .bd-index {
    padding-top: 48px;
  }

  .bd-index h1 {
    font-size: clamp(32px, 5vw, 44px);
  }

  .bd-sub {
    padding-top: 12px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
    max-width: 70ch;
  }

  .bd-index .bd-stats {
    padding-top: 26px;
  }

  .bd-filter {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 26px;
    padding-bottom: 20px;
  }

  .bd-filter-gap {
    flex: 1;
  }

  /* A real button, deliberately NOT badge-sized: the green chips on this
     page are labels, and the one clickable green thing must not read as one. */
  .bd-post-btn {
    font-weight: 500;
  }

  .bd-model {
    position: relative;
  }

  .bd-model-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    cursor: pointer;
  }

  .bd-model-btn svg {
    flex-shrink: 0;
  }

  .bd-model-pop {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 40;
    width: 240px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .bd-model-pop[hidden] {
    display: none;
  }

  .bd-model-search {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 0 12px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
  }

  .bd-model-search input {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    outline: none;
    color: var(--fg);
    font: 13px var(--font-mono);
    padding: 10px 0;
  }

  .bd-model-search input::placeholder {
    color: var(--muted);
    opacity: 0.65;
  }

  .bd-model-list {
    max-height: 240px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .bd-model-list::-webkit-scrollbar {
    width: 8px;
  }

  .bd-model-list::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 6px;
  }

  .bd-model-opt {
    display: block;
    padding: 8px 12px;
    font: 13px var(--font-mono);
    color: var(--fg);
  }

  .bd-model-opt:hover {
    background: var(--surface-2);
  }

  .bd-model-opt.on {
    color: var(--primary);
  }

  .bd-model-opt[hidden] {
    display: none;
  }

  .bd-showcase-link {
    padding-top: 10px;
    font: 13px var(--font-mono);
  }

  .bd-showcase-link a {
    color: var(--primary);
  }

  /* On a phone a long active model label can push the post button onto a
     third chip row; give it a full row of its own instead. */
  @media (max-width: 420px) {
    .bd-post-btn {
      flex-basis: 100%;
      justify-content: center;
    }
  }

  .bd-appnote {
    padding-bottom: 14px;
    font-size: 13px;
    color: var(--muted);
  }

  .bd-appnote a {
    color: var(--primary);
  }

  .bd-empty {
    /* Side padding matches the rows', so the text sits on the page grid
       despite the list's -14px pull. */
    padding: 28px 14px;
    font-size: 14px;
    color: var(--muted);
  }

  .bd-empty a {
    color: var(--primary);
  }

  .bd-pages {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 20px;
    font-size: 12px;
    color: var(--muted);
  }

  .bd-honesty {
    margin-top: 44px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
