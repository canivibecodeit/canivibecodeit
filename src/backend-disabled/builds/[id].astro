---
// /builds/<one segment>: two tenants share this slot.
// - b_<id>: internal-id fallback -> 301 to the canonical pretty URL. Same
//   visibility bar as everywhere: live for everyone, pending never confirmed
//   to anyone but its owner.
// - anything else: a maker handle -> their public profile, every live build
//   they've posted. This is the page maker names link to.
import Base from '../../layouts/Base.astro';
import MakerIcon from '../../components/MakerIcon.astro';
import BuildRow from '../../components/BuildRow.astro';
import { buildById, buildUserNames, liveBuilds, userByHandle } from '../../lib/db.js';
import { buildsLive } from '../../lib/flags.js';
import { getApp } from '../../lib/apps.js';
import { BUILD_ID_RE, HANDLE_RE, buildHref } from '../../lib/builds.js';

if (!buildsLive()) return new Response(null, { status: 404 });

const { id } = Astro.params;

if (BUILD_ID_RE.test(id ?? '')) {
  const build = await buildById(id);
  if (!build) return new Response(null, { status: 404 });
  const viewer = Astro.locals.user ?? null;
  const ownerPreview = build.status === 'pending' && viewer?.id === build.user_id;
  if (build.status !== 'live' && !ownerPreview) return new Response(null, { status: 404 });
  const names = await buildUserNames([build.user_id]);
  const target = buildHref(names, build);
  if (target === `/builds/${build.id}`) return new Response(null, { status: 404 });
  return Astro.redirect(target, 301);
}

if (!HANDLE_RE.test(id ?? '')) return new Response(null, { status: 404 });
const maker = await userByHandle(id);
if (!maker?.handle) return new Response(null, { status: 404 });

const builds = (await liveBuilds()).filter((b) => b.user_id === maker.id);
const names = new Map([[maker.id, { name: maker.name, handle: maker.handle }]]);

const replacedPerMo = Math.round(
  [...new Set(builds.map((b) => b.app_slug).filter(Boolean))].reduce(
    (sum, slug) => sum + (getApp(slug)?.priceMonthly ?? 0),
    0
  )
);
---

<Base
  title={`${maker.handle} · builds · vibecodeit`}
  description={`Everything ${maker.handle} vibe coded, with the prompts that made it.`}
>
  <main class="wrap mk-page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/builds">builds</a> / <span class="here">{maker.handle}</span>
    </nav>

    <div class="mk-head">
      <MakerIcon handle={maker.handle} size={64} />
      <div class="mk-id">
        <h1>{maker.handle}</h1>
        <p class="mk-meta">
          {builds.length} build{builds.length === 1 ? '' : 's'}
          {replacedPerMo > 0 && ` · takes on $${replacedPerMo}/mo of saas`}
        </p>
      </div>
    </div>

    <div class="bd-rows" style="margin-top: 26px;">
      {builds.map((b) => <BuildRow build={b} {names} app={b.app_slug ? getApp(b.app_slug) : null} showBy={false} priceWord="takes on" />)}
      {builds.length === 0 && <p class="mk-empty">nothing live yet.</p>}
    </div>

    <p class="mk-honesty">
      every build here is what its maker told us · we check that the links load, that's all.
    </p>
  </main>
</Base>

<style>
  /* No wrapper padding-top: the global .crumbs already carries the 40px
     page-top rhythm, and every /builds surface must start at the same Y. */
  .mk-page {
    padding-bottom: 90px;
  }

  .mk-head {
    display: flex;
    align-items: center;
    gap: 18px;
    padding-top: 20px;
  }

  .mk-head :global(.maker-icon) {
    border-radius: 12px;
    flex-shrink: 0;
  }

  .mk-id h1 {
    font-size: clamp(28px, 4.5vw, 40px);
  }

  .mk-meta {
    padding-top: 6px;
    font-size: 14px;
    color: var(--muted);
  }

  .mk-empty {
    padding: 28px 0;
    font-size: 14px;
    color: var(--muted);
  }

  .mk-honesty {
    margin-top: 44px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
