---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import DigestBar from '../components/DigestBar.astro';
import Radio from '../components/Radio.astro';
import SignupModal from '../components/SignupModal.astro';
import SponsorRails from '../components/SponsorRails.astro';
import SponsorTape from '../components/SponsorTape.astro';
import { buildGamesLive, buildsLive } from '../lib/flags.js';
import { getBoard, nextRunMonthName } from '../lib/sponsors.js';
import { scriptJson } from '../lib/request.js';
import { REC_HIDE_SCRIPT, THEME_SCRIPT } from '../lib/csp.js';

// Next-month pre-book count for the footer link. Board is cached, so this
// costs the layout nothing extra; the month names itself.
const septBoard = await getBoard();
const septLeft = septBoard.slots.length - septBoard.prebookedCount;
const prebookLabel = nextRunMonthName();

// socialTitle lets a page rank under one <title> while share cards keep
// another (og/twitter). Defaults to the same string.
const {
  title,
  description,
  ogImage = '/og/home.png',
  jsonld = [],
  socialTitle = Astro.props.title,
  // Surfaces with their own sponsor system (The Build Games) suppress the
  // sitewide sponsor rails/tape so the two don't clash.
  hideSponsors = false,
  // Pages with their OWN email capture suppress the sticky digest bar too —
  // one page, one ask (and on mobile the bar overlapped the inline form).
  hideDigest = false,
} = Astro.props;

const user = Astro.locals.user ?? null;
const userInitial = (user?.name || user?.email || '?').trim().charAt(0).toUpperCase();

const canonical = new URL(Astro.url.pathname, 'https://vibecodeit.com').href;
// Pages whose URL carries a token: they stay out of the index, and out of
// analytics, because $current_url would otherwise record the token. Any URL
// carrying a token counts, including the 404s a case-variant path produces.
const isPrivate =
  Astro.url.pathname.startsWith('/admin') ||
  Astro.url.pathname.startsWith('/sponsor/details') ||
  Astro.url.pathname.startsWith('/thebuildgames/details') ||
  Astro.url.pathname.startsWith('/thebuildgames/entry') ||
  Astro.url.pathname.startsWith('/sponsor/stats') ||
  Astro.url.pathname.startsWith('/account') ||
  Astro.url.search.includes('token=');
// noindex without going full private (keeps analytics): /signin wants this.
const { noindex = false } = Astro.props;
// Version query = cache-buster: OG images are regenerated in place, and a
// cached miss (or stale card) at any edge must never outlive a deploy.
const ogUrl = new URL(`${ogImage}?v=${__BUILD_ID__}`, 'https://vibecodeit.com').href;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Vibecode It?',
  url: 'https://vibecodeit.com',
  logo: 'https://vibecodeit.com/logo-512.png',
};

const blocks = [orgLd, ...jsonld];

/* One list, two renderings — the header shows only `top` items (the pages
   that make money or grow the directory, per the operator's nav thinning),
   the footer shows every section so nothing is stranded when the header
   hides its links on narrow viewports. Edit THIS list, never the markup:
   the two navs must not drift apart again. */
// The builder-game route (/challenge) is deliberately UNLINKED — it stays dark
// until Sept 1 and is never in the nav (ruling G1). /thebuildgames joined the
// nav for the games launch (operator brief, Aug 31) — accent-highlighted.
const SECTIONS = [
  { href: '/#death-list', label: 'the death list', top: true },
  { href: '/thebuildgames', label: 'the build games', top: true, cls: 'nav-games', show: buildGamesLive() },
  { href: '/alternatives', label: 'alternatives', top: true },
  { href: '/builds', label: 'builds', top: false, show: buildsLive() },
  { href: '/stats', label: 'stats', top: false },
  { href: '/newsletter', label: 'newsletter', top: false, footerLabel: 'the newsletter' },
  { href: '/submit', label: 'submit an app', top: true, cls: 'nav-submit' },
  { href: '/sponsor', label: 'sponsor', top: true },
];
const navSections = SECTIONS.filter((s) => s.show !== false);
const headerLinks = navSections.filter((s) => s.top);
---

<!doctype html>
{/* animate=none: soft navigation for the persistent radio, but no cross-fade,
    so page changes stay as instant as the old full loads */}
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(isPrivate || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo-512.png" />
    <meta name="theme-color" content="#0b0d0b" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vibecode It?" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {blocks.map((b) => <script type="application/ld+json" set:html={scriptJson(b)} />)}

    <!-- theme before first paint: stored choice wins, else system preference.
         The script text lives in lib/csp.js because the CSP header allows
         exactly this string by hash; edit it THERE, never here. -->
    <script is:inline set:html={THEME_SCRIPT} />
    {/* Referrer-aware hide for the How to AI placements; text lives in
        lib/csp.js next to its hash, same rule as the theme script. */}
    <script is:inline set:html={REC_HIDE_SCRIPT} />
    {!isPrivate && <script is:inline src="/analytics.js" defer></script>}
    <ClientRouter />
  </head>
  <body data-user={user ? '1' : undefined} class:list={[{ 'no-tape': hideSponsors }]}>
    {!hideSponsors && <SponsorTape side="left" />}
    <header class="site-header">
      <div class="inner">
        <a class="brand" href="/" aria-label="Vibecode It? home">
          <svg class="mark" viewBox="0 0 64 64" aria-hidden="true">
            <rect x="3" y="3" width="58" height="58" rx="13" fill="none" stroke="var(--primary)" stroke-width="5"></rect>
            <text x="21" y="45" font-family="JetBrains Mono Variable, monospace" font-size="34" font-weight="700" fill="var(--primary)" text-anchor="middle">?</text>
            <rect x="34" y="20" width="9" height="25" fill="var(--primary)"></rect>
          </svg>
          <span class="word">vibecode<b>it</b></span>
        </a>
        <nav class="site-nav">
          {headerLinks.map((s) => <a class={s.cls} href={s.href}>{s.label}</a>)}
          {
            user ? (
              <a class="avatar-chip" href="/account" aria-label="your account" title="your account">{userInitial}</a>
            ) : (
              <>
                <a class="signin" href="/signin" data-signin>sign in</a>
                <a class="signin-chip" href="/signin" data-signin aria-label="sign in">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><circle cx="6" cy="4" r="2.2" stroke="currentColor" stroke-width="1.3"></circle><path d="M1.8 10.6C2.4 8.7 4 7.6 6 7.6C8 7.6 9.6 8.7 10.2 10.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
                </a>
              </>
            )
          }
          <button
            class="theme-toggle"
            aria-label="Toggle light or dark theme"
            data-toggle-theme
          >
            <svg class="moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
            <svg class="sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"></path></svg>
          </button>
          <Radio />
        </nav>
      </div>
    </header>

    <slot />

    {!hideSponsors && <SponsorRails />}

    <footer class="site-footer">
      {/* Sitewide section links. The header hides most of these on narrow
          viewports (and "submit an app" in the rail-squeezed band), so this
          row is the guaranteed path to every section from every page. */}
      <nav class="inner footer-nav" aria-label="Site sections">
        {navSections.map((s) => <a href={s.href}>{s.footerLabel ?? s.label}</a>)}
      </nav>
      <div class="inner">
      <span>
        Yes, you can vibecode this site too.&ensp;<a href="/vibecode-this-site">Here's the prompt</a>&ensp;·&ensp;<a href="https://github.com/vibecodeit/vibecodeit">Source on GitHub</a>
      </span>
      <span class="built-by">
        by <a href="mailto:hello@vibecodeit.com">Faizan Ali</a>
        · based on <a href="https://canivibecodeit.com">Can I Vibecode It?</a> by <a href="https://x.com/robj3d3">Rob Hallam</a>
      </span>
      <span>
        MIT · no third-party trackers · <a href="/privacy">privacy</a> · <a href="/terms">terms</a> · <a href="/sponsor">pre-book {prebookLabel}{septBoard.prebookedCount > 0 ? ` · ${septLeft} of ${septBoard.slots.length} left` : ''}</a>
      </span>
      </div>
    </footer>

    {!hideSponsors && (
      <>
        <div class="sp-tape-spacer"></div>
        <SponsorTape side="right" />
      </>
    )}
    {!hideDigest && <DigestBar />}

    {!user && <SignupModal />}

    {/* Co-reg card shown after a successful newsletter signup (cloned by
        app.js). No checkbox, nothing automatic: one button, one no-thanks. */}
    <template id="rec-coreg-tpl">
      <aside class="rec-coreg" data-hide-for-ruben data-rec-coreg>
        <img class="rec-coreg-img" src="/thebuildgames/howtoai-grid.webp" alt="How to AI post grid" width="640" height="490" loading="lazy" />
        <div class="rec-coreg-body">
          <span class="rec-eyebrow">one more, free</span>
          <b class="rec-coreg-title">How to AI by Ruben Hassid</b>
          <p class="rec-coreg-text">the newsletter 890k people use to get better at AI. one tap, your email is already filled in.</p>
          <div class="rec-coreg-actions">
            <a class="btn primary rec-coreg-go" href="/api/rec/howtoai?src=coreg_digest" target="_blank" rel="sponsored nofollow noopener" data-rec-coreg-go>get How to AI</a>
            <button class="rec-coreg-no" type="button" data-rec-coreg-no>no thanks</button>
          </div>
        </div>
      </aside>
    </template>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script src={`/js/app.js?v=${__BUILD_ID__}`} defer></script>
  </body>
</html>
