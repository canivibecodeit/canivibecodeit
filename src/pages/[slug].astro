---
import Base from '../layouts/Base.astro';
import VerdictBadge from '../components/VerdictBadge.astro';
import DigestCard from '../components/DigestCard.astro';
import DigestReveal from '../components/DigestReveal.astro';
import AltCard from '../components/AltCard.astro';
import RecModule from '../components/RecModule.astro';
import BuildsSection from '../components/BuildsSection.astro';
import { getApp, relatedApps, yearlySaving, sortedAlternatives, ALTERNATIVES_PAGE_MIN, CATEGORIES, VERDICTS, MOAT_TAGS, MOAT_TAG_EMOJI, VIBE_CODING_TOOL_SLUGS } from '../lib/apps.js';
import { stackSlugs, voteCount, voteCounts } from '../lib/db.js';

const { slug } = Astro.params;
const app = getApp(slug);
if (!app) return new Response(null, { status: 404 });

const user = Astro.locals.user ?? null;
const inStack = user ? (await stackSlugs(user.id)).includes(app.slug) : false;

const votes = await voteCount(app.slug);
const related = relatedApps(app, await voteCounts());
const cat = CATEGORIES[app.category];
const v = VERDICTS[app.verdict];
const saving = yearlySaving(app);

const moats = (app.moatTags ?? [])
  .filter((t) => MOAT_TAGS[t])
  .map((t) => ({ tag: t, label: MOAT_TAGS[t], emoji: MOAT_TAG_EMOJI[t] }));

const alternatives = sortedAlternatives(app);
const hasAltPage = alternatives.length >= ALTERNATIVES_PAGE_MIN;

const verdictWord = { yes: 'YES', kinda: 'KINDA', no: 'NOT REALLY' }[app.verdict];
const baseName = app.name.split(' / ')[0];
// Optional death notice: a sentence fragment that composes as "{name} {discontinued}."
// Set on apps whose product is gone; the page stays up as the post-mortem.
const discontinued = typeof app.discontinued === 'string' ? app.discontinued : null;
const priceLine =
  app.priceMonthly != null ? `costs $${app.priceMonthly}/mo ($${saving}/yr)` : 'has usage-based pricing';
const brandTitle = `Vibecode ${app.name} · ${verdictWord} · replace it with one AI prompt`;
const brandDescription = discontinued
  ? `${app.name} ${discontinued}. ${verdictWord} on vibecoding a replacement: what an AI agent can rebuild today, and the exact prompt.`
  : `${verdictWord}: ${app.name} ${priceLine}. ${
      app.verdict === 'no'
        ? "Here's why it survives vibecoding."
        : `Here's the exact prompt to build your own and what you lose.`
    }`;

// Pages with structured free-tier data lead with pricing in the <title>/meta;
// share cards keep the brand title via socialTitle. The H1 never changes.
const freeTier = typeof app.pricing?.freeTier === 'string' ? app.pricing.freeTier : null;
const pricingLed = freeTier != null && app.priceMonthly != null;

// Researched tier block (all tiers + caps + billing facts, live-verified).
// Its presence upgrades the pricing section to a full table; the pricing-led
// <title> stays gated on freeTier (that rollout has its own read date).
const tiers = !discontinued && Array.isArray(app.pricing?.tiers) ? app.pricing.tiers : null;
const tierPrice = (usd, per) => {
  if (usd == null) return null;
  const n = usd % 1 === 0 ? usd : usd.toFixed(2);
  return `$${n}${per === 'user' ? '/user' : per === 'workspace' ? '/workspace' : ''}`;
};
const title = pricingLed
  ? `${baseName} pricing ${new Date().getFullYear()}: plans, free tier, and our verdict`
  : brandTitle;
const description = pricingLed
  ? `${baseName} costs $${app.priceMonthly}/mo. ${freeTier} Our verdict: ${verdictWord}: what an AI agent can rebuild today, the exact prompt, and what's one prompt away from free.`
  : brandDescription;

const faq = [
  ...(pricingLed
    ? [
        {
          q: `Is ${baseName} free?`,
          a: `${freeTier} Paid is ${app.pricing?.plan || 'the paid plan'} at $${app.priceMonthly}/mo${
            app.pricing?.checkedOn ? ` (checked ${app.pricing.checkedOn})` : ''
          }.`,
        },
      ]
    : []),
  {
    q: `Vibecode ${app.name}`,
    a:
      app.verdict === 'yes'
        ? `Yes. A competent AI coding agent (Claude Code, Codex, Cursor) can build a usable personal ${app.name} replacement in one session with the prompt on this page. It runs on your own machine or server with no subscription.`
        : app.verdict === 'kinda'
          ? `Kinda. The core of ${app.name} is buildable in a weekend with the prompt on this page, but there are real gaps: ${app.whatYouLose.slice(0, 2).join(', ')}. Read the honest list above before committing.`
          : `Not really. ${app.name}'s value is not the code: ${app.notes.split('.')[1]?.trim() ?? 'the moat survives one prompt'}. See the honest breakdown above.`,
  },
  {
    q: `How much does ${app.name} cost?`,
    a: discontinued
      ? `Nothing anymore: ${app.name} ${discontinued}.${
          app.priceMonthly != null ? ` Before that it ran about $${app.priceMonthly}/month.` : ''
        }`
      : app.priceMonthly != null
        ? `${app.name} costs about $${app.priceMonthly}/month (${app.pricing?.plan || 'paid plan'}${
            app.pricing?.checkedOn ? `, checked ${app.pricing.checkedOn}` : ''
          }), which is $${saving} per year. ${
            app.verdict === 'yes' ? `That's what you save by replacing it with one prompt.` : ''
          }`
        : `${app.name}'s pricing is usage-based or varies by plan${
            app.pricing?.notes ? ` · ${app.pricing.notes}` : ''
          }.`,
  },
  {
    q: `What do I lose by replacing ${app.name}?`,
    a: `Honestly: ${app.whatYouLose.join('; ')}. ${
      discontinued
        ? "Since the product is gone, these gaps are now everyone's problem."
        : 'If any of those are load-bearing for you, keep paying.'
    }`,
  },
  {
    q: `Is there an open-source alternative to ${app.name}?`,
    a:
      alternatives.length > 0
        ? `Yes: ${alternatives.slice(0, 3).map((p) => `${p.name} (${p.desc})`).join(' ')} ${
            hasAltPage ? `All ${alternatives.length} curated free alternatives are at vibecodeit.com/${app.slug}/alternatives.` : ''
          } The prompt is for when you want it exactly your way.`
        : app.priorArt.length > 0
          ? `Yes: ${app.priorArt.map((p) => `${p.name} (${p.desc})`).join(', ')}. Using prior art is also vibecoding; the prompt is for when you want it exactly your way.`
          : `No mature open-source alternative worth pointing at, which is exactly why the one-shot prompt on this page exists.`,
  },
];

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'The Death List', item: 'https://vibecodeit.com/' },
      { '@type': 'ListItem', position: 2, name: cat.label, item: `https://vibecodeit.com/category/${app.category}` },
      { '@type': 'ListItem', position: 3, name: app.name, item: `https://vibecodeit.com/${app.slug}` },
    ],
  },
];

const requirementLines = (app.requirements ?? []).map((item) => `- ${item}`).join('\n') || '- Implement the core workflow described in the build brief.';
const lossLines = (app.whatYouLose ?? []).map((item) => `- ${item}`).join('\n') || '- None documented.';
const makeBundle = (mode, files) => `You are building a ${mode} version of ${baseName}.

Create the following project files first, then implement the application by following them. Keep the files updated as decisions change. Do not collapse this into a single README or prompt.

${files.map((file) => `===== ${file.path} =====\n${file.content}`).join('\n\n')}`;

const indieFiles = [
  {
    path: 'README.md',
    content: `# ${baseName} indie build

## Goal

Build the smallest trustworthy replacement for the core ${baseName} workflow for one developer or a tiny team.

## Scope

${app.coreLoopDIY || app.verdictSummary || `Rebuild the useful core of ${baseName}.`}

## Quick start

1. Install the documented dependencies.
2. Copy \`.env.example\` to \`.env\`.
3. Run the development command chosen during implementation.
4. Complete the acceptance checks in \`BUILD_PLAN.md\`.

## Honest limits

This build deliberately does not replace:
${lossLines}

If those capabilities are essential, use ${app.priorArt?.[0]?.name || alternatives?.[0]?.name || baseName} instead of pretending the gap is solved.`,
  },
  {
    path: 'AGENTS.md',
    content: `# Agent instructions

- Optimize for a working, understandable weekend build.
- Prefer the fewest moving parts that satisfy the brief.
- Do not invent cryptography, security guarantees, APIs, or compliance claims.
- Keep secrets out of source control and logs.
- Add focused tests for destructive, security-sensitive, and data-loss paths.
- Run the project checks before declaring the build complete.
- Record any deliberate shortcut in the README under "Tradeoffs".`,
  },
  {
    path: 'BUILD_PLAN.md',
    content: `# Build plan

## Original build brief

${app.prompt}

## Required capabilities

${requirementLines}

## Delivery order

1. Scaffold the smallest runnable application and document its commands.
2. Implement the primary data model and core workflow.
3. Add validation, safe failure states, and persistence.
4. Cover the critical path with automated tests.
5. Exercise a clean install from the README and fix every missing step.

## Done when

- A new user can go from clone to first successful workflow using only the README.
- The core workflow works without paid infrastructure unless the brief requires it.
- Tests cover the highest-risk behavior.
- Known limitations are explicit rather than hidden.`,
  },
  {
    path: '.env.example',
    content: `# Copy to .env and document every variable when it is introduced.
# Never put real credentials in this file.

APP_ENV=development
# Add only values required by the selected implementation.`,
  },
];

const productFiles = [
  {
    path: 'PRODUCT.md',
    content: `# ${baseName} product brief

## Problem

${app.verdictSummary || app.notes}

## Product outcome

${app.coreLoopDIY || `Deliver a trustworthy replacement for the core ${baseName} workflow.`}

## Target user

A serious builder who needs a maintainable product foundation rather than a one-off demo.

## Required capabilities

${requirementLines}

## Explicit non-goals for v1

${lossLines}

## Success criteria

- The primary workflow is measurable end to end.
- Setup is reproducible in a clean environment.
- Failure, recovery, and support paths are documented.
- Product claims match what the implementation actually guarantees.`,
  },
  {
    path: 'ARCHITECTURE.md',
    content: `# Architecture

## Starting brief

${app.prompt}

## Boundaries

Separate the product into replaceable modules for interface, application logic, persistence, external integrations, and operational concerns. Keep domain logic independent from delivery frameworks and vendors.

## Production baseline

- Configuration: validated at startup with safe local defaults where possible.
- Security: least privilege, input validation, secret redaction, rate limits on abuse-prone paths, and no invented security primitives.
- Data: explicit schema and migrations, transactional writes where integrity matters, backup and restore instructions.
- Integrations: adapters around third-party providers, idempotent webhook or job processing, bounded retries, and timeouts.
- Observability: structured logs with request or operation IDs, an error-tracking hook, and health/readiness checks where a server exists.
- Quality: unit tests for domain rules, integration tests at module boundaries, and one end-to-end critical-path test.

## Decision records

For each major dependency, document why it was chosen, its failure mode, and how it can be replaced. Do not introduce infrastructure until a requirement justifies it.`,
  },
  {
    path: 'AGENTS.md',
    content: `# Agent instructions

- Read \`PRODUCT.md\` and \`ARCHITECTURE.md\` before changing code.
- Implement milestone by milestone; keep each change reviewable and leave the application runnable.
- Treat authentication, payments, encryption, imports, webhooks, and destructive actions as high-risk boundaries when present.
- Never invent cryptography or silently weaken a requirement to make a test pass.
- Use provider interfaces for external services and deterministic fakes in tests.
- Add migrations and rollback or recovery notes for persistent data changes.
- Log useful operational context without credentials, tokens, passwords, or personal data.
- Update documentation and run all checks before completing a milestone.`,
  },
  {
    path: 'MILESTONES.md',
    content: `# Delivery milestones

## M0 — Decisions and scaffold

- Confirm the runtime, persistence model, threat boundaries, and deployment target.
- Create a reproducible local environment and continuous checks.

## M1 — Core workflow

- Implement the smallest end-to-end product path with validation and tests.
- Keep integrations behind interfaces.

## M2 — Trust layer

- Add secure failure behavior, recovery paths, audit-relevant events, and data safeguards.
- Test abuse cases and destructive operations.

## M3 — Operability

- Add structured logs, error reporting hooks, health signals, backup/restore documentation, and deployment configuration.

## M4 — Release gate

- Run a clean-install test, critical-path end-to-end test, dependency review, and documented rollback exercise.
- Compare the shipped behavior with \`PRODUCT.md\` and publish remaining limitations.`,
  },
  {
    path: 'OPERATIONS.md',
    content: `# Operations

## Before release

- Validate configuration and secrets at startup.
- Define backup, restore, and rollback procedures and test them.
- Document logs, error tracking, health signals, and alert ownership.
- Set dependency update and vulnerability review expectations.

## Incident checklist

1. Contain the issue without destroying evidence or user data.
2. Record the timeline and affected scope.
3. Rotate exposed secrets and revoke compromised sessions or credentials.
4. Restore from a verified source when needed.
5. Document the root cause, remediation, and regression test.

## Launch constraint

Do not market omitted ${baseName} capabilities as implemented. The v1 non-goals in \`PRODUCT.md\` remain user-visible limitations until they are deliberately delivered.`,
  },
];

const indieBundle = makeBundle('lean indie', indieFiles);
const productBundle = makeBundle('production product', productFiles);

const priceTag = app.priceMonthly != null ? ` ($${app.priceMonthly}/mo)` : '';
const tweet = encodeURIComponent(
  `I just replaced ${app.name}${priceTag} with one prompt → vibecodeit.com/${app.slug}`
);
---

<Base {title} {description} socialTitle={brandTitle} ogImage={`/og/${app.slug}.png`} {jsonld}>
  <main class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      {/* one line: the compiler strips the newline after "/", eating the space */}
      <a href="/">the death list</a> / <a href={`/category/${app.category}`}>{cat.label.toLowerCase()}</a> / <span class="here">{app.slug}</span>
    </nav>

    <div class="app-head">
      <span class="title">
        <img src={`/icons/${app.slug}.png`} alt="" width="48" height="48" />
        <h1>Vibecode {app.name.split(' / ')[0]}</h1>
      </span>
      <span class="verdict-side">
        <VerdictBadge verdict={app.verdict} big />
        <button
          class:list={['head-save', { saved: inStack }]}
          data-stack-icon
          data-slug={app.slug}
          aria-pressed={inStack ? 'true' : 'false'}
        >
          <svg width="12" height="14" viewBox="0 0 12 14" fill="none" aria-hidden="true"><path d="M1 1.5H11V13L6 9.8L1 13V1.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path></svg>
          <span class="off">save to my stack</span>
          <span class="on">in your stack</span>
        </button>
      </span>
    </div>

    {
      discontinued && (
        <p class="discontinued-note">
          🪦 {baseName} {discontinued}. The verdict below is now a post-mortem.
        </p>
      )
    }

    <div class="stats">
      <span>price <b>{app.priceMonthly != null ? `${discontinued ? 'was ' : ''}$${app.priceMonthly}/mo` : discontinued ? 'gone' : 'varies'}</b></span>
      {saving != null && !discontinued && <span>you'd save <span class="save">${saving.toLocaleString('en-US')}/yr</span></span>}
      {app.diyTimeEstimate && <span>build time <b>{app.diyTimeEstimate}</b></span>}
      <span>category <a class="cat-pill" href={`/category/${app.category}`}>{cat.emoji} {cat.label.toLowerCase()}</a></span>
      <span>replaced by <b data-votes={app.slug}>{votes}</b> people</span>
    </div>

    {
      VIBE_CODING_TOOL_SLUGS.has(app.slug) && (
        <p class="bvct-backlink">
          ⌨️ featured in <a href="/best-vibe-coding-tools">the best vibe coding tools</a>
        </p>
      )
    }

    {
      moats.length > 0 && (
        <nav class="moat-chips chips" aria-label="Moats">
          <span class="microlabel">moat</span>
          {moats.map((m) => (
            <a class="chip" href={`/moat/${m.tag}`}>
              {m.emoji} {m.label}
            </a>
          ))}
        </nav>
      )
    }

    {
      app.verdictSummary && (
        <p style="padding-top: 22px; font-size: 14.5px; line-height: 1.7; color: var(--muted); max-width: 76ch;">
          {app.verdictSummary}
        </p>
      )
    }

    {
      !app.prompt && (
        <section class="prompt-box">
          <div class="prompt-head">
            <span class="microlabel">the honest answer</span>
          </div>
          <div class="prompt-body">
            <pre id="no-prompt">Don't build this one. {app.whyPeopleStillPay || 'The moat is not the code.'}{
              alternatives.length
                ? `\n\nIf you want off anyway, ${alternatives[0].name} is free (escape hatch below).`
                : app.priorArt.length
                  ? `\n\nIf you want off anyway, start from ${app.priorArt[0].name} (prior art below).`
                  : ''
            }</pre>
          </div>
        </section>
      )
    }

    <section class="prompt-box project-pack" data-project-pack style={!app.prompt ? 'display:none' : undefined}>
      <div class="build-mode" role="group" aria-label="Choose build depth">
        <button class="build-mode-btn active" type="button" data-build-mode="indie" aria-pressed="true">
          <span>indie dev</span>
          <small>lean weekend build</small>
        </button>
        <button class="build-mode-btn" type="button" data-build-mode="product" aria-pressed="false">
          <span>product builder</span>
          <small>production foundation</small>
        </button>
      </div>
      <div class="prompt-head">
        <span>
          <span class="microlabel">the project pack</span>
          <span class="pack-summary" data-pack-summary>4 files · fastest path to a working personal build</span>
        </span>
        <div class="copy-group" data-slug={app.slug}>
          <button class="copy-btn" data-agent="raw">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span>copy all files</span>
          </button>
          <button class="copy-btn" data-agent="claude-code">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="#D97757" aria-hidden="true"><path d="m4.7144 15.9555 4.7174-2.6471.079-.2307-.079-.1275h-.2307l-.7893-.0486-2.6956-.0729-2.3375-.0971-2.2646-.1215-.5707-.1214L0 11.7855l.0547-.3521.4796-.3218.686.0608 1.5178.1032 2.2767.1578 1.6514.0972 2.4468.2549h.3886l.0546-.1578-.1335-.0972-.1032-.0971-2.3557-1.5967-2.5501-1.688-1.3356-.9714-.7225-.4917-.3643-.4614-.1578-1.0078.6557-.7225.8804.0607.2246.0607.8926.686 1.9064 1.4753 2.4893 1.8335.3643.3035.1457-.1032.0182-.0728-.1639-.2732-1.3538-2.4467-1.4449-2.4893-.6435-1.0321-.17-.6193a2.9691 2.9691 0 0 1-.1032-.7286l.7468-1.0139L4.4837 0l.9957.1336.4189.3642.6192 1.4145 1.0018 2.2282 1.5542 3.0296.4553.8986.2428.8318.0911.2549h.1578v-.1457l.1275-1.706.2367-2.0946.2306-2.6957.0789-.7589.3764-.9107.7468-.4917.5828.2793.4796.686-.0668.4431-.2853 1.8517-.5586 2.9021-.3643 1.9429h.2125l.2428-.2428.9835-1.3052 1.6514-2.0642.7286-.8197.8501-.9047.5464-.4309h1.0321l.759 1.1293-.34 1.1657-1.0625 1.3477-.8804 1.1414-1.2627 1.7-.7893 1.3599.0729.1093.1882-.0182 2.8535-.6071 1.5421-.2793 1.8396-.3157.8319.3886.0911.3946-.3279.8076-1.9672.4857-2.3072.4614-3.436.8137-.0425.0303.0486.0607 1.5482.1457.6618.0364h1.6211l3.0175.2247.7893.5221.4736.6375-.079.4857-1.2141.6193-1.6393-.3886-3.8246-.9107-1.3113-.3278h-.1822v.1093l1.0929 1.0686 2.0034 1.8092 2.5076 2.3314.1275.5768-.3218.4553-.34-.0486-2.2038-1.6575-.8501-.7468-1.9246-1.6211h-.1275v.17l.4432.6496 2.3436 3.5209.1214 1.0807-.17.3521-.6071.2125-.6679-.1214-1.3721-1.9247-1.4145-2.1674-1.1414-1.9429-.1397.0789-.674 7.2583-.3157.3703-.7286.2793-.6071-.4614-.3218-.7468.3218-1.4753.3886-1.9246.3157-1.5299.2853-1.9004.17-.6314-.0121-.0425-.1396.0182-1.4327 1.9672-2.1795 2.9445-1.724 1.845-.4128.1639-.7164-.3702.0668-.6618.4006-.5889 2.386-3.0357 1.4388-1.8821.929-1.0868-.0061-.1578h-.0546l-6.3383 4.1161-1.129.1457-.4857-.4553.0607-.7468.2307-.2428 1.9064-1.3113Z"/></svg>
            <span>open in Claude Code</span>
          </button>
          <button class="copy-btn" data-agent="codex">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.872zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654 2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z"/></svg>
            <span>open in Codex</span>
          </button>
          <button class="copy-btn" data-agent="cursor">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M22.106 5.68L12.5.135a.998.998 0 00-.998 0L1.893 5.68a.84.84 0 00-.419.726v11.186c0 .3.16.577.42.727l9.607 5.547a.999.999 0 00.998 0l9.608-5.547a.84.84 0 00.42-.727V6.407a.84.84 0 00-.42-.726zm-.603 1.176L12.228 22.92c-.063.108-.228.064-.228-.061V12.34a.59.59 0 00-.295-.51l-9.11-5.26c-.107-.062-.063-.228.062-.228h18.55c.264 0 .428.286.296.514z"></path></svg>
            <span>open in Cursor</span>
          </button>
        </div>
      </div>
      <pre id="prompt-text" hidden>{indieBundle}</pre>
      <pre data-pack-bundle="indie" hidden>{indieBundle}</pre>
      <pre data-pack-bundle="product" hidden>{productBundle}</pre>
      <div class="pack-workspace" data-pack-mode="indie">
        <nav class="pack-files" aria-label="Indie project files">
          {indieFiles.map((file, index) => (
            <button type="button" class:list={['pack-file', { active: index === 0 }]} data-pack-file={file.path} aria-pressed={index === 0 ? 'true' : 'false'}>
              <span class="file-icon">{file.path.startsWith('.') ? '⚙' : '#'}</span>{file.path}
            </button>
          ))}
        </nav>
        <div class="pack-editor">
          {indieFiles.map((file, index) => (
            <section class="pack-panel" data-pack-panel={file.path} hidden={index !== 0}>
              <div class="pack-panel-head"><span>{file.path}</span><button type="button" data-copy-file>copy file</button></div>
              <pre>{file.content}</pre>
            </section>
          ))}
        </div>
      </div>
      <div class="pack-workspace" data-pack-mode="product" hidden>
        <nav class="pack-files" aria-label="Product project files">
          {productFiles.map((file, index) => (
            <button type="button" class:list={['pack-file', { active: index === 0 }]} data-pack-file={file.path} aria-pressed={index === 0 ? 'true' : 'false'}>
              <span class="file-icon">#</span>{file.path}
            </button>
          ))}
        </nav>
        <div class="pack-editor">
          {productFiles.map((file, index) => (
            <section class="pack-panel" data-pack-panel={file.path} hidden={index !== 0}>
              <div class="pack-panel-head"><span>{file.path}</span><button type="button" data-copy-file>copy file</button></div>
              <pre>{file.content}</pre>
            </section>
          ))}
        </div>
      </div>
      <p class="prompt-hint">
        $ choose a build depth, inspect the files, then open the complete pack in your agent{
          !app.promptCurated && (
            <>
              {' '}· this prompt is generated from the build plan ·{' '}
              <a href="https://github.com/vibecodeit/vibecodeit/blob/main/CONTRIBUTING.md" style="color: var(--primary);">improve it via PR</a>
            </>
          )
        }
      </p>
    </section>


    <DigestReveal source="app_copy" />

    {
      app.whyPeopleStillPay && (
        <section style="padding-top: 44px;">
          <span class="microlabel">why people still pay</span>
          <p style="padding-top: 12px; font-size: 14px; line-height: 1.7; color: var(--fg); max-width: 76ch;">
            {app.whyPeopleStillPay}
          </p>
        </section>
      )
    }

    <div class="two-col">
      <section>
        <span class="microlabel">what you lose</span>
        {app.whatYouLose.map((l) => (
          <p class="lose-item"><i>x</i>{l}</p>
        ))}
      </section>
      {/* The escape hatch replaces this section wherever it exists — prior art
          stays in the data (and in the FAQ) as the builder's raw material. */}
      {alternatives.length === 0 && (
      <section>
        <span class="microlabel">prior art · use these instead of building, if you'd rather</span>
        {
          app.priorArt.length > 0 ? (
            app.priorArt.map((p) => (
              <a class="prior-card" href={p.url}>
                <svg width="17" height="17" viewBox="0 0 24 24" fill="var(--muted)" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                <span class="pname">{p.name}</span>
                <span class="pdesc">{p.desc}</span>
                <span class="arrow">↗</span>
              </a>
            ))
          ) : (
            <p class="lose-item" style="color: var(--muted);">
              Nothing worth pointing at. That's why the prompt exists.
            </p>
          )
        }
      </section>
      )}
    </div>

    <div class="actions">
      <button class="btn primary" data-vote={app.slug}>
        I replaced this · <span data-votes={app.slug}>{votes}</span>
      </button>
      <a
        class="btn ghost"
        href={`https://twitter.com/intent/tweet?text=${tweet}`}
        data-share={app.slug}
      >share on X ↗</a>
      <button
        class:list={['btn', 'ghost', 'stack-btn', { 'in-stack': inStack }]}
        data-stack={app.slug}
        data-saved={inStack ? '1' : null}
      >{inStack ? '✓ in your stack' : '+ save to my stack'}</button>
      <span class="tweet">"I just replaced {app.name.split(' / ')[0]}{app.priceMonthly != null ? ` ($${app.priceMonthly}/mo)` : ''} with one prompt"</span>
    </div>

    {/* How to AI placement: after the verdict block, before the escape hatch */}
    <RecModule src="apppage" />

    {
      alternatives.length > 0 && (
        <section class="escape-hatch">
          <span class="microlabel">the escape hatch</span>
          <h2 class="eh-head">Don't feel like building it? These folks already made it free.</h2>
          {alternatives.slice(0, 3).map((alt, i) => (
            <AltCard {alt} compact i={i} />
          ))}
          <p class="eh-foot">
            {hasAltPage && (
              <a href={`/${app.slug}/alternatives`}>
                all {alternatives.length} free alternatives to {app.name.split(' / ')[0]} →
              </a>
            )}
            <span>{hasAltPage && '· '}no votes, no pay-to-list · just what's real</span>
          </p>
        </section>
      )
    }

    <BuildsSection {app} />

    {
      related.length > 0 && (
        <section class="related">
          <span class="microlabel">also one-shottable</span>
          <div class="related-grid">
            {related.map((r) => (
              <a class="mini-card" href={`/${r.slug}`}>
                <img src={`/icons/${r.slug}.png`} alt="" width="26" height="26" loading="lazy" />
                <span>
                  <span class="m-name">{r.name}</span>
                  <br />
                  <span class="m-meta">
                    {r.priceMonthly != null ? `$${r.priceMonthly}/mo` : 'varies'} · {CATEGORIES[r.category].label.toLowerCase()}
                  </span>
                </span>
                <VerdictBadge verdict={r.verdict} />
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      (pricingLed || tiers) && (
        <section class="pricing-sec">
          <span class="microlabel">the numbers</span>
          <h2>{baseName} pricing</h2>
          {tiers ? (
            <>
              <div class="tier-wrap">
                <table class="alt-table">
                  <thead>
                    <tr><th>plan</th><th>monthly</th><th>annual (per mo)</th><th>what you get</th></tr>
                  </thead>
                  <tbody>
                    {tiers.map((t) => (
                      <tr>
                        <td class="t-name">{t.name.toLowerCase()}</td>
                        <td>{tierPrice(t.monthly, t.per) ?? (t.annualPerMonth == null ? 'custom' : '—')}</td>
                        <td>{tierPrice(t.annualPerMonth, t.per) ?? '—'}</td>
                        <td class="t-limits">{t.limits ?? '—'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div class="p-rows">
                <p class="p-row">
                  <span class="p-k">free tier</span>
                  <span class="p-v">{app.pricing.freeTierCaps}</span>
                </p>
                <p class="p-row">
                  <span class="p-k">billing</span>
                  <span class="p-v">{app.pricing.billingTerms}</span>
                </p>
                {app.pricing.hiddenCosts && (
                  <p class="p-row">
                    <span class="p-k">hidden costs</span>
                    <span class="p-v">{app.pricing.hiddenCosts}</span>
                  </p>
                )}
                {app.pricing.priceChanges?.length > 0 && (
                  <p class="p-row">
                    <span class="p-k">price history</span>
                    <span class="p-v">
                      {app.pricing.priceChanges
                        .map((c) => `${c.what}: ${c.fromUsd != null ? `$${c.fromUsd} → ` : 'now '}$${c.toUsd} (${c.when})`)
                        .join(' · ')}
                    </span>
                  </p>
                )}
              </div>
              <p class="p-verified">
                verified {app.pricing.tiersCheckedOn}
                {' '}·{' '}
                <a href={app.pricing.tiersSources[0]} rel="nofollow noopener" target="_blank">
                  source ↗
                </a>
              </p>
            </>
          ) : (
            <>
              <div class="p-rows">
                <p class="p-row">
                  <span class="p-k">{app.pricing?.plan ? app.pricing.plan.toLowerCase() : 'paid'}</span>
                  <span class="p-v">
                    ${app.priceMonthly}/mo{app.pricing?.basis ? ` · ${app.pricing.basis}` : ''} · ${saving?.toLocaleString('en-US')}/yr
                  </span>
                </p>
                <p class="p-row">
                  <span class="p-k">free tier</span>
                  <span class="p-v">{freeTier}</span>
                </p>
              </div>
              <p class="p-verified">
                verified {app.pricing?.checkedOn}
                {app.pricing?.source && (
                  <>
                    {' '}·{' '}
                    <a href={app.pricing.source} rel="nofollow noopener" target="_blank">
                      source ↗
                    </a>
                  </>
                )}
              </p>
            </>
          )}
        </section>
      )
    }

    <section class="faq">
      <span class="microlabel">questions</span>
      {
        faq.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p class="a">{f.a}</p>
          </details>
        ))
      }
    </section>
  </main>

  <DigestCard source="app" />
</Base>

<style>
  .build-mode {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    max-width: 560px;
    margin-bottom: 10px;
    padding: 5px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface-2);
  }

  .build-mode-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding: 10px 13px;
    border: 1px solid transparent;
    border-radius: 7px;
    color: var(--muted);
    text-align: left;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .build-mode-btn span {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .build-mode-btn small {
    font-size: 12px;
  }

  .build-mode-btn:hover {
    color: var(--fg);
  }

  .build-mode-btn.active {
    border-color: color-mix(in srgb, var(--primary) 55%, var(--border));
    color: var(--fg);
    background: var(--bg);
    box-shadow: inset 3px 0 0 var(--primary);
  }

  .prompt-head > span:first-child {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .pack-summary {
    font-size: 11.5px;
    color: var(--muted);
  }

  .pack-workspace {
    display: grid;
    grid-template-columns: minmax(150px, 210px) minmax(0, 1fr);
    min-height: 470px;
    border: 1px solid var(--border);
    border-radius: 0 0 10px 10px;
    overflow: hidden;
    background: var(--surface);
  }

  .pack-workspace[hidden],
  .pack-panel[hidden] {
    display: none;
  }

  .pack-files {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 12px 8px;
    border-right: 1px solid var(--border);
    background: var(--surface-2);
  }

  .pack-file {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 9px 10px;
    border-radius: 6px;
    color: var(--muted);
    font: 12px/1.3 var(--font-mono);
    text-align: left;
    overflow-wrap: anywhere;
  }

  .pack-file:hover {
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 4%, transparent);
  }

  .pack-file.active {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
  }

  .file-icon {
    width: 14px;
    color: var(--muted);
    text-align: center;
  }

  .pack-editor,
  .pack-panel {
    min-width: 0;
    height: 100%;
  }

  .pack-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 43px;
    padding: 8px 16px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font: 12px/1.4 var(--font-mono);
  }

  .pack-panel-head button {
    padding: 5px 8px;
    border: 1px solid var(--border);
    border-radius: 5px;
    color: var(--muted);
    font-size: 11px;
  }

  .pack-panel-head button:hover {
    border-color: var(--muted);
    color: var(--fg);
  }

  .pack-panel pre {
    max-height: 560px;
    padding: 22px;
    overflow: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--fg);
    font: 13px/1.7 var(--font-mono);
  }

  @media (max-width: 700px) {
    .build-mode {
      max-width: none;
    }

    .pack-workspace {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .pack-files {
      flex-direction: row;
      overflow-x: auto;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }

    .pack-file {
      width: auto;
      flex: 0 0 auto;
    }

    .pack-panel pre {
      max-height: 520px;
    }
  }

  .moat-chips {
    justify-content: flex-start;
    align-items: center;
    padding-top: 18px;
  }

  .moat-chips .microlabel {
    margin-right: 3px;
  }

  .bvct-backlink {
    padding-top: 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .discontinued-note {
    margin-top: 18px;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--primary);
    font-size: 14px;
    line-height: 1.6;
    max-width: 76ch;
  }

  .bvct-backlink a {
    color: var(--primary);
  }

  .pricing-sec {
    padding-top: 44px;
  }

  .pricing-sec h2 {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    padding-top: 12px;
  }

  .tier-wrap {
    max-width: 900px;
    overflow-x: auto;
  }

  .tier-wrap .t-name {
    font-weight: 600;
    white-space: nowrap;
  }

  .tier-wrap .t-limits {
    font-size: 12px;
    min-width: 220px;
    max-width: 52ch;
    overflow-wrap: anywhere;
  }

  .p-rows {
    margin-top: 14px;
    border-top: 1px solid var(--border);
    max-width: 76ch;
  }

  /* Below the tier table the table's own bottom rule already draws the line;
     a second border-top here reads as an ugly double rule. */
  .tier-wrap + .p-rows {
    border-top: 0;
    margin-top: 0;
  }

  .p-row {
    display: flex;
    gap: 18px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
    line-height: 1.6;
  }

  .p-k {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    flex: 0 0 110px;
    padding-top: 2px;
  }

  .p-verified {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .p-verified a {
    color: var(--muted);
  }
</style>
