---
import Base from '../../layouts/Base.astro';
import AppRow from '../../components/AppRow.astro';
import DigestCard from '../../components/DigestCard.astro';
import { appsByCategory, categoriesInUse, categoryPhrase, CATEGORIES } from '../../lib/apps.js';
import { voteCounts } from '../../lib/db.js';

const { cat } = Astro.params;
const meta = CATEGORIES[cat];
if (!meta) return new Response(null, { status: 404 });

const votes = await voteCounts();
const apps = appsByCategory(cat).sort((a, b) => votes(b.slug) - votes(a.slug));
if (apps.length === 0) return new Response(null, { status: 404 });

const cats = categoriesInUse();
// Keyword title on categories with enough apps to be a real list; tiny
// categories keep the brand title (a "2 X tools" roundup reads as thin).
const phrase = categoryPhrase(cat);
const templated = apps.length >= 3;
const title = templated
  ? `${apps.length} ${phrase}: free & open source picks`
  : `Vibecode your ${meta.label.toLowerCase()} subscription · Can I Vibecode It?`;
const description = templated
  ? `${apps.length} ${phrase} compared: ${apps
      .slice(0, 8)
      .map((a) => a.name)
      .join(', ')} and more. Which are free, which are open source, and which an AI agent can just build you.`
  : `${meta.label} apps ranked by how replaceable they are with one AI prompt: ${apps
      .map((a) => a.name)
      .join(', ')}.`;

const socialTitle = `Vibecode your ${meta.label.toLowerCase()} subscription · Can I Vibecode It?`;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'The Death List', item: 'https://canivibecodeit.com/' },
      { '@type': 'ListItem', position: 2, name: 'Categories', item: 'https://canivibecodeit.com/categories' },
      { '@type': 'ListItem', position: 3, name: meta.label, item: `https://canivibecodeit.com/category/${cat}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${meta.label} · vibecodability`,
    itemListElement: apps.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.name,
      url: `https://canivibecodeit.com/${a.slug}`,
    })),
  },
];
---

<Base {title} {description} {socialTitle} {jsonld}>
  <main class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">the death list</a> / <span class="here">{meta.label.toLowerCase()}</span>
    </nav>

    <div class="list-head" style="padding-top: 20px;">
      <h2>{meta.emoji} {meta.label}</h2>
      <span class="note">{apps.length} {apps.length === 1 ? 'app' : 'apps'}</span>
    </div>

    <nav class="chips cat-rail" style="justify-content: flex-start; padding-top: 18px;" aria-label="Categories">
      <a class="chip" href="/categories">⚡ all</a>
      {
        cats.map((c) => (
          <a class={`chip${c.slug === cat ? ' active' : ''}`} href={`/category/${c.slug}`}>
            {c.emoji} {c.label.toLowerCase()}
          </a>
        ))
      }
    </nav>

    {
      cat === 'dev-tools' && (
        <p class="cat-crosslink">
          ⌨️ the tools doing the building, ranked: <a href="/best-vibe-coding-tools">best vibe coding tools</a>
        </p>
      )
    }

    <div class="thead microlabel">
      <span class="c-app">app</span>
      <span class="c-cat">category</span>
      <span class="c-price">price</span>
      <span class="c-verdict">verdict</span>
      <span class="c-votes">replaced it</span>
      <span class="c-save"></span>
    </div>
    <div id="rows">
      {
        apps.map((app, i) => (
          <Fragment>
            <AppRow {app} rank={i + 1} votes={votes(app.slug)} />
          </Fragment>
        ))
      }
    </div>
  </main>

  <DigestCard source="category" />
</Base>

<style>
  /* On a phone, 70+ category chips wrap into a wall that buries the actual
     list. Collapse them into one swipeable rail: every link stays in the DOM
     (the internal-linking mesh is the point of the block), the current
     category leads the row, and the results start one row down. Desktop keeps
     the full wrapped grid. */
  @media (max-width: 760px) {
    .cat-rail {
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin-left: -20px;
      margin-right: -20px;
      padding-left: 20px;
      padding-right: 20px;
      max-width: none;
    }

    .cat-rail::-webkit-scrollbar {
      display: none;
    }

    .cat-rail .chip {
      flex: 0 0 auto;
      white-space: nowrap;
    }

    .cat-rail .chip.active {
      order: -1;
    }
  }

  .cat-crosslink {
    padding-top: 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .cat-crosslink a {
    color: var(--primary);
  }
</style>
