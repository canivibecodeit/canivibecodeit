---
import Base from '../../layouts/Base.astro';
import AppRow from '../../components/AppRow.astro';
import DigestCard from '../../components/DigestCard.astro';
import {
  appsByMoat,
  moatsInUse,
  MOAT_TAGS,
  MOAT_TAG_EMOJI,
  MOAT_TAG_DESCS,
} from '../../lib/apps.js';
import { voteCounts } from '../../lib/db.js';

const { tag } = Astro.params;
const label = MOAT_TAGS[tag];
if (!label) return new Response(null, { status: 404 });

const votes = await voteCounts();
const apps = appsByMoat(tag).sort((a, b) => votes(b.slug) - votes(a.slug));
if (apps.length === 0) return new Response(null, { status: 404 });

const moats = moatsInUse();
const title = `Apps defended by ${label} · Can I Vibecode It?`;
const description = `${apps.length} subscription apps whose moat is ${label}: ${MOAT_TAG_DESCS[tag]} Ranked by how many people replaced them with one AI prompt.`;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'The Death List', item: 'https://canivibecodeit.com/' },
      { '@type': 'ListItem', position: 2, name: 'Moats', item: 'https://canivibecodeit.com/moats' },
      { '@type': 'ListItem', position: 3, name: label, item: `https://canivibecodeit.com/moat/${tag}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${label} · apps defended by this moat`,
    itemListElement: apps.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.name,
      url: `https://canivibecodeit.com/${a.slug}`,
    })),
  },
];
---

<Base {title} {description} {jsonld}>
  <main class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">the death list</a> / <a href="/moats">moats</a> / <span class="here">{label}</span>
    </nav>

    <div class="list-head" style="padding-top: 20px;">
      <h2>{MOAT_TAG_EMOJI[tag]} {label}</h2>
      <span class="note">{apps.length} {apps.length === 1 ? 'app' : 'apps'}</span>
    </div>

    <p class="moat-def">{MOAT_TAG_DESCS[tag]}</p>

    <nav class="chips" style="justify-content: flex-start; padding-top: 18px;" aria-label="Moats">
      <a class="chip" href="/moats">🏰 all moats</a>
      {
        moats.map((m) => (
          <a class={`chip${m.tag === tag ? ' active' : ''}`} href={`/moat/${m.tag}`}>
            {m.emoji} {m.label}
          </a>
        ))
      }
    </nav>

    <div class="thead microlabel">
      <span class="c-app">app</span>
      <span class="c-cat">category</span>
      <span class="c-price">price</span>
      <span class="c-verdict">verdict</span>
      <span class="c-votes">replaced it</span>
      <span class="c-save"></span>
    </div>
    <div id="rows">
      {
        apps.map((app, i) => (
          <Fragment>
            <AppRow {app} rank={i + 1} votes={votes(app.slug)} />
          </Fragment>
        ))
      }
    </div>
  </main>

  <DigestCard source="moat" />
</Base>

<style>
  .moat-def {
    padding-top: 14px;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 76ch;
  }

</style>
