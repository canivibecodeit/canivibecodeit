            <span>open in Codex</span>
          </button>
          <button class="copy-btn" data-agent="cursor">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M22.106 5.68L12.5.135a.998.998 0 00-.998 0L1.893 5.68a.84.84 0 00-.419.726v11.186c0 .3.16.577.42.727l9.607 5.547a.999.999 0 00.998 0l9.608-5.547a.84.84 0 00.42-.727V6.407a.84.84 0 00-.42-.726zm-.603 1.176L12.228 22.92c-.063.108-.228.064-.228-.061V12.34a.59.59 0 00-.295-.51l-9.11-5.26c-.107-.062-.063-.228.062-.228h18.55c.264 0 .428.286.296.514z"></path></svg>
            <span>open in Cursor</span>
          </button>
        </div>
      </div>
      <div class="prompt-body">
        <pre id="prompt-text">{prompt}</pre>
      </div>
      <p class="prompt-hint">$ paste into your agent in an empty folder · or just fork the <a href="https://github.com/vibecodeit/vibecodeit" style="color: var(--primary);">source</a></p>
    </section>
  </main>
</Base>
