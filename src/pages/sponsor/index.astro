---
import Base from '../../layouts/Base.astro';
import VisitorGlobe from '../../components/VisitorGlobe.astro';
import { allApps } from '../../lib/apps.js';
import {
  getBoard, nextRunStart, QUARTER_MIN_CENTS, QUARTER_MONTHS, RUN_DAYS, shortDate, usd,
} from '../../lib/sponsors.js';

// The slot cards sell next month by name, so the copy renews itself.
const nextStart = nextRunStart();
const NEXT_MONTH = shortDate(nextStart).split(' ')[0].toUpperCase();
const nextStartLabel = shortDate(nextStart).toLowerCase();

const board = await getBoard();
const apps = allApps();
const notice = Astro.url.searchParams.get('error') || Astro.url.searchParams.get('msg') || '';

const title = 'Sponsor canivibecodeit · ten fixed slots, read by builders';
const description =
  'Sponsor slots in front of builders choosing their AI-era stack. Buy 30 days in one click, no contract, no account manager. Sponsorship never touches a verdict.';

const SEPT_TIMELINE = [
  { date: 'aug 21', note: 'first refusal ends for current sponsors', live: true },
  { date: 'aug 22', note: 'unrenewed slots open · first paid, first placed', live: false },
  { date: 'sep 1', note: 'board goes live', live: false },
];

const testimonials = [
  {
    quote:
      '100+ visitors within hours of going live. cheaper than ads.',
    who: 'Pierre-Eliott · co-founder, Gojiberry AI',
    img: '/pfp/pierre-eliott.jpg',
  },
  {
    quote:
      'in 24 hours: 200+ visitors, 5 trials. we pay $90 for a trial on Meta ads. the traffic is highly qualified, mostly from the US.',
    who: 'Dylan · co-founder, Gojiberry AI',
    img: '/pfp/dylan.jpg',
  },
];

// "Taken" = not buyable right now: live runs whose next month is still the
// incumbent's to refuse count as held.
const buyableCount = board.slots.filter(
  (s) => s.state === 'open' || (s.state !== 'open' && s.nextState === 'open' && !s.nextTaken)
).length;
const takenCount = board.slots.length - buyableCount;

const steps = [
  {
    head: 'pick a slot and pay',
    body: 'one click to Stripe. no account, no call, no contract. the slot is held while you check out.',
  },
  {
    head: 'tell us who you are',
    body: `name, one line, and your link: straight after payment. takes a minute. we grab your icon automatically.`,
  },
  {
    head: 'we approve it, then it runs',
    body: `${RUN_DAYS} days from the moment it goes live, not from the moment you paid. rejected? full refund, same day.`,
  },
];
---

<Base {title} {description}>
  <main class="wrap sponsor-page">
    <section class="sp-hero">
      <h1>Sponsor canivibecodeit.</h1>
      <p class="sub">
        Ten fixed slots, read by builders deciding what to build and what to
        build on. If your product belongs in that stack, this is the shelf it
        gets picked from.
      </p>
      <div class="sp-statband">
        <div class="sp-stat" style="--i: 0"><b>300,000+</b><span>views a month, current pace</span></div>
        <div class="sp-stat" style="--i: 1"><b>{apps.length}</b><span>apps on the list</span></div>
        <div class="sp-stat" style="--i: 2"><b>builders</b><span>choosing their AI-era stack</span></div>
        <div class="sp-stat green" style="--i: 3"><b>{takenCount}/{board.slots.length}</b><span>{NEXT_MONTH} slots taken</span></div>
      </div>
    </section>

    {notice && <p class="sp-notice">{notice}</p>}

    <VisitorGlobe embed />

    <section class="sp-sept" id="september">
      <div class="sp-sept-head">
        <h2>September.</h2>
        <span class="note">10 fixed slots. yours is yours: no rotation, no sharing.</span>
      </div>
      <div class="sp-flat">
        <span class="sp-flat-price">$2,500</span>
        <span class="sp-flat-note">
          one price, any open slot, 30 days. what you pay never changes mid-run.
        </span>
      </div>
      <div class="sp-sept-timeline" role="list" aria-label="September timeline">
        {
          SEPT_TIMELINE.map((s) => (
            <div class="sp-sept-step" role="listitem">
              <span class={`sp-sept-dot ${s.live ? 'live' : ''}`} aria-hidden="true" />
              <span class="sp-sept-date">{s.date}</span>
              <span class="sp-sept-what">{s.note}</span>
            </div>
          ))
        }
      </div>
      <div class="sp-quotes">
        {
          testimonials.map((t) => (
            <figure class="sp-quote">
              <blockquote>“{t.quote}”</blockquote>
              <figcaption>
                <img src={t.img} alt="" width="36" height="36" loading="lazy" />
                <span>{t.who}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="sp-who">
      <div class="list-head">
        <h2>Who sponsors here</h2>
        <span class="note">two kinds of sponsor do well on this page</span>
      </div>
      <div class="sp-who-grid">
        <div class="sp-who-card">
          <span class="sp-who-head">presence buyers</span>
          <p>
            You want builders to know your name. A fixed card on a page they
            keep coming back to; no funnel math, just being where your people
            already look.
          </p>
        </div>
        <div class="sp-who-card">
          <span class="sp-who-head">signup buyers</span>
          <p>
            You sell a tool builders buy for themselves: self-serve, priced for
            one person's card, value visible in the first session. They click,
            they try it, you see it.
          </p>
        </div>
      </div>
      <p class="sp-who-cats">
        works best for: AI coding tools · infra &amp; hosting · APIs &amp; inference
        · payments for builders · growth &amp; analytics
      </p>
    </section>

    <section class="sp-board" id="slots">
      <div class="list-head">
        <h2>The slots</h2>
        <span class="note">$2,500 flat · your rate never rises while you stay</span>
      </div>
      <div class="sp-grid">
        {
          board.slots.map((slot) => (
            <div
              class={`sp-slot ${slot.state}${slot.state === 'live' && !slot.nextTaken && slot.nextState === 'open' ? ' sept-open' : ''}`}
              data-slot={slot.id}
            >
              <span class="microlabel">
                slot {slot.id} · {slot.side} rail
              </span>
              {slot.state === 'open' ? (
                <>
                  <span class="sp-slot-price">
                    {usd(slot.priceCents)}
                    <span class="sp-per">/{RUN_DAYS} days</span>
                  </span>
                  <form method="post" action="/api/sponsor/checkout" data-checkout data-astro-reload>
                    <input type="hidden" name="slot" value={slot.id} />
                    <button class="btn primary" type="submit" data-price={slot.priceCents}>
                      take this slot →
                    </button>
                  </form>
                  {slot.priceCents >= QUARTER_MIN_CENTS && (
                    <form method="post" action="/api/sponsor/checkout" data-checkout data-astro-reload>
                      <input type="hidden" name="slot" value={slot.id} />
                      <input type="hidden" name="months" value={QUARTER_MONTHS} />
                      <button class="sp-quarter" type="submit" data-price={slot.priceCents * QUARTER_MONTHS}>
                        or lock {QUARTER_MONTHS} months at this price · {usd(slot.priceCents * QUARTER_MONTHS)}
                      </button>
                    </form>
                  )}
                </>
              ) : slot.state === 'live' ? (
                <>
                  <span class="sp-slot-taken">{slot.sponsor.name}</span>
                  <span class="sp-slot-note">taken until {shortDate(slot.endsAt)}</span>
                  <span class="sp-slot-next">
                    {slot.nextTaken ? (
                      <span class="sn taken">{NEXT_MONTH} · TAKEN</span>
                    ) : slot.nextState === 'open' ? (
                      <form method="post" action="/api/sponsor/checkout" data-checkout data-astro-reload>
                        <input type="hidden" name="slot" value={slot.id} />
                        <input type="hidden" name="term" value="next" />
                        <button class="sn open" type="submit" data-price={slot.priceCents}>
                          {NEXT_MONTH} · OPEN · {usd(slot.priceCents)} · yours from {nextStartLabel} →
                        </button>
                      </form>
                    ) : slot.nextState === 'reserved' ? (
                      <span class="sn taken">{NEXT_MONTH} · RESERVED</span>
                    ) : (
                      <span class="sn deciding">{NEXT_MONTH} · SPONSOR DECIDING</span>
                    )}
                  </span>
                </>
              ) : (
                <>
                  <span class="sp-slot-taken">{slot.nextTaken ? 'booked' : 'reserved'}</span>
                  <span class="sp-slot-note">
                    {slot.nextTaken && slot.nextStartsAt
                      ? `next run starts ${shortDate(slot.nextStartsAt)}`
                      : 'someone is mid-checkout or waiting on approval'}
                  </span>
                </>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <section class="sp-how">
      <div class="list-head">
        <h2>How it works</h2>
        <span class="note">about four minutes, end to end</span>
      </div>
      <div class="sp-steps">
        {
          steps.map((s, i) => (
            <div class="sp-step">
              <span class="sp-step-n">0{i + 1}</span>
              <span class="sp-step-head">{s.head}</span>
              <p>{s.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="sp-notify" id="notify">
      <h2>Nothing open?</h2>
      <p class="sub">
        Leave your email. Slot openings land in the weekly digest, along with the week's
        verdicts. One-click unsubscribe.
      </p>
      <form method="post" action="/api/waitlist" data-digest>
        <label class="hp" aria-hidden="true">
          Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
        <input type="hidden" name="source" value="sponsor" />
        <input
          type="email"
          name="email"
          required
          placeholder="you@yourcompany.com"
          aria-label="Email address"
        />
        <button class="btn primary" type="submit">tell me when one opens</button>
      </form>
    </section>

    <section class="sp-terms">
      <span class="microlabel">the boring part</span>
      <p>
        What you're buying is placement bought once: {RUN_DAYS} days in one slot (or {RUN_DAYS * QUARTER_MONTHS} days
        on the big slots, price locked, still one payment), starting when the placement is approved. It is not a subscription and it does not
        renew itself; when it ends, it ends, and you're welcome to buy it again. Price
        changes only ever apply to new sponsors; the rate you start at is yours for as
        long as you keep renewing.
        Sponsorship never touches a verdict, a ranking, or a prompt: not yours, not your
        competitor's, and the answer to "can I vibecode it" stays whatever it was.
        Every placement is approved by hand, so anything we won't run gets a full refund,
        usually the same day. Questions, or something
        weird: <a href="mailto:hello@canivibecodeit.com?subject=Sponsoring%20canivibecodeit.com">hello@canivibecodeit.com</a>.
      </p>
    </section>
  </main>
</Base>

<style>
  .sp-sept {
    padding-top: 40px;
  }

  .sp-sept-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    flex-wrap: wrap;
  }

  .sp-sept-head h2 {
    font-family: var(--font-display);
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .sp-flat {
    display: flex;
    align-items: baseline;
    gap: 28px;
    margin-top: 24px;
    padding: 30px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .sp-flat-price {
    font-family: var(--font-display);
    font-size: clamp(40px, 4.5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .sp-flat-note {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }

  .sp-sept-timeline {
    display: flex;
    position: relative;
    margin-top: 40px;
  }

  /* The rail: one hairline through every dot. Dots are 8px, so the line sits
     at their vertical middle. */
  .sp-sept-timeline::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 4px;
    height: 1px;
    background: var(--border);
  }

  .sp-sept-step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    padding-right: 20px;
    min-width: 0;
  }

  .sp-sept-dot {
    width: 8px;
    height: 8px;
    border-radius: 100px;
    background: var(--muted);
    position: relative;
  }

  .sp-sept-dot.live {
    background: var(--primary);
    animation: sp-dot-pulse 2s ease infinite;
  }

  @keyframes sp-dot-pulse {
    50% {
      opacity: 0.3;
    }
  }

  .sp-sept-date {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
  }

  .sp-sept-what {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.55;
    color: var(--muted);
  }

  .sp-quotes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin-top: 44px;
  }

  .sp-quote {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    margin: 0;
    padding-right: 48px;
  }

  .sp-quote + .sp-quote {
    border-left: 1px solid var(--border);
    padding-left: 48px;
    padding-right: 0;
  }

  .sp-quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 500;
    line-height: 1.5;
    /* Hanging open quote. */
    text-indent: -0.55ch;
  }

  .sp-quote figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .sp-quote figcaption img {
    width: 36px;
    height: 36px;
    border-radius: 100px;
    flex-shrink: 0;
    transition: transform 0.2s var(--ease-snap);
  }

  .sp-quote:hover figcaption img {
    transform: scale(1.08);
  }

  .sp-who-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 8px;
  }

  .sp-who-card {
    padding-right: 48px;
  }

  .sp-who-card + .sp-who-card {
    border-left: 1px solid var(--border);
    padding-left: 48px;
    padding-right: 0;
  }

  .sp-who-head {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .sp-who-card p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .sp-who-cats {
    margin-top: 28px;
    padding-top: 16px;
    border-top: 1px dashed var(--border);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.7;
    color: var(--muted);
  }

  /* Per-slot September line on the board cards. */
  .sp-slot :global(.sp-slot-next) {
    display: block;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px dashed var(--border);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .sp-slot :global(.sn.taken) {
    color: var(--muted);
  }

  .sp-slot :global(.sp-slot-next form) {
    display: block;
  }

  .sp-slot :global(.sn.open) {
    display: inline-block;
    font: inherit;
    letter-spacing: inherit;
    background: none;
    border: 0;
    padding: 0;
    text-align: left;
    cursor: pointer;
    color: var(--primary);
    text-decoration: none;
    transition: transform 0.12s var(--ease-snap);
  }

  .sp-slot :global(.sn.open:hover) {
    transform: translateX(2px);
  }

  .sp-slot :global(.sn.open:active) {
    transform: scale(0.97);
  }

  .sp-slot :global(.sn.deciding) {
    color: var(--kinda-bg);
  }

  .sp-slot.sept-open {
    border-color: color-mix(in srgb, var(--primary) 40%, transparent);
  }

  @media (max-width: 900px) {
    .sp-flat {
      flex-direction: column;
      gap: 10px;
      padding: 24px 0;
    }

    .sp-sept-timeline {
      flex-direction: column;
      gap: 20px;
    }

    .sp-sept-timeline::before {
      display: none;
    }

    .sp-sept-step {
      display: grid;
      grid-template-columns: 8px 64px 1fr;
      gap: 12px;
      align-items: baseline;
      padding-right: 0;
    }

    .sp-sept-dot {
      top: 2px;
    }

    .sp-quotes {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .sp-quote {
      padding-right: 0;
    }

    .sp-quote + .sp-quote {
      border-left: 0;
      border-top: 1px solid var(--border);
      padding-left: 0;
      padding-top: 28px;
    }

    .sp-who-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .sp-who-card {
      padding-right: 0;
    }

    .sp-who-card + .sp-who-card {
      border-left: 0;
      border-top: 1px solid var(--border);
      padding-left: 0;
      padding-top: 24px;
    }
  }
</style>
