---
import Base from '../../layouts/Base.astro';
import VisitorGlobe from '../../components/VisitorGlobe.astro';
import { audienceStats } from '../../lib/audience.js';
import { allApps } from '../../lib/apps.js';
import { getBoard, sponsorPriceCents, usd } from '../../lib/sponsors.js';

const board = await getBoard();
const apps = allApps();
const notice = Astro.url.searchParams.get('error') || Astro.url.searchParams.get('msg') || '';
const price = usd(sponsorPriceCents());

/* Page views: the measured 30-day figure from the same source as /audience
   (PostHog, cached six hours, or its dated snapshot), never a projection. */
const audience = await audienceStats().catch(() => null);
const views = audience?.views ? Number(audience.views).toLocaleString('en-US') : null;

// Slots someone pays for or is about to: running, or paid and awaiting
// approval. House cards are ours and stay for sale, so they count as open.
const takenCount = board.slots.filter((s) => s.state !== 'open').length;

const title = 'Sponsor canivibecodeit · ten fixed slots, read by builders';
const description = `Sponsor slots in front of builders choosing their AI-era stack. ${price} a month, cancel any time. Sponsorship never touches a verdict.`;

const testimonials = [
  {
    quote:
      '100+ visitors within hours of going live. cheaper than ads.',
    who: 'Pierre-Eliott · co-founder, Gojiberry AI',
    img: '/pfp/pierre-eliott.jpg',
  },
  {
    quote:
      'in 24 hours: 200+ visitors, 5 trials. we pay $90 for a trial on Meta ads. the traffic is highly qualified, mostly from the US.',
    who: 'Dylan · co-founder, Gojiberry AI',
    img: '/pfp/dylan.jpg',
  },
];

const steps = [
  {
    head: 'pick a slot and subscribe',
    body: 'one click to Stripe. no call, no contract.',
  },
  {
    head: 'tell us who you are',
    body: 'name, one line and your link, straight after payment. takes a minute.',
  },
  {
    head: 'we approve it, then it runs',
    body: 'your first month counts from approval. rejected? full refund, same day.',
  },
];
---

<Base {title} {description}>
  <main class="wrap sponsor-page">
    <section class="sp-hero">
      <h1>Sponsor canivibecodeit.</h1>
      <p class="sub">
        Ten fixed slots, read by builders deciding what to build and what to
        build on. If your product belongs in that stack, this is the shelf it
        gets picked from.
      </p>
      <div class="sp-statband">
        {views && (
          <div class="sp-stat" style="--i: 0"><b>{views}</b><span><a href="/audience">page views, last 30 days</a></span></div>
        )}
        <div class="sp-stat" style="--i: 1"><b>{apps.length}</b><span>apps on the list</span></div>
        <div class="sp-stat" style="--i: 2"><b>builders</b><span>choosing their AI-era stack</span></div>
        {takenCount > 0 && (
          <div class="sp-stat green" style="--i: 3"><b class="sp-taken">{takenCount}/{board.slots.length}</b><span>slots taken</span></div>
        )}
      </div>
    </section>

    {notice && <p class="sp-notice">{notice}</p>}

    <VisitorGlobe embed />

    <section class="sp-price" id="price">
      <div class="sp-price-head">
        <h2>Ten fixed slots.</h2>
        <span class="note">yours is yours: no rotation, no sharing.</span>
      </div>
      <div class="sp-flat">
        <span class="sp-flat-price">{price}<span class="sp-flat-per">/month</span></span>
        <span class="sp-flat-note">
          Renews monthly until you cancel. The price you start at never rises while you stay subscribed.
        </span>
      </div>
      <div class="sp-quotes">
        {
          testimonials.map((t) => (
            <figure class="sp-quote">
              <blockquote>“{t.quote}”</blockquote>
              <figcaption>
                <img src={t.img} alt="" width="36" height="36" loading="lazy" />
                <span>{t.who}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="sp-who">
      <div class="list-head">
        <h2>Who sponsors here</h2>
        <span class="note">two kinds of sponsor do well on this page</span>
      </div>
      <div class="sp-who-grid">
        <div class="sp-who-card">
          <span class="sp-who-head">presence buyers</span>
          <p>
            You want builders to know your name. A fixed card on a page they
            keep coming back to; no funnel math, just being where your people
            already look.
          </p>
        </div>
        <div class="sp-who-card">
          <span class="sp-who-head">signup buyers</span>
          <p>
            You sell a tool builders buy for themselves: self-serve, priced for
            one person's card, value visible in the first session. They click,
            they try it, you see it.
          </p>
        </div>
      </div>
      <p class="sp-who-cats">
        works best for: AI coding tools · infra &amp; hosting · APIs &amp; inference
        · payments for builders · growth &amp; analytics
      </p>
    </section>

    <section class="sp-board" id="slots">
      <div class="list-head">
        <h2>The slots</h2>
        <span class="note">{price} a month · cancel any time</span>
      </div>
      <div class="sp-grid">
        {
          board.slots.map((slot) => (
            <div class={`sp-slot ${slot.state}`} data-slot={slot.id}>
              <span class="microlabel">
                slot {slot.id} · {slot.side} rail
              </span>
              {slot.state === 'open' ? (
                <>
                  <span class="sp-slot-price">
                    {usd(slot.priceCents)}
                    <span class="sp-per">/month</span>
                  </span>
                  <form method="post" action="/api/sponsor/checkout" data-checkout data-astro-reload>
                    <input type="hidden" name="slot" value={slot.id} />
                    <button class="btn primary" type="submit" data-price={slot.priceCents}>
                      take this slot →
                    </button>
                  </form>
                </>
              ) : slot.state === 'live' ? (
                <>
                  <span class="sp-slot-taken">{slot.sponsor.name}</span>
                  <span class="sp-slot-note">taken</span>
                </>
              ) : (
                <>
                  <span class="sp-slot-taken">reserved</span>
                  <span class="sp-slot-note">not available right now</span>
                </>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <section class="sp-how">
      <div class="list-head">
        <h2>How it works</h2>
        <span class="note">about four minutes, end to end</span>
      </div>
      <div class="sp-steps">
        {
          steps.map((s, i) => (
            <div class="sp-step">
              <span class="sp-step-n">0{i + 1}</span>
              <span class="sp-step-head">{s.head}</span>
              <p>{s.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="sp-notify" id="notify">
      <h2>Nothing open?</h2>
      <p class="sub">
        Leave your email. Slot openings land in the weekly digest, along with the week's
        verdicts. One-click unsubscribe.
      </p>
      <form method="post" action="/api/waitlist" data-digest>
        <label class="hp" aria-hidden="true">
          Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
        <input type="hidden" name="source" value="sponsor" />
        <input
          type="email"
          name="email"
          required
          placeholder="you@yourcompany.com"
          aria-label="Email address"
        />
        <button class="btn primary" type="submit">tell me when one opens</button>
      </form>
    </section>

    <section class="sp-terms">
      <span class="microlabel">the boring part</span>
      <p>
        Each of the ten slots is a monthly subscription at {price}. It renews each month until you
        cancel, which you can do any time from your stats page or by email; the card
        stays up until the end of the month you've paid for. If a renewal payment
        fails, the card comes down at the end of the paid month. The price you start
        at never rises while you stay subscribed.
        Sponsorship never touches a verdict, a ranking, or a prompt: not yours, not your
        competitor's, and the answer to "can I vibecode it" stays whatever it was.
        Every placement is approved by hand, so anything we won't run gets a full refund,
        usually the same day. Questions, or something
        weird: <a href="mailto:hello@canivibecodeit.com?subject=Sponsoring%20canivibecodeit.com">hello@canivibecodeit.com</a>.
      </p>
    </section>
  </main>
</Base>

<style>
  .sp-price {
    padding-top: 40px;
  }

  .sp-price-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    flex-wrap: wrap;
  }

  .sp-price-head h2 {
    font-family: var(--font-display);
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .sp-flat {
    display: flex;
    align-items: baseline;
    gap: 28px;
    margin-top: 24px;
    padding: 30px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .sp-flat-price {
    font-family: var(--font-display);
    font-size: clamp(40px, 4.5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .sp-flat-per {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
    margin-left: 4px;
  }

  .sp-flat-note {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 52ch;
    text-wrap: pretty;
  }

  /* Changes with the board: tabular figures so 9/10 and 10/10 sit alike. */
  .sp-taken {
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }

  .sp-stat a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
  }

  .sp-stat a:hover {
    text-decoration-color: currentColor;
  }

  .sp-quotes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin-top: 44px;
  }

  .sp-quote {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    margin: 0;
    padding-right: 48px;
  }

  .sp-quote + .sp-quote {
    border-left: 1px solid var(--border);
    padding-left: 48px;
    padding-right: 0;
  }

  .sp-quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 500;
    line-height: 1.5;
    /* Hanging open quote. */
    text-indent: -0.55ch;
  }

  .sp-quote figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .sp-quote figcaption img {
    width: 36px;
    height: 36px;
    border-radius: 100px;
    flex-shrink: 0;
    transition: transform 0.2s var(--ease-snap);
  }

  .sp-quote:hover figcaption img {
    transform: scale(1.08);
  }

  .sp-who-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 8px;
  }

  .sp-who-card {
    padding-right: 48px;
  }

  .sp-who-card + .sp-who-card {
    border-left: 1px solid var(--border);
    padding-left: 48px;
    padding-right: 0;
  }

  .sp-who-head {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .sp-who-card p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .sp-who-cats {
    margin-top: 28px;
    padding-top: 16px;
    border-top: 1px dashed var(--border);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.7;
    color: var(--muted);
  }

  /* Three stats on a two-column phone grid: the odd one out spans the row. */
  @media (max-width: 700px) {
    .sp-statband > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 900px) {
    .sp-flat {
      flex-direction: column;
      gap: 10px;
      padding: 24px 0;
    }

    .sp-quotes {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .sp-quote {
      padding-right: 0;
    }

    .sp-quote + .sp-quote {
      border-left: 0;
      border-top: 1px solid var(--border);
      padding-left: 0;
      padding-top: 28px;
    }

    .sp-who-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .sp-who-card {
      padding-right: 0;
    }

    .sp-who-card + .sp-who-card {
      border-left: 0;
      border-top: 1px solid var(--border);
      padding-left: 0;
      padding-top: 24px;
    }
  }
</style>
