---
// Dedicated sign-in page: deep-link target, no-JS fallback for the modal, and
// where Better Auth's OAuth errors land (onAPIError.errorURL). Signed-in
// visitors get bounced to /account.
import Base from '../layouts/Base.astro';

if (Astro.locals.user) return Astro.redirect('/account');

// Friendly lines for the ?error= codes a visitor can actually cause.
const ERRORS = {
  account_not_linked:
    'that email already has an account through the other provider. sign in with the one you used first.',
  access_denied: 'sign-in was cancelled. no harm done.',
};
const errorCode = Astro.url.searchParams.get('error');
const errorLine = errorCode
  ? (Object.hasOwn(ERRORS, errorCode) && ERRORS[errorCode]) ||
    'sign-in failed. try again, or try the other provider.'
  : null;
---

<Base
  title="Sign in · canivibecodeit"
  description="Save apps to your stack and keep your digest settings. That's the whole account."
  noindex
>
  <main class="wrap signin-wrap">
    <div class="signin-card">
      <h1>Sign in</h1>
      {errorLine && <p class="signin-error">{errorLine}</p>}
      <p class="signup-sub">save apps to your stack, keep your digest settings. that's the whole account.</p>
      <div class="signup-buttons">
        <button class="oauth-btn" data-oauth="google">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z" fill="#4285F4"/><path d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z" fill="#34A853"/><path d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33z" fill="#FBBC05"/><path d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z" fill="#EA4335"/></svg>
          continue with Google
        </button>
        <button class="oauth-btn" data-oauth="github">
          <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" fill="currentColor"/></svg>
          continue with GitHub
        </button>
      </div>
      <label class="signup-digest">
        <input type="checkbox" id="signup-newsletter-page" />
        <span>also send me the weekly digest: verdicts that changed, plus case studies, tips and recommended skills for getting better at vibe coding. unsubscribe in one click.</span>
      </label>
      <p class="signup-fine">no passwords. we store your email and your stack, nothing else. signing in means you're OK with the <a href="/terms">terms</a> · <a href="/privacy">privacy</a></p>
      <noscript>
        <p class="signup-fine">sign-in needs JavaScript for the OAuth redirect. enable it for this site and reload.</p>
      </noscript>
    </div>
  </main>
</Base>

<style>
  .signin-wrap {
    display: flex;
    justify-content: center;
    padding-top: 64px;
    padding-bottom: 96px;
    min-height: 60vh;
  }
  .signin-card {
    width: min(440px, 100%);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 36px 36px 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .signin-card h1 {
    font-family: var(--font-display);
    font-size: 24px;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .signin-error {
    margin: 0;
    padding: 12px 14px;
    border: 1px solid color-mix(in srgb, #ff4444 30%, transparent);
    border-radius: 6px;
    color: #ff4444;
    font-size: 13px;
    line-height: 1.5;
  }
  @media (max-width: 480px) {
    .signin-card {
      padding: 24px 20px;
    }
  }
</style>
