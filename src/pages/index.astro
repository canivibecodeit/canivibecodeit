---
import Base from '../layouts/Base.astro';
import Ticker from '../components/Ticker.astro';
import AppRow from '../components/AppRow.astro';
import StatsStrip from '../components/StatsStrip.astro';
import Waitlist from '../components/Waitlist.astro';
import { allApps, topCategories } from '../lib/apps.js';
import { voteCounts } from '../lib/db.js';

const votes = await voteCounts();
const apps = allApps().sort(
  (a, b) =>
    votes(b.slug) - votes(a.slug) ||
    (b.pagePriority ?? 3) - (a.pagePriority ?? 3) ||
    a.name.localeCompare(b.name)
);
const cats = topCategories();

const title = 'Can I Vibecode It? — Which subscriptions are one prompt away from free';
const description =
  'The leaderboard of SaaS apps you can replace with one AI prompt. Honest verdicts, the exact prompt to run, and what you lose by leaving.';

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Can I Vibecode It?',
    url: 'https://canivibecodeit.com',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: 'https://canivibecodeit.com/?q={search_term_string}',
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'The Death List',
    itemListElement: apps.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.name,
      url: `https://canivibecodeit.com/${a.slug}`,
    })),
  },
];
---

<Base {title} {description} {jsonld}>
  <section class="hero">
    <h1>Can I vibecode <span class="blank">___</span>?</h1>
    <p class="sub">Some subscriptions are businesses. Some are just a prompt.</p>
    <div class="search-wrap">
      <div class="search">
        <span class="chevron">&gt;</span>
        <input
          type="search"
          id="search"
          placeholder="type an app — granola, linktree, figma…"
          autocomplete="off"
          aria-label="Search apps"
          role="combobox"
          aria-expanded="false"
          aria-controls="search-results"
        />
        <span class="cursor" aria-hidden="true"></span>
      </div>
      <div class="search-results" id="search-results" role="listbox"></div>
    </div>
    <p class="search-miss" id="no-results" role="status">
      <span class="badge kinda" style="font-size: 10px;">NOT LISTED YET</span>
      <a href="https://github.com/canivibecodeit/canivibecodeit/blob/main/CONTRIBUTING.md">submit it as a PR ↗</a>
      <span class="miss-note">verdicts are added daily · thousands more on the way</span>
    </p>
    <nav class="chips" id="chips" aria-label="Categories">
      <a class="chip active" href="/" data-cat="">⚡ all</a>
      {
        cats.map((c) => (
          <a class="chip" href={`/category/${c.slug}`} data-cat={c.slug}>
            {c.emoji} {c.label.toLowerCase()}
          </a>
        ))
      }
      <a class="chip" href="/categories">all categories →</a>
    </nav>
  </section>

  <Ticker />
  <StatsStrip />

  <main class="wrap" id="death-list">
    <div class="list-head">
      <h2>The Death List</h2>
      <span class="note">ranked by "I replaced this" votes</span>
    </div>
    <div class="verdict-filter" id="verdict-filter" role="group" aria-label="Filter by verdict">
      <span class="microlabel">verdict</span>
      <button class="vchip all active" data-verdict="">all</button>
      <button class="vchip yes" data-verdict="yes">YES</button>
      <button class="vchip kinda" data-verdict="kinda">KINDA</button>
      <button class="vchip no" data-verdict="no">NOT REALLY</button>
      <span class="note" id="filter-count"></span>
    </div>
    <div class="thead microlabel">
      <span class="c-app">app</span>
      <span class="c-cat">category</span>
      <span class="c-price">price</span>
      <span class="c-verdict">verdict</span>
      <span class="c-votes">replaced it</span>
      <span class="c-stack">my stack</span>
    </div>
    <div id="rows">
      {apps.map((app, i) => <AppRow {app} rank={i + 1} votes={votes(app.slug)} />)}
    </div>
  </main>

  <Waitlist />
</Base>
