---
import Base from '../layouts/Base.astro';
import Ticker from '../components/Ticker.astro';
import AppRow from '../components/AppRow.astro';
import VisitorGlobe from '../components/VisitorGlobe.astro';
import DigestCard from '../components/DigestCard.astro';
import { allApps, appsWithAlternativesPage, categoriesInUse } from '../lib/apps.js';
import { bgPotCents, liveBuilds, modelDemos, voteCounts } from '../lib/db.js';
import { buildGamesLive, buildsLive } from '../lib/flags.js';
import { usd } from '../lib/buildgames.js';
import { SHOWCASE_MODELS, modelSlug } from '../lib/models.js';

// The Build Games strip carries the LIVE pool number (0 hides the figure,
// the link still stands). Never let a DB hiccup take the homepage down.
let gamesPotCents = 0;
if (buildGamesLive()) {
  try {
    gamesPotCents = await bgPotCents();
  } catch {
    gamesPotCents = 0;
  }
}

// The model-showcase strip under the games strip: real counts, shown at
// every width. The first registry entry is the featured showcase.
const showcase = SHOWCASE_MODELS[0] ?? null;
let showcaseDemos = 0;
let showcaseBuilds = 0;
if (showcase && buildsLive()) {
  try {
    showcaseDemos = (await modelDemos(showcase.slug, ['live'])).length;
    showcaseBuilds = (await liveBuilds()).filter((b) => modelSlug(b.model_norm ?? b.model) === showcase.slug).length;
  } catch {
    /* the strip still renders without counts */
  }
}

const votes = await voteCounts();
const apps = allApps().sort(
  (a, b) =>
    votes(b.slug) - votes(a.slug) ||
    (b.pagePriority ?? 3) - (a.pagePriority ?? 3) ||
    a.name.localeCompare(b.name)
);
const ddCats = categoriesInUse().sort((a, b) => b.count - a.count);

// Strip under the hero: numbers computed from the same source as the
// /alternatives hub, so the claim can never drift from the pages.
const altApps = appsWithAlternativesPage();
const totalAlts = altApps.reduce((s, a) => s + a.alternatives.length, 0);

const title = 'Vibecode It? · what AI can rebuild, what survives';
const description = `The live scoreboard of what AI can and can't replace, and which moats actually hold. Honest verdicts on ${apps.length} apps, the exact prompt to run, free.`;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Vibecode It?',
    url: 'https://vibecodeit.com',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: 'https://vibecodeit.com/?q={search_term_string}',
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'The Death List',
    itemListElement: apps.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.name,
      url: `https://vibecodeit.com/${a.slug}`,
    })),
  },
];
---

<Base {title} {description} {jsonld}>
  <section class="hero">
    <h1><span class="struck">Can I</span> vibecode <span class="blank">it</span>?</h1>
    <p class="sub">
      {apps.length.toLocaleString('en-US')} apps. One question each: vibecode it
      today, or keep paying?
    </p>
    <div class="search-row">
      <div class="search-wrap">
        <div class="search">
          <span class="chevron">&gt;</span>
          {/* Placeholder stays short on purpose: mobile bumps this input to 16px
              (the iOS zoom guard), which clipped the old "(N on the list)" at
              390px and narrower, and would clip harder once the count goes four
              digits. The full count is in the line right above the box. */}
          <input
            type="search"
            id="search"
            placeholder={`type an app… (${apps.length.toLocaleString('en-US')})`}
            autocomplete="off"
            aria-label="Search apps"
            role="combobox"
            aria-expanded="false"
            aria-controls="search-results"
          />
          <span class="cursor" aria-hidden="true"></span>
        </div>
        <div class="search-results" id="search-results" role="listbox"></div>
      </div>
      <span class="cat-dd" id="cat-dd">
        <button type="button" class="cat-dd-btn" id="cat-dd-btn" aria-haspopup="listbox" aria-expanded="false" aria-controls="cat-dd-panel">
          <span id="cat-dd-label">⚡ all categories</span>
          <span class="dd-caret" aria-hidden="true">▾</span>
        </button>
        <div class="cat-dd-panel" id="cat-dd-panel" role="listbox" aria-label="Filter by category" hidden>
          <button type="button" class="cat-opt active" role="option" aria-selected="true" data-cat="" data-label="⚡ all categories">
            <span class="co-label">⚡ all categories</span>
            <span class="co-count">{apps.length}</span>
          </button>
          {
            ddCats.map((c) => (
              <button
                type="button"
                class="cat-opt"
                role="option"
                aria-selected="false"
                data-cat={c.slug}
                data-label={`${c.emoji} ${c.label.toLowerCase()}`}
              >
                <span class="co-label">{c.emoji} {c.label.toLowerCase()}</span>
                <span class="co-count">{c.count}</span>
              </button>
            ))
          }
          <div class="cat-dd-sep" aria-hidden="true"></div>
          <a class="cat-opt cat-link" href="/alternatives">
            <span class="co-label">🚪 escape hatches <span class="new-tag">NEW</span></span>
          </a>
          <a class="cat-opt cat-link" href="/moats">
            <span class="co-label">🏰 moats</span>
          </a>
          <a class="cat-opt cat-link" href="/categories">
            <span class="co-label">all categories →</span>
          </a>
        </div>
      </span>
    </div>
    <div class="search-miss" id="no-results" role="status">
      <span class="badge kinda" style="font-size: 10px;">NOT LISTED YET</span>
      <a href="/submit">submit it → the bot drafts the verdict</a>
      <span class="miss-note">verdicts are added daily · thousands more on the way</span>
    </div>
  </section>

  <Ticker />

  <div class="promo-strips">
    {
      buildGamesLive() ? (
        <a class="hatch-strip games-strip" href="/thebuildgames">
          <span class="hs-copy">
            the build games · a month-long vibecoding hackathon, free to enter
            {gamesPotCents > 0 ? ` · ${usd(gamesPotCents)} sponsorship pool` : ''}
          </span>
          <span class="hs-cta">enter the games →</span>
        </a>
      ) : buildsLive() ? (
        <a class="hatch-strip" href="/builds">
          <span class="hs-copy">
            new: builds · what people actually vibe coded, with the exact prompts that made it
          </span>
          <span class="hs-cta">see the builds →</span>
        </a>
      ) : (
        <a class="hatch-strip" href="/alternatives">
          <span class="hs-copy">
            every verdict now has an escape hatch: {totalAlts.toLocaleString('en-US')} free
            alternatives across {altApps.length} apps
          </span>
          <span class="hs-cta">browse them →</span>
        </a>
      )
    }
    {
      showcase && buildsLive() && (
        <a class="hatch-strip games-strip" href={`/built-with/${showcase.slug}`}>
          <span class="hs-copy">
            <span class="new-tag">NEW</span> built with {showcase.name} · {showcaseDemos}{' '}
            {showcaseDemos === 1 ? 'thing' : 'things'} people one-shotted on day one, hand-picked from X
            {showcaseBuilds > 0 ? ` · ${showcaseBuilds} ${showcaseBuilds === 1 ? 'build' : 'builds'}` : ''}
          </span>
          <span class="hs-cta">see the showcase →</span>
        </a>
      )
    }
  </div>

  <main class="wrap" id="death-list">
    <div class="list-head">
      <h2>The Death List</h2>
      <span class="note">ranked by "I replaced this" votes</span>
    </div>
    <div class="verdict-filter" id="verdict-filter" role="group" aria-label="Filter the list">
      <span class="microlabel">verdict</span>
      <button class="vchip all active" data-verdict="">all</button>
      <button class="vchip yes" data-verdict="yes">YES</button>
      <button class="vchip kinda" data-verdict="kinda">KINDA</button>
      <button class="vchip no" data-verdict="no">NOT REALLY</button>
      <span class="microlabel team-label">team of</span>
      <span class="team-stepper">
        <button type="button" class="team-step" data-step="-1" aria-label="Smaller team">−</button>
        <input
          type="number"
          id="team-size"
          class="team-size"
          value="1"
          min="1"
          max="999"
          step="1"
          inputmode="numeric"
          aria-label="Team size, recalculates per-seat prices"
        />
        <button type="button" class="team-step" data-step="1" aria-label="Bigger team">+</button>
      </span>
      <button class="vchip all" id="sort-toggle" data-sort="votes">sort: votes</button>
      <span class="note" id="filter-count"></span>
    </div>
    <div class="thead microlabel">
      <span class="c-app">app</span>
      <span class="c-cat">category</span>
      <span class="c-price">price</span>
      <span class="c-verdict">verdict</span>
      <span class="c-votes">replaced it</span>
      <span class="c-save"></span>
    </div>
    <div id="rows">
      {
        apps.map((app, i) => (
          <Fragment>
            <AppRow {app} rank={i + 1} votes={votes(app.slug)} />
            {i === 9 && <VisitorGlobe />}
          </Fragment>
        ))
      }
    </div>
    {/* The mobile path to /submit: the header drops the nav link below 980px,
        so the list itself carries it at the point of "it's not here". */}
    <p class="list-tail">missing an app? <a href="/submit">submit it →</a></p>
  </main>

  <DigestCard source="home" />
</Base>

<style>
  .promo-strips {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 18px 20px 8px;
  }

  .list-tail {
    margin: 0;
    padding: 20px 10px 4px;
    text-align: center;
    font-size: 12.5px;
    color: var(--muted);
  }
  .list-tail a {
    color: var(--primary);
  }
  .list-tail a:hover {
    text-decoration: underline;
  }

  /* Category dropdown beside the hero search. */
  .search-row {
    display: flex;
    align-items: stretch;
    gap: 10px;
    width: min(760px, 100%);
  }

  .search-row .search-wrap {
    flex: 1;
    min-width: 0;
    width: auto;
  }

  .search-row .cat-dd {
    flex-shrink: 0;
  }

  .search-row .cat-dd-btn {
    height: 100%;
    min-height: 54px;
    padding: 0 14px;
    font-size: 13px;
    border-radius: 8px;
    background: var(--surface);
  }

  .search-row .cat-dd-panel {
    right: 0;
    left: auto;
    min-width: 280px;
  }

  .cat-dd-sep {
    height: 1px;
    margin: 5px 6px;
    background: var(--border);
  }

  .cat-opt.cat-link {
    text-decoration: none;
    color: inherit;
  }

  .cat-opt.cat-link:hover {
    color: var(--primary);
  }

  .cat-dd {
    position: relative;
    display: inline-flex;
  }

  .cat-dd-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 6px 11px;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--card);
    color: var(--fg);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .cat-dd-btn:hover,
  .cat-dd-btn[aria-expanded='true'] {
    border-color: var(--muted);
  }

  .cat-dd-btn.filtering {
    border-color: var(--primary);
    color: var(--primary);
  }

  .dd-caret {
    font-size: 9px;
    color: var(--muted);
  }

  .cat-dd-panel {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 60;
    min-width: 264px;
    max-height: 340px;
    overflow-y: auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: var(--shadow);
    padding: 5px;
  }

  .cat-opt {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 7px 9px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    border-radius: 5px;
    text-align: left;
    transition: background-color 0.12s ease;
  }

  .cat-opt:hover {
    background: var(--bg);
  }

  .cat-opt.active {
    color: var(--primary);
    font-weight: 600;
  }

  .co-label {
    flex: 1;
    min-width: 0;
  }

  .co-count {
    color: var(--muted);
    font-size: 11px;
  }

  @media (max-width: 760px) {
    .search-row {
      flex-direction: column;
      width: min(640px, 100%);
    }

    .search-row .cat-dd-btn {
      width: 100%;
      min-height: 44px;
      justify-content: space-between;
    }

    .search-row .cat-dd-panel {
      left: 0;
      right: 0;
      min-width: 0;
      max-height: 300px;
    }
  }

  .team-label {
    margin-left: 6px;
  }

  /* The native number-input spinners don't match anything else on the page,
     so the stepper owns the border and ships its own −/+ buttons. */
  .team-stepper {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--border);
    border-radius: 5px;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .team-stepper:focus-within {
    border-color: var(--primary);
  }

  .team-step {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    width: 26px;
    padding: 6px 0;
    color: var(--muted);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .team-step:hover {
    color: var(--fg);
  }

  .team-step:active {
    transform: scale(0.9);
  }

  .team-size {
    font-family: var(--font-mono);
    font-size: 12px;
    width: 34px;
    padding: 6px 0;
    border: 0;
    border-left: 1px solid var(--border);
    border-right: 1px solid var(--border);
    background: transparent;
    color: var(--fg);
    text-align: center;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .team-size::-webkit-outer-spin-button,
  .team-size::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .team-size:focus {
    outline: none;
  }

  @media (max-width: 760px) {
    /* iOS zooms into any focused input with font-size below 16px */
    .team-size {
      font-size: 16px;
      width: 44px;
    }

    /* A finger needs more than 26px */
    .team-step {
      width: 34px;
    }
  }
</style>
