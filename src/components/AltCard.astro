---
/* One curated free/OSS alternative. compact = the verdict-page row;
   full = the dedicated-page card with platform icons, repo link and, when the
   entry carries a verified `facts` block, the fact rows. */
import { existsSync } from 'node:fs';
import { formatStars, formatMonth, formatLicense, productPageLink, SELF_HOST_LABELS, FACT_RUNS_LABELS } from '../lib/apps.js';

const { alt, compact = false, i = 0, appName = null } = Astro.props;

// Two-way mesh with the /alternative/<product> pages: when this product has
// one (it replaces 2+ apps), the full card links across to it.
const prod = compact ? null : productPageLink(alt.name, alt.url);

// Verified facts (skip what wasn't verified; null setupBlocker IS a finding:
// it means the install was verified clean). Short facts render as ledger rows;
// prose facts (the catch, a real setup blocker) render as left-bar callouts.
const f = alt.facts;
const setupClean = f ? f.setupBlocker == null : false;
const ledgerRows = f
  ? [
      ['license', formatLicense(f.license)],
      ['runs', FACT_RUNS_LABELS[f.runs]],
      ['install', f.install],
      ['engines', f.engines],
      ['data', f.dataFormat],
      ...(setupClean ? [['setup', '✓ installs clean', 'ok']] : []),
    ].filter(([, v]) => v != null)
  : [];
const proseRows = f
  ? [
      [appName ? `the catch vs ${appName}` : 'the catch vs paid', f.gapVsPaid, 'catch'],
      ...(setupClean ? [] : [['setup', f.setupBlocker, 'plain']]),
    ].filter(([, v]) => v != null)
  : [];

const host = (() => {
  try {
    return new URL(alt.url).hostname.replace(/^www\./, '');
  } catch {
    return null;
  }
})();
const iconFile = host ? `/icons/alt/${host}.png` : null;
const hasIcon = iconFile && existsSync(`public${iconFile}`);

// Deterministic tint for the letter tile when we don't have a favicon yet.
const TINTS = ['#A78BFA', '#7DD3FC', '#F87171', '#FBBF24', '#34D399', '#F472B6'];
const tint = TINTS[[...alt.name].reduce((s, c) => s + c.charCodeAt(0), 0) % TINTS.length];

const stars = formatStars(alt.stars);
const active = formatMonth(alt.lastCommit);

// Platform icons grouped the way the design shows them: desktop covers the
// three desktop OSes, mobile covers both stores.
const p = new Set(alt.platforms ?? []);
const groups = [
  { key: 'desktop', on: ['macos', 'windows', 'linux'].some((x) => p.has(x)) },
  { key: 'mobile', on: ['ios', 'android'].some((x) => p.has(x)) },
  { key: 'web', on: p.has('web') },
  { key: 'self-hosted', on: p.has('self-hosted') },
  { key: 'cli', on: p.has('cli') },
  { key: 'extension', on: p.has('browser-extension') },
].filter((g) => g.on);

// hosted=cloud, one-click=bolt, docker=box, ops=wrench — what "free" costs to run.
const SELF_HOST_ICONS = {
  hosted: 'M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z',
  'one-click': 'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
  docker: 'M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16zM3.3 7l8.7 5 8.7-5M12 22V12',
  ops: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z',
};
const selfHostLabel = SELF_HOST_LABELS[alt.selfHost];

const ICONS = {
  desktop: 'M2 5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5zm6 16h8m-4-4v4',
  mobile: 'M7 4a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V4zm3 14h4',
  web: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM2 12h20M12 2c2.5 2.7 4 6.3 4 10s-1.5 7.3-4 10c-2.5-2.7-4-6.3-4-10s1.5-7.3 4-10z',
  'self-hosted': 'M4 2h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm0 12h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2zm2-8h.01M6 18h.01',
  cli: 'M4 17l6-5-6-5m8 12h8',
  extension: 'M20.5 11H19V7a2 2 0 0 0-2-2h-4V3.5a2.5 2.5 0 0 0-5 0V5H4a2 2 0 0 0-2 2v3.8h1.5a2.7 2.7 0 0 1 0 5.4H2V20a2 2 0 0 0 2 2h3.8v-1.5a2.7 2.7 0 0 1 5.4 0V22H17a2 2 0 0 0 2-2v-4h1.5a2.5 2.5 0 0 0 0-5z',
};
---

{
  compact ? (
    <a class="alt-row" href={alt.url} target="_blank" rel="noopener" style={`--i: ${i}`}>
      {hasIcon ? (
        <img class="alt-tile" src={iconFile} alt="" width="30" height="30" loading="lazy" />
      ) : (
        <span class="alt-tile" style={`color: ${tint}`}>{alt.name[0].toUpperCase()}</span>
      )}
      <span class="alt-main">
        <span class="alt-name">{alt.name}</span>
        <span class="alt-desc">{alt.desc}</span>
      </span>
      <span class="alt-meta">
        {stars ? (
          <>
            <svg class="alt-star" width="13" height="13" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <b>{stars}</b>
            <i class="alt-dot" />
            <span>{active}</span>
          </>
        ) : (
          <b class="alt-zero">$0</b>
        )}
      </span>
      <span class:list={['alt-badge', alt.type === 'open-source' ? 'oss' : 'free']}>
        {alt.type === 'open-source' ? 'open source' : 'free'}
      </span>
      <span class="arrow">↗</span>
    </a>
  ) : (
    <div class="alt-card" style={`--i: ${i}`}>
      {hasIcon ? (
        <img class="alt-tile big" src={iconFile} alt="" width="38" height="38" loading="lazy" />
      ) : (
        <span class="alt-tile big" style={`color: ${tint}`}>{alt.name[0].toUpperCase()}</span>
      )}
      <div class="alt-body">
        <div class="alt-title">
          <a class="alt-name" href={alt.url} target="_blank" rel="noopener">{alt.name}</a>
          <span class:list={['alt-badge', alt.type === 'open-source' ? 'oss' : 'free']}>
            {alt.type === 'open-source' ? 'open source' : 'free'}
          </span>
          <span class="alt-platforms">
            {groups.map((g) => (
              <span class="alt-plat" title={g.key}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONS[g.key]} /></svg>
                {g.key}
              </span>
            ))}
            {selfHostLabel && (
              <span class:list={['alt-plat', 'selfhost', alt.selfHost]}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={SELF_HOST_ICONS[alt.selfHost]} /></svg>
                {selfHostLabel}
              </span>
            )}
          </span>
        </div>
        <p class="alt-desc">{alt.desc}</p>
        {(ledgerRows.length > 0 || proseRows.length > 0) && (
          <div class="alt-facts">
            {ledgerRows.length > 0 && (
              <div class="af-grid">
                {ledgerRows.map(([k, v, cls]) => (
                  <p class:list={['af-lrow', String(v).length > 42 ? 'long' : String(v).length > 24 && 'mid']}>
                    <span class="af-k">{k}</span>
                    <span class="af-leader" />
                    <span class:list={['af-v', cls]}>{v}</span>
                  </p>
                ))}
              </div>
            )}
            {proseRows.map(([k, v, cls]) => (
              <p class:list={['af-catch', cls === 'plain' && 'plain']}>
                <span class="af-ck">{k}</span>
                <span class="af-cv">{v}</span>
              </p>
            ))}
            <p class="af-verified">facts verified {f.checkedOn}</p>
          </div>
        )}
      </div>
      <div class="alt-side">
        {stars ? (
          <>
            <span class="alt-stars">
              <svg class="alt-star" width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <b>{stars}</b>
            </span>
            <span class="alt-active"><i class="alt-dot" />active {active}</span>
          </>
        ) : (
          <span class="alt-stars"><b class="alt-zero">$0 forever</b></span>
        )}
        <span class="alt-links">
          <a href={alt.url} target="_blank" rel="noopener">{host} ↗</a>
          {alt.repo && <a href={alt.repo} target="_blank" rel="noopener">repo ↗</a>}
          {prod && <a href={`/alternative/${prod.slug}`}>replaces {prod.count} apps →</a>}
        </span>
      </div>
    </div>
  )
}
