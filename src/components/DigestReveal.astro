---
const {
  source,
  head = 'prompt copied. verdicts flip when models improve.',
  sub = 'a new guide to technology every sunday. free, one-click out.',
} = Astro.props;
---

{/* Newsletter capture is disabled in the frontend-only deployment. */}
{false && <section class="digest-reveal" id="digest-reveal" hidden>
  <div class="dr-text">
    <p class="dr-head" data-dr-head>{head}</p>
    <p class="dr-sub">{sub}</p>
  </div>
  <form method="post" action="/api/waitlist" data-digest>
    <label class="hp" aria-hidden="true">
      Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
    <input type="hidden" name="source" value={source} />
    <input
      type="email"
      name="email"
      required
      placeholder="you@wherever.com"
      aria-label="Email address"
    />
    <button class="btn primary" type="submit">get sunday's</button>
    <button class="dr-close" type="button" data-digest-dismiss aria-label="dismiss">✕</button>
  </form>
  {/* signed-in state (CSS-gated on body[data-user]): the email is on file */}
  <div class="dr-oneclick">
    <button class="btn primary" type="button" data-digest-oneclick>add it to my email</button>
    <button class="dr-close" type="button" data-digest-dismiss aria-label="dismiss">✕</button>
  </div>
</section>}
