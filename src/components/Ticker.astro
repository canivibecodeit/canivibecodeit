---
import { allApps } from '../lib/apps.js';
import { mrrDestroyed } from '../lib/frontend-data.js';

const apps = allApps();
const total = mrrDestroyed(apps);
const chars = [...('$' + total.toLocaleString('en-US'))];
const tapeItems = apps
  .filter((a) => a.priceMonthly != null)
  .sort((a, b) => (b.pagePriority ?? 3) - (a.pagePriority ?? 3) || b.priceMonthly - a.priceMonthly)
  .map((a) => `${a.name.toUpperCase()} −$${a.priceMonthly}/mo`)
  .join(' · ');
const reel = [...Array(10).keys()];

/* The tape scrolls one full copy of itself per cycle, so a fixed duration means
   the speed depends on how many apps are on the list — every new verdict sped it
   up. Mono type gives a reliable px-per-character, so the duration is derived
   from the string's rendered width instead and the tape moves at ~60px/s
   whatever the list does. */
const tapeDur = Math.max(20, Math.round((tapeItems.length * 7.9 + 48) / 60));
---

<div class="ticker" id="ticker" data-total={total}>
  <div class="tape" aria-hidden="true" style={`--tape-dur: ${tapeDur}s`}>
    <span>{tapeItems} · </span>
    <span>{tapeItems} · </span>
  </div>
  <div class="main">
    <span class="label">SaaS bills <br />on the block</span>
    <span class="odometer" aria-label={`$${total.toLocaleString('en-US')} per month`}>
      {
        chars.map((ch) =>
          /\d/.test(ch) ? (
            <span class="digit" data-digit={ch}>
              <span class="reel" style={`transform: translateY(calc(${-ch} * clamp(36px, 5.6vw, 56px)))`}>
                {reel.map((n) => (
                  <span>{n}</span>
                ))}
              </span>
            </span>
          ) : (
            <span class="sym">{ch}</span>
          )
        )
      }
    </span>
    <span class="permo">/mo</span>
    <span class="mrr-info" tabindex="0" aria-label="How this number is calculated">
      ?
      <span class="mrr-tip" role="tooltip">
        <span class="tip-comment">// how this is calculated</span>
        <span>mrr = sum(app.price/mo</span>
        <span>&nbsp;&nbsp;for app of deathList)</span>
        <span class="tip-result">= {apps.filter((a) => a.priceMonthly != null).length} apps · ${total.toLocaleString('en-US')}/mo</span>
      </span>
    </span>
  </div>
</div>
