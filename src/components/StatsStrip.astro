---
import { siteStats } from '../lib/analytics.js';

const s = await siteStats();
const fmt = (n) => (n == null ? '—' : Number(n).toLocaleString('en-US'));
---

<aside class="stats-strip" id="stats-strip" aria-label="Live site analytics">
  <div class="inner">
    <span class="strip-head">
      <span class="microlabel">site analytics · public, because why not</span>
      <span class="strip-note">first-party numbers, refreshed every minute</span>
    </span>
    <div class="tiles">
      <div class="tile" title="Unique visitors with any activity in the last 5 minutes">
        <span class="t-label"><i class="dot"></i>online now</span>
        <span class="t-num" data-stat="online">{fmt(s?.online)}</span>
        <span class="t-def">active in the last 5 min</span>
      </div>
      <div class="tile" title="Page views since midnight UTC">
        <span class="t-label">views today</span>
        <span class="t-num" data-stat="viewsToday">{fmt(s?.viewsToday)}</span>
        <span class="t-def">since midnight UTC</span>
      </div>
      <div class="tile" title="Page views in the last 7 days">
        <span class="t-label">views · 7d</span>
        <span class="t-num" data-stat="views7d">{fmt(s?.views7d)}</span>
        <span class="t-def">page loads, last 7 days</span>
      </div>
      <div class="tile" title="Unique visitors in the last 7 days">
        <span class="t-label">visitors · 7d</span>
        <span class="t-num" data-stat="visitors7d">{fmt(s?.visitors7d)}</span>
        <span class="t-def">unique people, last 7 days</span>
      </div>
      <div class="tile" title="Prompt copy or open-in-agent clicks in the last 7 days">
        <span class="t-label">prompts copied · 7d</span>
        <span class="t-num" data-stat="copies7d">{fmt(s?.copies7d)}</span>
        <span class="t-def">copy + open-in-agent clicks</span>
      </div>
    </div>
  </div>
</aside>
