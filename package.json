{
  "name": "canivibecodeit",
  "version": "1.0.0",
  "description": "Can I Vibecode It? — find out which subscriptions are one prompt away from free.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev",
    "build": "node scripts/recent-verdicts.mjs && node scripts/generate-og.mjs && astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "og": "node scripts/generate-og.mjs",
    "validate": "node scripts/validate-apps.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "better-sqlite3": "$better-sqlite3"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.1.6",
    "better-auth": "1.6.26",
    "better-sqlite3": "^13.0.2",
    "pg": "^8.22.0",
    "satori": "^0.29.0",
    "sharp": "^0.35.3"
  }
}
