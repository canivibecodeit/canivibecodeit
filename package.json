{
  "name": "vibecodeit",
  "version": "1.0.0",
  "description": "Vibecode It? — find out which subscriptions are one prompt away from free.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev",
    "build": "node scripts/recent-verdicts.mjs && node scripts/generate-og.mjs && astro build",
    "preview": "astro preview",
    "start": "astro preview",
    "og": "node scripts/generate-og.mjs",
    "validate": "node scripts/validate-apps.mjs && node scripts/validate-builds.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.1.6",
    "satori": "^0.29.0",
    "sharp": "^0.35.3"
  }
}
