# Copy to .env and fill in. Nothing here is required to run the site locally.

# Where private runtime data (SQLite) lives. In production point this OUTSIDE
# the repo working tree so user data can never be committed.
DATA_DIR=data/private

# PostHog project API key (public client-side key). Leave empty to disable
# analytics entirely. Requires your reverse proxy to forward /ph/* to PostHog —
# see README.
POSTHOG_KEY=
POSTHOG_UI_HOST=https://eu.posthog.com

# Only needed by scripts in brand/ and scripts/weekly-digest.mjs — never at runtime.
OPENROUTER_API_KEY=sk-or-...

# Public analytics strip (reads stats back from PostHog). Personal API key
# with Query Read scope + the numeric project id. Leave empty to hide numbers.
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_KEY=

# Weekly digest sending (Resend). Unset = the signup endpoint stores emails
# locally and mirrors nothing.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Weekly digest script only (scripts/weekly-digest.mjs), never the running site.
# DATABASE_PUBLIC_URL: read-only reach into the production Postgres for vote counts.
# DIGEST_ALERT_EMAIL: where a failed or skipped run reports itself.
# DIGEST_TEST_EMAIL: where `--test` sends the rendered issue before a real broadcast.
DATABASE_PUBLIC_URL=
DIGEST_ALERT_EMAIL=you@example.com
DIGEST_TEST_EMAIL=you@example.com

# Sponsor slots. Unset STRIPE_SECRET_KEY = the board still renders, checkout 502s.
# STRIPE_WEBHOOK_SECRET: signing secret of the endpoint you registered for
# checkout.session.completed + checkout.session.expired.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Gate for the admin surfaces (/admin/sponsors, /admin/articles, ...) and the
# signed approve/reject links. Any long random
# string; generate one with `node -e "console.log(crypto.randomUUID())"`.
ADMIN_TOKEN=
# Optional: signs the emailed action links. Falls back to ADMIN_TOKEN when empty.
SPONSOR_SIGNING_SECRET=
# Optional: comma-separated sponsor slot ids to hold as "reserved" while a
# deal is mid-negotiation (e.g. L1,R2). No purchase row is created; a live
# paid sponsor always outranks the hold. Unset = no holds.
RESERVED_SLOTS=

# Absolute origin used to build Stripe return URLs. Behind a proxy the request
# origin is the internal listener, which Stripe would reject.
SITE_URL=http://127.0.0.1:8095

# Accounts (Better Auth): Google + GitHub OAuth only. Unset = the site renders
# fine, sign-in just fails. BETTER_AUTH_URL must be the exact public origin
# (http://localhost:8095 in dev); BETTER_AUTH_SECRET any long random string
# (openssl rand -hex 32). Use separate dev OAuth apps locally, never the
# production client ids.
BETTER_AUTH_URL=http://localhost:8095
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Security rollout ladders (set on Railway only, never locally; each one:
# unset = off/observe, "1" = enforce). See src/middleware.js and src/lib/csp.js.
# ORIGIN_VERIFY_SECRET=
# ORIGIN_VERIFY_ENFORCE=
# CSP_ENFORCE=

# Community builds (W06). BUILDS_LIVE unset = the whole vertical is dark.
# R2 media bucket for build screenshots: jurisdiction only when the bucket
# has one (EU buckets answer solely on their jurisdiction endpoint);
# public base is the bucket's custom domain, no trailing slash.
# BUILDS_LIVE=
# BUILDS_AI_REVIEW=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_JURISDICTION=
R2_PUBLIC_BASE=

# Build challenges. CHALLENGE_LIVE unset = the whole vertical is dark (page,
# APIs, badge, nav). Safe Browsing key unset = the submit/recheck gate is
# skipped with a log line — entries list unchecked. The date overrides exist
# for mirror testing; production dates live in src/lib/challenge.js.
# CHALLENGE_LIVE=
# GOOGLE_SAFEBROWSING_KEY=
# CHALLENGE_OPENS_AT=
# CHALLENGE_CLOSES_AT=
# The twist content is environment-ONLY: the repo is public, so twist text in
# source would leak to likely entrants days before kickoff. Set at the launch
# flip alongside CHALLENGE_LIVE; the page still holds it until the open time.
# CHALLENGE_TWIST=

# The Build Games. BUILDGAMES_LIVE unset = the surface is dark (page, terms,
# APIs 404). BIDDING_OPEN unset = the board renders but the submit endpoint
# 409s ("opens soon"). Floors/ceiling are cents and optional — the code
# defaults are $500 entry / $250 top-up / $15k per payment.
# BUILDGAMES_LIVE=
# BUILDGAMES_BIDDING_OPEN=
# BUILDGAMES_START_AT=
# BUILDGAMES_MIN_ENTRY_CENTS=
# BUILDGAMES_MIN_TOPUP_CENTS=
# BUILDGAMES_MAX_BID_CENTS=
# BUILDGAMES_FILL_SCALE_CENTS=
# Stripe webhook signing secret for the Build Games endpoint — a SEPARATE
# endpoint (and secret) from the sponsor-card webhook's STRIPE_WEBHOOK_SECRET.
# The recheck cron (scripts/buildgames-recheck.mjs) also needs
# GOOGLE_SAFEBROWSING_KEY (above) and the RESEND_/DIGEST_ vars for alerts.
# STRIPE_BUILDGAMES_WEBHOOK_SECRET=
# FRONTEND-ONLY DEPLOYMENT: These variables are not read by the active static site.
# They are retained only for restoring the code under src/backend-disabled/.
