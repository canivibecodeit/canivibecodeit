# Copy to .env and fill in. Nothing here is required to run the site locally.

# Where private runtime data (SQLite) lives. In production point this OUTSIDE
# the repo working tree so user data can never be committed.
DATA_DIR=data/private

# PostHog project API key (public client-side key). Leave empty to disable
# analytics entirely. Requires your reverse proxy to forward /ph/* to PostHog —
# see README.
POSTHOG_KEY=
POSTHOG_UI_HOST=https://eu.posthog.com

# Only needed by scripts in brand/ and scripts/weekly-digest.mjs — never at runtime.
OPENROUTER_API_KEY=sk-or-...

# Public analytics strip (reads stats back from PostHog). Personal API key
# with Query Read scope + the numeric project id. Leave empty to hide numbers.
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_KEY=

# Weekly digest sending (Resend). Unset = the signup endpoint stores emails
# locally and mirrors nothing.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Weekly digest script only (scripts/weekly-digest.mjs), never the running site.
# DATABASE_PUBLIC_URL: read-only reach into the production Postgres for vote counts.
# DIGEST_ALERT_EMAIL: where a failed or skipped run reports itself.
# DIGEST_TEST_EMAIL: where `--test` sends the rendered issue before a real broadcast.
DATABASE_PUBLIC_URL=
DIGEST_ALERT_EMAIL=you@example.com
DIGEST_TEST_EMAIL=you@example.com

# Sponsor slots. Unset STRIPE_SECRET_KEY = the board still renders, checkout 502s.
# STRIPE_WEBHOOK_SECRET: signing secret of the endpoint you registered for
# checkout.session.completed + checkout.session.expired.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Gate for /admin/sponsors and the signed approve/reject links. Any long random
# string; generate one with `node -e "console.log(crypto.randomUUID())"`.
ADMIN_TOKEN=
# Optional: signs the emailed action links. Falls back to ADMIN_TOKEN when empty.
SPONSOR_SIGNING_SECRET=

# Absolute origin used to build Stripe return URLs. Behind a proxy the request
# origin is the internal listener, which Stripe would reject.
SITE_URL=http://127.0.0.1:8095

# Accounts (Better Auth): Google + GitHub OAuth only. Unset = the site renders
# fine, sign-in just fails. BETTER_AUTH_URL must be the exact public origin
# (http://localhost:8095 in dev); BETTER_AUTH_SECRET any long random string
# (openssl rand -hex 32). Use separate dev OAuth apps locally, never the
# production client ids.
BETTER_AUTH_URL=http://localhost:8095
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Security rollout ladders (set on Railway only, never locally; each one:
# unset = off/observe, "1" = enforce). See src/middleware.js and src/lib/csp.js.
# ORIGIN_VERIFY_SECRET=
# ORIGIN_VERIFY_ENFORCE=
# CSP_ENFORCE=
